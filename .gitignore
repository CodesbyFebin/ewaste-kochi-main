node_modules/
dist/
.astro/
.vercel
.DS_Store

# Local tool state (not project source, not shared config)
.claude/
.kilocode/

# Reference/downloaded material that is not part of the actual site source.
# Excluded deliberately, not accidentally - see reports/phase-2k-git-safety-fresh-staging-report.md.
# - SWARM/: debris from an unverified, never-tested "Business OS" pitch (buggy code,
#   pasted into a chat session by a different tool); explicitly out of scope per this
#   project's rules, and not something to preserve in this repo's history.
# - ewastekochi-v3-chatbot.zip: contains a mass pSEO pillar-page generator (10
#   template-swapped city/service pages + a script to make more) - the exact
#   doorway-page pattern this project has repeatedly rejected.
# - ewastekochi-amp.html: contains unverified claims ("most trusted," "Government
#   authorized" stated as fact) that don't meet this project's anti-fabrication rules.
# - Homepage Hero image.png: the source file for a hero graphic already reviewed and
#   rejected for the same reason (fabricated rating, named client logos).
# - GSC export zips: one-time data inputs already fully extracted into data/*.json;
#   the useful content is in version control via those files, not the raw zips.
SWARM/
ewastekochi-v3-chatbot.zip
ewastekochi-amp.html
Homepage Hero image.png
ewastekochi.com-*.zip

# BLOG SCALE SAFETY GATE (2026-07-14) - see reports/blog-scale-safety-gate-report.md.
# .content-quarantine/blog-drafts/ holds 555 unreviewed/generated blog posts
# pulled out of src/pages/blog/ so Astro can't build them; kept as an internal
# editorial backlog, tracked in git so the drafts aren't lost.
# .content-quarantine/images-blog-generated/ holds 600 programmatically
# generated images (19MB) that were never wired into any page and sat in an
# unservable location (project-root images/, not public/) - not tracked, not
# needed until a future pass moves+wires them correctly.
.content-quarantine/images-blog-generated/

# Local development state
.zcode/
tmp/
debug-*.js
*.backup.ts

# Local backup snapshots
EWaste-Kochi-Astro-Safe-Deep*


# ==============================================================================
# Environment files & secrets (CRITICAL — never commit)
# ==============================================================================
# Any file matching these patterns is assumed to contain API keys, tokens,
# database URLs, or other material that would compromise the site if leaked.
# Add ONLY .env.example / .env.template (documentation of required keys) to
# version control, never the file with real values.
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
secrets/


# ==============================================================================
# Python tooling — added for scripts/generate-pillar-page.py (2026-07-28)
# ==============================================================================
# The pillar-page generator is Python 3.8+ with an optional PyYAML dep.
# Anyone contributing to scripts/*.py will produce these artifacts locally;
# none of them belong in the repo.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.python-version
# Virtualenvs — the generator works without one, but if a contributor sets
# up a project-local venv to install PyYAML, keep it out of tracking.
.venv/
venv/
env/
ENV/


# ==============================================================================
# Editor / IDE state (extending existing .claude/, .kilocode/, .zcode/ rule)
# ==============================================================================
# Consistent with the project's existing treatment of local tool state:
# every editor's per-user config stays local to that user's checkout.
# If a specific editor config (e.g. .vscode/settings.json for a shared
# formatter rule) becomes team-wide, add an explicit `!` unignore for it.
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/


# ==============================================================================
# Astro / build cache extensions
# ==============================================================================
# .astro/ (build cache) is already ignored above. These additions cover other
# caches the Astro toolchain and its plugins may create.
.turbo/
.parcel-cache/
.next/
.output/
.svelte-kit/


# ==============================================================================
# Standard Node / npm / log noise
# ==============================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npm/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
package-lock.json.bak


# ==============================================================================
# OS-generated junk (extending existing .DS_Store rule)
# ==============================================================================
Thumbs.db
Icon
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
desktop.ini


# ==============================================================================
# Scratch / temp / editing artifacts
# ==============================================================================
# `sed -i.bak` leaves .bak files; some editors write .orig on merge conflicts;
# .rej files come from failed patch applies. None belong in the repo.
*.bak
*.orig
*.rej
*.tmp
*.temp

# Astro underscore-prefix scratch pages — Astro's own convention for private
# files that shouldn't become routes. Also useful for one-off compile tests
# of generated files (as we did during scripts/generate-pillar-page.py
# development).
src/pages/_*/

# Debug/scratch scripts across all languages (extends existing debug-*.js).
debug-*.py
debug-*.mjs
debug-*.ts
scratch-*.js
scratch-*.py
scratch-*.mjs


# ==============================================================================
# Testing / coverage (future-proofing)
# ==============================================================================
coverage/
*.lcov
.nyc_output/
htmlcov/


# ==============================================================================
# Notes on `.content-quarantine/generated/`
# ==============================================================================
# scripts/generate-pillar-page.py writes to .content-quarantine/generated/
# by default (safe, human-review-before-promotion). That directory is
# INTENTIONALLY NOT ignored — following the precedent of
# .content-quarantine/blog-drafts/ (also tracked, so drafts aren't lost to a
# stash-drop or accidental branch switch). If a specific draft becomes
# stale/rejected, delete it explicitly rather than silently ignoring the
# whole folder.


# ==============================================================================
# Session-scoped local audit outputs
# ==============================================================================
# The god-level-100-launch-master-prompt convention writes audit artifacts to
# .audit/. If those get produced locally, they're per-run and shouldn't
# pollute the repo. Reports that should be preserved live under reports/.
.audit/
audit-*.tmp/
