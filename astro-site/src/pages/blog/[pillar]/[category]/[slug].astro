---
import { getBlogBySlug, getRelatedBlogs } from "../../../../lib/data";
import ChatBot from "../../../../components/ChatBot.astro";

// SSR on demand — do NOT prerender 11k pages at build time
export const prerender = false;

// Force Node.js runtime (required for better-sqlite3 native bindings)
export const runtime = 'node';

// CDN: cache for 1 year, background revalidate daily
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=31536000, stale-while-revalidate=86400"
);

const { pillar, category, slug } = Astro.params;
// If any param is missing, return 404 (should not happen for valid routes)
if (!pillar || !category || !slug) {
  return new Response(null, { status: 404 });
}
const blog = getBlogBySlug(slug);

if (!blog) {
  return new Response(null, { status: 404 });
}

// Canonical redirect if URL params don't match DB values
if (blog.pillar !== pillar || blog.category !== category) {
  return Astro.redirect(`/blog/${blog.pillar}/${blog.category}/${blog.slug}/`, 301);
}

const relatedBlogs = getRelatedBlogs(category, slug, 8);