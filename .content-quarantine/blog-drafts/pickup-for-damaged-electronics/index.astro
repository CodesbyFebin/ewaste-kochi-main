---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Pickup for Damaged Electronics in Kochi | What to Know First";
const description =
  "How to arrange pickup for damaged electronics in Kochi — cracked screens, water damage, physically broken devices, and what to flag in advance for safe collection.";
const datePublished = "2026-07-08";
const dateModified = "2026-07-08";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Pickup for Damaged Electronics", path: "/blog/pickup-for-damaged-electronics/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/pickup-for-damaged-electronics/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/pickup-for-damaged-electronics/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  {
    q: "Is a cracked phone still worth selling?",
    a: "Yes — cracked-screen phones have component and scrap value, assessed at a reduced rate based on the damage. Send photos for a preliminary assessment.",
  },
  {
    q: "Can water-damaged devices be collected?",
    a: "Yes — water-damaged devices are accepted for recycling. Describe the extent of damage and confirm any batteries are not leaking.",
  },
  {
    q: "What if a device is physically broken into parts?",
    a: "Collect all the parts together if possible. A broken device still has material value.",
  },
];
---

<Layout title={title} description={description} path="/blog/pickup-for-damaged-electronics/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Pickup for Damaged Electronics</h1>
  <p class="lede">
    Damaged electronics — broken screens, water damage, devices that
    won't turn on — are all collectible. They still have scrap or
    component value, and responsible handling is even more important
    when items are damaged.
  </p>

  <CtaBar whatsappMessage="Hi, I have some damaged electronics I'd like to recycle." />

  <div class="quick-answer">
    <p class="quick-answer-label">Quick answer</p>
    <p>
      Yes — cracked screens, water damage, and physically broken
      devices are all accepted for collection. Value is lower than a
      working equivalent, but damaged items still have material and
      component recovery value. Flag swollen batteries and sharp edges
      before pickup.
    </p>
  </div>

  <ul class="key-takeaways">
    <li>Damaged devices should never go in general waste — they still have recovery value.</li>
    <li>Swollen or leaking batteries need immediate isolation, separate from ordinary damage.</li>
    <li>Photos of the damage help confirm feasibility and avoid pickup-day surprises.</li>
  </ul>

  <section>
    <h2>All damaged electronics are accepted</h2>
    <p>
      A phone with a cracked screen, a laptop that got water damaged,
      an old TV with a broken panel — all of these are accepted for
      collection. The value will be lower than a working equivalent,
      but damaged items still have material and component recovery value
      and should not go in general waste.
    </p>
  </section>

  <section>
    <h2>What to flag before pickup</h2>
    <ul class="check-list">
      <li>Swollen or leaking batteries — keep isolated, flag immediately</li>
      <li>Broken glass or sharp edges — a piece of cardboard over a cracked screen is enough</li>
      <li>Devices with corrosion or chemical leakage</li>
      <li>Items that are only partially intact — describe what remains</li>
    </ul>
  </section>

  <section>
    <h2>Damaged batteries — different rules</h2>
    <p>
      A swollen, leaking, or damaged battery is not just a damaged
      electronic — it's a safety concern that needs immediate attention.
      Keep it isolated, ventilated, and away from flammable materials.
      Contact us with a photo before booking pickup. See
      <a href="/battery-recycling/">battery recycling</a>.
    </p>
  </section>

  <section>
    <h2>Send photos for accurate assessment</h2>
    <p>
      Photos of damaged items help us confirm whether they're accepted
      as-is, whether special handling is needed, and what the preliminary
      scrap or component value might be. A clear photo of the damage
      avoids surprises on pickup day.
    </p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/battery-recycling/">Battery Recycling</a>
      <a href="/pickup/">Book Pickup</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />
  <section class="final-cta">
    <h2>Have Damaged Electronics to Recycle?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have some damaged electronics I'd like to recycle." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .check-list { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1.25rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .quick-answer { padding: 1.1rem 1.25rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-surface); margin: 1.5rem 0; }
  .quick-answer-label { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary); }
  .quick-answer p:last-child { margin: 0; color: var(--color-text); }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
