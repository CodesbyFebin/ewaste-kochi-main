---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "What Makes an Electronic Item Sellable?";
const description = "What Makes an Electronic Item Sellable? — practical guidance for Kochi households and businesses, covering sell old electronics Kochi, sell old laptop Kochi, scra...";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "What Makes an Electronic Item Sellable?", path: "/blog/what-makes-an-electronic-item-sellable/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/what-makes-an-electronic-item-sellable/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/what-makes-an-electronic-item-sellable/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "What happens if the item has no value?", a: "It can still be recycled responsibly at no cost to you — there's no obligation to sell just because you sent details." },
  { q: "What photos should I send?", a: "Front and back of the device, the screen if applicable, and any visible damage." },
  { q: "Can I sell old laptops?", a: "Yes, working and non-working laptops are both accepted for a condition-based quote." },
  { q: "Can I sell old electronics in Kochi?", a: "Yes. Message the device type, condition and photos on WhatsApp for a preliminary quote, then arrange doorstep pickup and payment if you accept it." },
];
---

<Layout title={title} description={description} path="/blog/what-makes-an-electronic-item-sellable/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>What Makes an Electronic Item Sellable?</h1>
  <p class="lede">Here's what you need to know, in plain terms. Before selling any device with storage, back up what you want to keep and either wipe it yourself or ask about data destruction support.</p>

  <CtaBar whatsappMessage="Hi, I have a question about what makes an electronic item sellable." />

  <ul class="key-takeaways">
    <li>You can always choose recycling instead if the quote doesn't work for you.</li>
    <li>Wipe your data before handover, or ask about data destruction support.</li>
    <li>Quotes are condition-based, confirmed after inspection, not fixed in advance.</li>
  </ul>

  <section>
    <h2>Data comes first</h2>
    <p>Before selling any device with storage, back up what you want to keep and either wipe it yourself or ask about data destruction support. This applies to laptops, phones and tablets alike, working or not.</p>
  </section>

  <section>
    <h2>What actually drives value</h2>
    <p>Working condition, age, specifications, physical condition and current market demand all factor into a quote. Brand and model matter less on their own than whether the device actually powers on and functions normally.</p>
  </section>

  <section>
    <h2>Getting an accurate quote</h2>
    <p>Clear photos and an honest condition description — front, back, any damage — lead to a more reliable preliminary estimate. The confirmed number is always set at inspection, since condition can look different once the item is actually seen.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/sell-electronics/">Sell Electronics</a>
      <a href="/e-waste-scrap-prices-kochi/">Scrap Price Guide</a>
      <a href="/marketplace/">Marketplace</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/what-makes-an-electronic-item-sellable/" />

  <section class="final-cta">
    <h2>Have Questions About What Makes an Electronic Item Sellable?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about what makes an electronic item sellable." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
