---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "What to Expect During an E-Waste Pickup in Kochi | Full Guide";
const description =
  "What actually happens on e-waste pickup day in Kochi — from the team arriving to item checks, battery handling, documentation, and how long a typical pickup takes.";
const datePublished = "2026-07-08";
const dateModified = "2026-07-08";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "What to Expect During an E-Waste Pickup", path: "/blog/what-to-expect-during-ewaste-pickup/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/what-to-expect-during-ewaste-pickup/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/what-to-expect-during-ewaste-pickup/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  {
    q: "How long does a typical household pickup take?",
    a: "A standard household pickup usually takes 20–40 minutes depending on quantity and how items are prepared. Large office pickups take longer.",
  },
  {
    q: "Do I need to be present during pickup?",
    a: "Yes — someone should be available to hand over items and confirm what's included. For office pickups, an IT team representative who knows the asset list is helpful.",
  },
  {
    q: "What happens if the team can't take an item on the day?",
    a: "The team will explain why and, where possible, suggest an alternative arrangement for that item.",
  },
];
---

<Layout title={title} description={description} path="/blog/what-to-expect-during-ewaste-pickup/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>What to Expect During an E-Waste Pickup</h1>
  <p class="lede">
    Knowing what happens on pickup day removes uncertainty and makes the
    process smoother. Here's what a typical doorstep collection looks like
    from start to finish.
  </p>

  <CtaBar whatsappMessage="Hi, I'd like to book an e-waste pickup and understand what to expect." />

  <div class="quick-answer">
    <p class="quick-answer-label">Quick answer</p>
    <p>
      A standard household pickup takes about 20-40 minutes: the team
      arrives at the agreed slot, checks items against your list,
      collects batteries and data-bearing devices separately, and
      confirms anything with an agreed quote. Someone should be present
      to hand items over.
    </p>
  </div>

  <ul class="key-takeaways">
    <li>Most items don't need boxing — just gather everything in one accessible spot.</li>
    <li>Batteries are kept physically separate from the moment of collection.</li>
    <li>Documentation isn't mandatory for household pickups — ask if you'd like a record.</li>
  </ul>

  <section>
    <h2>Before the team arrives</h2>
    <p>
      Have items gathered in one accessible place — no need to box most
      things. Batteries should already be in a separate bag. Data should
      be backed up and devices wiped if you've done that yourself. Have
      your item list to hand if it's a large job.
    </p>
  </section>

  <section>
    <h2>At the door</h2>
    <p>
      The team arrives at the agreed slot. They'll confirm what's being
      collected, check items against your list, and note anything that
      needs special handling — damaged screens, flagged batteries,
      data-bearing devices requiring destruction.
    </p>
  </section>

  <section>
    <h2>Item handling</h2>
    <p>
      Batteries are kept physically separate from other electronics from
      the moment of collection. Data-bearing devices are flagged for
      destruction. Anything with a quote agreed upfront will be confirmed
      against the actual condition.
    </p>
  </section>

  <section>
    <h2>Documentation</h2>
    <p>
      For business pickups with data destruction or ITAD requirements,
      documentation is prepared at or after collection as agreed. For
      standard household pickups, there's no mandatory paperwork — ask
      if you'd like a record.
    </p>
  </section>

  <section>
    <h2>After pickup</h2>
    <p>
      Items are sorted, assessed, and routed — working devices to reuse
      or resale evaluation, everything else to compliant recycling.
      Data destruction happens before any onward handling of storage
      devices. See <a href="/blog/what-happens-after-ewaste-collection/">
      what happens after collection</a> for the full chain.
    </p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/pickup/">Book Pickup</a>
      <a href="/blog/what-happens-after-ewaste-collection/">After Collection</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />
  <section class="final-cta">
    <h2>Ready to Book Your Pickup?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I'd like to book an e-waste pickup and understand what to expect." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .quick-answer { padding: 1.1rem 1.25rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-surface); margin: 1.5rem 0; }
  .quick-answer-label { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary); }
  .quick-answer p:last-child { margin: 0; color: var(--color-text); }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
