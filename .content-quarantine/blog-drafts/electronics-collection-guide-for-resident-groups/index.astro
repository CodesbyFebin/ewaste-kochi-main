---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Electronics Collection Guide for Resident Groups";
const description = "Electronics Collection Guide for Resident Groups — practical guidance for Kochi households and businesses, covering housing society e-waste pickup, apartment e-wa...";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Electronics Collection Guide for Resident Groups", path: "/blog/electronics-collection-guide-for-resident-groups/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/electronics-collection-guide-for-resident-groups/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/electronics-collection-guide-for-resident-groups/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "How should collection be announced?", a: "Set a date and common area, and share a rough list of accepted items with residents in advance." },
  { q: "Can housing societies request collection?", a: "Yes, contact us with an estimated item count and the building address to discuss scheduling." },
  { q: "Are batteries accepted?", a: "Yes, but they need separate, ventilated storage at the collection point — never left in an enclosed space in bulk." },
  { q: "Should data-bearing devices be separated?", a: "Yes, residents should back up and wipe devices with storage before bringing them to a collection point." },
];
---

<Layout title={title} description={description} path="/blog/electronics-collection-guide-for-resident-groups/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Electronics Collection Guide for Resident Groups</h1>
  <p class="lede">Here's what you need to know, in plain terms. Don't store large quantities of batteries in an enclosed common area without ventilation.</p>

  <CtaBar whatsappMessage="Hi, I have a question about electronics collection guide for resident groups." />

  <ul class="key-takeaways">
    <li>Community and school drives are handled case-by-case — contact us to plan one.</li>
    <li>Batteries need separate, well-ventilated storage at a community collection point.</li>
    <li>Individual flats can still book their own pickup — a drive isn't mandatory.</li>
  </ul>

  <section>
    <h2>Battery safety at a community collection point</h2>
    <p>Don't store large quantities of batteries in an enclosed common area without ventilation. Flag any damaged batteries in advance and keep them isolated from other collected items.</p>
  </section>

  <section>
    <h2>Organizing a building-wide collection</h2>
    <p>A resident or the apartment association contacts us with an estimated item count and address. Residents bring items to a common area at an agreed time, and the team collects from that single point.</p>
  </section>

  <section>
    <h2>School and community awareness drives</h2>
    <p>Schools and community groups interested in an e-waste awareness or collection day should contact us directly to discuss scope and feasibility — this is handled case-by-case rather than as a standard advertised service.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/pickup/">Book Pickup</a>
      <a href="/locations/">Locations</a>
      <a href="/recycling/">Recycling</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/electronics-collection-guide-for-resident-groups/" />

  <section class="final-cta">
    <h2>Have Questions About Electronics Collection Guide for Resident Groups?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about electronics collection guide for resident groups." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
