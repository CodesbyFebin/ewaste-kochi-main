---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Small Gadget Recycling";
const description = "Small Gadget Recycling — practical guidance for Kochi households and businesses, covering mobile recycling, tablet recycling, charger disposal.";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Small Gadget Recycling", path: "/blog/small-gadget-recycling/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/small-gadget-recycling/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/small-gadget-recycling/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "Is resale better than recycling?", a: "For a working phone, resale is usually worth checking first — non-working devices are typically better suited to recycling." },
  { q: "Can small items be included with other e-waste?", a: "Yes, phones, chargers and other small devices can be included in a general household or office pickup." },
  { q: "How do I book mobile recycling?", a: "Message the device type, condition and location on WhatsApp." },
  { q: "Can phones be sold?", a: "Yes, working phones may have resale value depending on brand, model and condition." },
];
---

<Layout title={title} description={description} path="/blog/small-gadget-recycling/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Small Gadget Recycling</h1>
  <p class="lede">Here's what you need to know, in plain terms. Phone, tablet and power bank batteries are lithium-ion and can swell or become hazardous if damaged.</p>

  <CtaBar whatsappMessage="Hi, I have a question about small gadget recycling." />

  <ul class="key-takeaways">
    <li>Factory reset and sign out of accounts before handing over any phone.</li>
    <li>Small items like chargers and earbuds are e-waste too — include them.</li>
    <li>Working phones may have resale value — check before recycling.</li>
  </ul>

  <section>
    <h2>Battery safety in small devices</h2>
    <p>Phone, tablet and power bank batteries are lithium-ion and can swell or become hazardous if damaged. Never attempt to remove a swollen battery yourself — flag it with a photo instead.</p>
  </section>

  <section>
    <h2>Resale for phones and tablets</h2>
    <p>A working phone, even a few years old, may still have resale value — brand, model, condition and battery health all factor in. Non-working devices can still have component value.</p>
  </section>

  <section>
    <h2>Data on small devices</h2>
    <p>Phones and tablets store photos, messages, accounts and saved passwords. A factory reset and signing out of accounts (Google, Apple ID, social media) is the essential step before any device changes hands.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/sell-electronics/">Sell Electronics</a>
      <a href="/recycling/">E-Waste Recycling</a>
      <a href="/marketplace/">Marketplace</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/small-gadget-recycling/" />

  <section class="final-cta">
    <h2>Have Questions About Small Gadget Recycling?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about small gadget recycling." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
