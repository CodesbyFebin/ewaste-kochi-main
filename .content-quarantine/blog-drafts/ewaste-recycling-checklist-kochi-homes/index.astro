---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "E-Waste Recycling Checklist for Kochi Homes | What to Prepare";
const description =
  "A practical e-waste recycling checklist for Kochi households — what to gather, what to wipe, what to flag for batteries, and how to book pickup easily.";
const datePublished = "2026-07-08";
const dateModified = "2026-07-08";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "E-Waste Recycling Checklist for Kochi Homes", path: "/blog/ewaste-recycling-checklist-kochi-homes/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/ewaste-recycling-checklist-kochi-homes/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/ewaste-recycling-checklist-kochi-homes/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  {
    q: "How often should a household do an e-waste cleanout?",
    a: "There's no fixed rule — once a year works well for most households, or whenever you notice a pile of unused electronics accumulating.",
  },
  {
    q: "Can I hand over items from multiple rooms in one pickup?",
    a: "Yes. Gather everything into one accessible location before the team arrives to keep the pickup fast and organised.",
  },
  {
    q: "What if I'm unsure whether something counts as e-waste?",
    a: "Send a photo on WhatsApp and we'll confirm. When in doubt, keep it aside — it's always better to ask than to put electronics in general waste.",
  },
];
---

<Layout title={title} description={description} path="/blog/ewaste-recycling-checklist-kochi-homes/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>E-Waste Recycling Checklist for Kochi Homes</h1>
  <p class="lede">
    Before your next pickup, run through this checklist. It covers
    everything from finding items around the house to making sure your
    data and batteries are handled safely.
  </p>

  <CtaBar whatsappMessage="Hi, I'd like to book a household e-waste pickup." />

  <div class="quick-answer">
    <p class="quick-answer-label">Quick answer</p>
    <p>
      Before your next pickup in Kochi: walk through every room to find
      old electronics, sort devices with storage separately for data
      wiping, keep batteries in their own bag, flag any damaged items,
      then gather everything in one place and message us your list.
    </p>
  </div>

  <ul class="key-takeaways">
    <li>Electronics hide in every room — check drawers, cupboards and storage areas, not just the study.</li>
    <li>Data wiping applies to anything with storage, not just phones and laptops.</li>
    <li>Swollen or leaking batteries should be flagged before the team arrives, not during pickup.</li>
  </ul>

  <section>
    <h2>Step 1: Walk through each room</h2>
    <p>
      Check every room for items you no longer use: old phones in drawers,
      broken chargers, an old laptop in a cupboard, a TV that hasn't been
      switched on in years, cables you'll never need again, a defunct
      printer. Electronics hide in every corner of a home.
    </p>
  </section>

  <section>
    <h2>Step 2: Sort as you go</h2>
    <ul class="check-list">
      <li><strong>Devices with storage</strong> (phones, laptops, tablets, hard drives) — need data backup and wipe</li>
      <li><strong>Batteries</strong> (UPS, inverter, laptop battery packs, power banks) — keep separate from other items</li>
      <li><strong>General electronics</strong> (TVs, monitors, printers, routers, cables) — can be grouped together</li>
      <li><strong>Damaged items</strong> (cracked screens, swollen batteries) — flag separately and mention at booking</li>
    </ul>
  </section>

  <section>
    <h2>Step 3: Handle data</h2>
    <p>
      Back up anything you want to keep from phones and computers. Then
      factory reset or wipe devices, or ask about
      <a href="/data-destruction/">certified data destruction</a> if you
      can't do it yourself. Remove SIM cards and memory cards.
    </p>
  </section>

  <section>
    <h2>Step 4: Check batteries for damage</h2>
    <p>
      Look for any battery that's swollen (bulging casing), leaking, or
      unusually warm. These need to be flagged before pickup — keep them
      in a cool, dry spot away from other items. See
      <a href="/battery-recycling/">battery recycling</a> for guidance.
    </p>
  </section>

  <section>
    <h2>Step 5: Gather and contact us</h2>
    <p>
      Once sorted, bring everything to one accessible place. Then contact
      us via WhatsApp with your item list and location. Photos of anything
      bulky, damaged, or battery-related speed up confirmation. Book your
      <a href="/pickup/">pickup slot</a> once feasibility is confirmed.
    </p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/pickup/">Book Pickup</a>
      <a href="/battery-recycling/">Battery Recycling</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />
  <section class="final-cta">
    <h2>Ready to Book Your Household E-Waste Pickup?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I'd like to book a household e-waste pickup." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .check-list { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1.25rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .quick-answer { padding: 1.1rem 1.25rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-surface); margin: 1.5rem 0; }
  .quick-answer-label { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary); }
  .quick-answer p:last-child { margin: 0; color: var(--color-text); }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
