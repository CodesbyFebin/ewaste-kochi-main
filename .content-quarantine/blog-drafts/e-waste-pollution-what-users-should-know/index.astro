---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "E-Waste Pollution: What Users Should Know";
const description = "E-Waste Pollution: What Users Should Know — practical guidance for Kochi households and businesses, covering why recycle e-waste, environmental impact.";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "E-Waste Pollution: What Users Should Know", path: "/blog/e-waste-pollution-what-users-should-know/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/e-waste-pollution-what-users-should-know/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/e-waste-pollution-what-users-should-know/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "What should offices do?", a: "Route surplus IT equipment through a compliant recycler and consider resale for working devices before recycling." },
  { q: "What questions should I ask?", a: "Whether the recycler handles batteries separately, how data is managed, and where materials end up." },
  { q: "What should families do?", a: "Keep electronics out of general waste, separate batteries, and consider donation or resale for working devices." },
  { q: "What is responsible disposal?", a: "Routing electronics through an authorized recycler that handles hazardous materials, batteries and data correctly." },
];
---

<Layout title={title} description={description} path="/blog/e-waste-pollution-what-users-should-know/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>E-Waste Pollution: What Users Should Know</h1>
  <p class="lede">Here's what you need to know, in plain terms. Hazardous substances — lead, mercury, cadmium — can leach into soil and groundwater when electronics end up in landfills.</p>

  <CtaBar whatsappMessage="Hi, I have a question about e-waste pollution: what users should know." />

  <ul class="key-takeaways">
    <li>Electronics mix recoverable value with genuinely hazardous materials.</li>
    <li>Reuse and repair reduce e-waste more than recycling alone.</li>
    <li>Battery separation is both a safety and an environmental measure.</li>
  </ul>

  <section>
    <h2>What happens when e-waste is dumped</h2>
    <p>Hazardous substances — lead, mercury, cadmium — can leach into soil and groundwater when electronics end up in landfills. Burning to extract metals, common in informal handling, releases toxic fumes.</p>
  </section>

  <section>
    <h2>Why informal handling is riskier</h2>
    <p>Informal scrap processing typically skips safety measures for both hazardous materials and worker protection. Choosing a compliant recycler avoids this entirely.</p>
  </section>

  <section>
    <h2>What households can do</h2>
    <p>Small habits make a real difference: don't mix electronics with general trash, separate batteries as you find them, and consider donation or resale before recycling a working device.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/trust/">Trust & Compliance</a>
      <a href="/recycling/">E-Waste Recycling</a>
      <a href="/pickup/">Pickup</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/e-waste-pollution-what-users-should-know/" />

  <section class="final-cta">
    <h2>Have Questions About E-Waste Pollution: What Users Should Know?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about e-waste pollution: what users should know." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
