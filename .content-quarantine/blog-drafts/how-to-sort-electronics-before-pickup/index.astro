---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "How to Sort Electronics Before E-Waste Pickup | Kochi Guide";
const description =
  "How to sort old electronics before a pickup in Kochi — what to separate, how to handle batteries safely, and which items to flag in advance for smooth collection.";
const datePublished = "2026-07-08";
const dateModified = "2026-07-08";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "How to Sort Electronics Before Pickup", path: "/blog/how-to-sort-electronics-before-pickup/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/how-to-sort-electronics-before-pickup/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/how-to-sort-electronics-before-pickup/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  {
    q: "Does the sorting need to be perfect?",
    a: "No. The most important separation is batteries from other items, and flagging anything damaged. Beyond that, rough grouping is enough.",
  },
  {
    q: "What if I accidentally mix batteries with other electronics?",
    a: "Let the team know when they arrive. The team handles sorting — your role is to flag the obvious safety items upfront.",
  },
  {
    q: "Can I include small and large items in the same pickup?",
    a: "Yes — mixed pickups are normal. Flag large or heavy items when booking so the team can plan the visit.",
  },
];
---

<Layout title={title} description={description} path="/blog/how-to-sort-electronics-before-pickup/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>How to Sort Electronics Before Pickup</h1>
  <p class="lede">
    You don't need to do a full technical sort before pickup — but a few
    simple separations make the collection faster and safer for everyone.
  </p>

  <CtaBar whatsappMessage="Hi, I'd like to prepare for an e-waste pickup." />

  <div class="quick-answer">
    <p class="quick-answer-label">Quick answer</p>
    <p>
      The one sort that really matters is batteries — keep them
      separate from everything else, always. Beyond that, group
      data-bearing devices together if you want data destruction, flag
      large or damaged items, and everything else can go in one
      accessible pile.
    </p>
  </div>

  <ul class="key-takeaways">
    <li>Battery separation is the single most important step, not perfect organization.</li>
    <li>Swollen or leaking batteries need to be isolated and flagged with a photo if unsure.</li>
    <li>The team handles detailed sorting after collection — rough grouping is enough.</li>
  </ul>

  <section>
    <h2>The one separation that matters most: batteries</h2>
    <p>
      Always keep batteries physically separate from other electronics.
      This includes UPS batteries, inverter batteries, laptop battery
      packs, power banks, and phone batteries (if removed from the
      device). Put them in a separate bag or box, and don't stack items
      on top. See <a href="/battery-recycling/">battery recycling</a> for
      why this matters.
    </p>
  </section>

  <section>
    <h2>Flag damaged or swollen batteries separately</h2>
    <p>
      A swollen battery (visibly bulging casing), a leaking battery, or
      a battery that's unusually hot needs to be kept isolated from
      everything else and flagged clearly before pickup. Contact us with
      a photo if you're unsure whether a battery is safe to store
      normally before collection.
    </p>
  </section>

  <section>
    <h2>Group data-bearing devices together</h2>
    <p>
      If you want data destruction handled as part of the pickup, group
      storage devices (laptops, phones, hard drives, tablets) separately
      and mention this when booking. See
      <a href="/data-destruction/">data destruction</a> for options.
    </p>
  </section>

  <section>
    <h2>Flag large or heavy items</h2>
    <p>
      Old CRT monitors, server racks, large UPS units, and heavy inverter
      batteries need to be flagged in advance so the team can plan access
      and transport. Mention these when you first contact us.
    </p>
  </section>

  <section>
    <h2>Everything else can go together</h2>
    <p>
      General electronics — laptops, monitors, printers, routers, cables,
      phones (once batteries are removed where applicable), TVs — can all
      go in one accessible pile. No need to sort by brand, age, or
      material type. The team handles detailed sorting after collection.
    </p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/battery-recycling/">Battery Recycling</a>
      <a href="/data-destruction/">Data Destruction</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />
  <section class="final-cta">
    <h2>Ready to Book Your Pickup?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I'd like to prepare for an e-waste pickup." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .quick-answer { padding: 1.1rem 1.25rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-surface); margin: 1.5rem 0; }
  .quick-answer-label { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary); }
  .quick-answer p:last-child { margin: 0; color: var(--color-text); }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
