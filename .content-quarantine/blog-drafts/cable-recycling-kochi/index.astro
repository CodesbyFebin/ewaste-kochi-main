---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Cable Recycling in Kochi | Wire, Charger & Adapter Disposal";
const description =
  "How to recycle old cables, chargers, adapters and wires in Kochi. Sorting tips, scrap value factors, and pickup options for homes and offices.";
const datePublished = "2026-07-08";
const dateModified = "2026-07-08";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Cable Recycling in Kochi", path: "/blog/cable-recycling-kochi/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/cable-recycling-kochi/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/cable-recycling-kochi/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  {
    q: "Can old cables be recycled in Kochi?",
    a: "Yes. Power cords, USB cables, network cables, charging cables and adapters are accepted for recycling.",
  },
  {
    q: "Do cables have scrap value?",
    a: "Some cables, especially thicker power cords and copper wires, may have scrap value depending on quantity and condition. Send details for a quote.",
  },
  {
    q: "Should I separate cables from other electronics?",
    a: "It helps to bundle cables separately or keep them with their parent device. Either way works — just let us know what you have.",
  },
  {
    q: "Can offices request bulk cable pickup?",
    a: "Yes. Offices with accumulated cables from IT cleanouts can request bulk pickup. Sorting by type helps but is not required.",
  },
  {
    q: "Can damaged or frayed cables be recycled?",
    a: "Yes. Damaged cables, frayed wires and broken chargers are accepted. Mention any damage when contacting us.",
  },
];
---

<Layout title={title} description={description} path="/blog/cable-recycling-kochi/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Cable Recycling in Kochi</h1>
  <p class="lede">
    Old cables, chargers and adapters accumulate quickly in homes and offices.
    Here is how to recycle them in Kochi, including sorting tips and
    what affects their scrap value.
  </p>

  <CtaBar whatsappMessage="Hi, I have old cables and chargers for recycling." />

  <div class="quick-answer">
    <p class="quick-answer-label">Quick answer</p>
    <p>
      Old cables, chargers and adapters can be recycled in Kochi as part
      of any e-waste pickup — no need to sort every wire by type. Bundle
      them loosely, separate anything damaged, and mention the
      approximate quantity when you book; larger volumes of copper-rich
      cords may carry modest scrap value.
    </p>
  </div>

  <ul class="key-takeaways">
    <li>Cables don't need to be sorted meticulously — just bundled loosely.</li>
    <li>Copper-rich power cords generally carry more value than thin signal cables.</li>
    <li>Damaged or frayed cables should be flagged, not hidden in the bundle.</li>
    <li>Cables can be included in any mixed e-waste pickup, no separate visit needed.</li>
  </ul>

  <section>
    <h2>What cables and accessories are accepted?</h2>
    <ul>
      <li>Power cords and extension cords</li>
      <li>USB cables (micro, type-C, lightning)</li>
      <li>Network and ethernet cables</li>
      <li>Chargers and power adapters</li>
      <li>Audio and video cables (HDMI, RCA, aux)</li>
      <li>Old phone and device chargers</li>
    </ul>
  </section>

  <section>
    <h2>Sorting cables before pickup</h2>
    <p>
      While you do not need to sort every cable by type, a little organisation
      helps:
    </p>
    <ul>
      <li>Bundle cables loosely with rubber bands or cable ties — no need to wrap tightly</li>
      <li>Keep chargers and adapters together with their cables if possible</li>
      <li>Separate damaged or frayed cables so they can be flagged</li>
      <li>If you have a large quantity, separate power cords from thin signal cables</li>
    </ul>
  </section>

  <section>
    <h2>What affects cable value?</h2>
    <p>
      Cables typically have modest scrap value, but some factors can
      increase it:
    </p>
    <ul>
      <li>Copper content — thicker power cords contain more copper and have higher value</li>
      <li>Quantity — larger volumes of bundled cables are easier to process</li>
      <li>Condition — intact cables with undamaged connectors are preferred</li>
      <li>Type — network and specialty cables may have different material composition</li>
    </ul>
  </section>

  <section>
    <h2>How to include cables in a mixed e-waste pickup</h2>
    <p>
      Cables can be included with any other e-waste pickup. Simply bundle
      them together and mention them when you send your item list. If you
      have a large quantity of cables separate from other electronics,
      let us know so we can plan the pickup accordingly.
    </p>
  </section>

  <section>
    <h2>What to include in your message</h2>
    <ul class="check-list">
      <li>Approximate quantity of cables (e.g. a bagful, a box, etc.)</li>
      <li>Types — power cords, USB, network, mixed</li>
      <li>Any damaged or frayed cables</li>
      <li>Whether cables are bundled with other electronics</li>
      <li>Your pickup location in Kochi</li>
    </ul>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/recycling/">E-Waste Recycling</a>
      <a href="/pickup/">Book Pickup</a>
      <a href="/e-waste-scrap-prices-kochi/">Scrap Price Guide</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <section class="final-cta">
    <h2>Have Old Cables and Chargers to Recycle?</h2>
    <p>Bundle them up and mention the approximate quantity when you book.</p>
    <CtaBar whatsappMessage="Hi, I have old cables and chargers for recycling." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .check-list { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1.25rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .quick-answer { padding: 1.1rem 1.25rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-surface); margin: 1.5rem 0; }
  .quick-answer-label { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary); }
  .quick-answer p:last-child { margin: 0; color: var(--color-text); }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>