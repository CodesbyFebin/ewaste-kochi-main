---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Working vs Non-Working Electronics";
const description = "Working vs Non-Working Electronics — practical guidance for Kochi households and businesses, covering sell old electronics Kochi, sell old laptop Kochi, scrap quote.";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Working vs Non-Working Electronics", path: "/blog/working-vs-non-working-electronics/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/working-vs-non-working-electronics/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/working-vs-non-working-electronics/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "Can broken electronics be sold?", a: "Yes, non-working devices can still have component or scrap value. Mention the condition honestly when you message." },
  { q: "Can offices sell bulk electronics?", a: "Yes, message the full list with quantities for a consolidated quote." },
  { q: "What electronics may have resale value?", a: "Laptops, phones, tablets and some desktop components most commonly have resale value, but it depends on condition and demand — ask about any specific device." },
  { q: "Can I sell old electronics in Kochi?", a: "Yes. Message the device type, condition and photos on WhatsApp for a preliminary quote, then arrange doorstep pickup and payment if you accept it." },
];
---

<Layout title={title} description={description} path="/blog/working-vs-non-working-electronics/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Working vs Non-Working Electronics</h1>
  <p class="lede">The short version of how these compare, so you can decide which applies to your situation. A device that doesn't power on isn't automatically worthless — component and scrap value can still apply.</p>

  <CtaBar whatsappMessage="Hi, I have a question about working vs non-working electronics." />

  <ul class="key-takeaways">
    <li>Working and non-working devices can both have value — ask either way.</li>
    <li>Quotes are condition-based, confirmed after inspection, not fixed in advance.</li>
    <li>Wipe your data before handover, or ask about data destruction support.</li>
  </ul>

  <section>
    <h2>Broken devices still have value</h2>
    <p>A device that doesn't power on isn't automatically worthless — component and scrap value can still apply. Describe the condition honestly rather than assuming it disqualifies the item.</p>
  </section>

  <section>
    <h2>When recycling makes more sense</h2>
    <p>Very old, badly damaged, or extremely low-demand devices may be better suited to straightforward recycling than the extra step of a resale conversation. If a quote comes back lower than expected, recycling is always the fallback with no obligation.</p>
  </section>

  <section>
    <h2>What actually drives value</h2>
    <p>Working condition, age, specifications, physical condition and current market demand all factor into a quote. Brand and model matter less on their own than whether the device actually powers on and functions normally.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/sell-electronics/">Sell Electronics</a>
      <a href="/e-waste-scrap-prices-kochi/">Scrap Price Guide</a>
      <a href="/marketplace/">Marketplace</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/working-vs-non-working-electronics/" />

  <section class="final-cta">
    <h2>Have Questions About Working vs Non-Working Electronics?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about working vs non-working electronics." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
