---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Electronics Recycling Checklist Before You Book Pickup | Kochi";
const description =
  "A complete checklist to run through before booking an e-waste pickup in Kochi — data, batteries, building access, bulky items, and what to include in your WhatsApp message.";
const datePublished = "2026-07-08";
const dateModified = "2026-07-08";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Electronics Recycling Checklist Before You Book Pickup", path: "/blog/electronics-recycling-checklist-before-pickup/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/electronics-recycling-checklist-before-pickup/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/electronics-recycling-checklist-before-pickup/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  {
    q: "Do I need to complete the full checklist before booking?",
    a: "Not all items apply to every pickup. Go through the list, skip what doesn't apply, and flag anything relevant when you message us.",
  },
  {
    q: "Can I book pickup and then prepare items after?",
    a: "Yes — you can contact us to confirm feasibility and then finalise preparation before the agreed pickup slot.",
  },
  {
    q: "What if I realise I have more items after booking?",
    a: "Let us know before pickup day. Adding items is usually straightforward unless it significantly changes the scope.",
  },
];
---

<Layout title={title} description={description} path="/blog/electronics-recycling-checklist-before-pickup/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Electronics Recycling Checklist Before You Book Pickup</h1>
  <p class="lede">
    Use this checklist before contacting us to book your e-waste pickup.
    It covers everything from data and batteries to building access and
    what to say in your WhatsApp message.
  </p>

  <CtaBar whatsappMessage="Hi, I've prepared my e-waste and I'd like to book a pickup." />

  <div class="quick-answer">
    <p class="quick-answer-label">Quick answer</p>
    <p>
      Before booking an e-waste pickup in Kochi, back up and wipe your
      data, separate batteries into their own bag, flag anything bulky
      or damaged, and note your pickup address and preferred timeframe.
      Not every item on this checklist applies to every pickup — skip
      what doesn't apply and flag what does.
    </p>
  </div>

  <ul class="key-takeaways">
    <li>Data and battery preparation matter more than exact item sorting.</li>
    <li>Photos of damaged, bulky or battery items speed up confirmation.</li>
    <li>You can add items after booking — just mention them before pickup day.</li>
    <li>A rough list (type + quantity) is enough; serial numbers aren't needed.</li>
  </ul>

  <section>
    <h2>Data and accounts</h2>
    <ul class="check-list">
      <li>Back up all photos, documents, and files you want to keep</li>
      <li>Sign out of all accounts on phones and tablets</li>
      <li>Factory reset phones and tablets</li>
      <li>Wipe computer hard drives or request data destruction at booking</li>
      <li>Remove SIM cards and memory cards</li>
      <li>Deauthorise software licences on computers</li>
    </ul>
  </section>

  <section>
    <h2>Batteries</h2>
    <ul class="check-list">
      <li>Identify all battery-containing items (phones, laptops, UPS, inverter, power banks)</li>
      <li>Put batteries in a separate bag or box</li>
      <li>Check for swollen, leaking or damaged batteries — flag these before pickup</li>
      <li>Do not stack heavy items on battery bags</li>
    </ul>
  </section>

  <section>
    <h2>Logistics</h2>
    <ul class="check-list">
      <li>Confirm your pickup area is serviceable (message us to check)</li>
      <li>Note your address, floor, building name if in an apartment</li>
      <li>Flag any large or heavy items — old CRT TVs, server racks, UPS units</li>
      <li>Take photos of large, damaged, or battery items to send with booking</li>
      <li>Decide whether you want a quote for any items that might have value</li>
    </ul>
  </section>

  <section>
    <h2>What to include in your WhatsApp message</h2>
    <ul class="check-list">
      <li>Rough item list (type + quantity, not serial numbers)</li>
      <li>Any batteries or damaged items (with photos if possible)</li>
      <li>Your pickup address or area</li>
      <li>Preferred pickup timeframe</li>
      <li>Data destruction requirements if any</li>
    </ul>
  </section>  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/recycling/">E-Waste Recycling</a>
      <a href="/pickup/">Book Pickup</a>
    </div>
  </section>



  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />
  <section class="final-cta">
    <h2>Have Questions About Electronics Recycling Checklist Before You Book Pickup?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I've prepared my e-waste and I'd like to book a pickup." compact />
  </section>


  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .check-list { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1.25rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .quick-answer { padding: 1.1rem 1.25rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-surface); margin: 1.5rem 0; }
  .quick-answer-label { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary); }
  .quick-answer p:last-child { margin: 0; color: var(--color-text); }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
