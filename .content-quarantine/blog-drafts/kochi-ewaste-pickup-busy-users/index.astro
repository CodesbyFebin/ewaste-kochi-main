---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Kochi E-Waste Pickup Guide for Busy Users | Quick Process";
const description =
  "A quick guide to e-waste pickup in Kochi for people who don't have much time — what's essential, how to book in minutes on WhatsApp, and what you can skip.";
const datePublished = "2026-07-08";
const dateModified = "2026-07-08";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Kochi E-Waste Pickup Guide for Busy Users", path: "/blog/kochi-ewaste-pickup-busy-users/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/kochi-ewaste-pickup-busy-users/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/kochi-ewaste-pickup-busy-users/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  {
    q: "How fast can I get this done?",
    a: "If your items are ready: send a WhatsApp message today, confirm a slot tomorrow, pickup within a few days. The process is genuinely quick.",
  },
  {
    q: "What's the minimum I need to do?",
    a: "Back up and wipe data, put batteries in a separate bag, send a message with what you have and your location.",
  },
  {
    q: "Can I leave items with a building security guard or reception for pickup?",
    a: "Contact us to arrange this when booking — it's sometimes possible for standard items without complex handling requirements.",
  },
];
---

<Layout title={title} description={description} path="/blog/kochi-ewaste-pickup-busy-users/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Kochi E-Waste Pickup Guide for Busy Users</h1>
  <p class="lede">
    Don't have time to read a full guide? Here's the minimum you need
    to know to get your old electronics picked up in Kochi quickly.
  </p>

  <CtaBar whatsappMessage="Hi, I need a quick e-waste pickup. Here's what I have:" />

  <div class="quick-answer">
    <p class="quick-answer-label">Quick answer</p>
    <p>
      Wipe your devices, put batteries in their own bag, and send one
      WhatsApp message with your item list and address. That's the
      entire process — no sorting by category, no packaging, no
      cleaning required.
    </p>
  </div>

  <ul class="key-takeaways">
    <li>Data wipe and battery separation are the only two things you truly can't skip.</li>
    <li>You don't need original packaging, cleaning, or disassembly.</li>
    <li>One WhatsApp message with item list and address is enough to start.</li>
  </ul>

  <section>
    <h2>The 3-step short version</h2>
    <ol class="steps">
      <li><strong>Wipe your devices</strong> — back up and factory reset phones and laptops</li>
      <li><strong>Separate batteries</strong> — put them in their own bag, away from everything else</li>
      <li><strong>Send one WhatsApp message</strong> — item list + address. Done</li>
    </ol>
  </section>

  <section>
    <h2>What you can skip</h2>
    <ul class="check-list">
      <li>You don't need to sort by category or material</li>
      <li>You don't need original packaging</li>
      <li>You don't need to clean devices</li>
      <li>You don't need to disassemble anything</li>
      <li>You don't need to figure out which items have value</li>
    </ul>
  </section>

  <section>
    <h2>What you must not skip</h2>
    <ul class="check-list">
      <li>Data wipe on phones and computers — this is your responsibility, not ours by default</li>
      <li>Separating batteries — especially if any are swollen or damaged</li>
      <li>Flagging large heavy items like CRT TVs or server racks before booking</li>
    </ul>
  </section>

  <section>
    <h2>Book in 2 minutes</h2>
    <p>
      Open WhatsApp, message us:
      <em>"Hi, I have [2 old phones, 1 broken laptop, some cables]. In Kakkanad. Can you arrange pickup?"</em>
      That's enough to start. We'll handle the rest from there.
    </p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/pickup/">Book Pickup</a>
      <a href="/battery-recycling/">Battery Recycling</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />
  <section class="final-cta">
    <h2>Ready for a Quick Pickup?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I need a quick e-waste pickup. Here's what I have:" compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .steps { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1.5rem; }
  .check-list { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1.25rem; }
  em { font-style: italic; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .quick-answer { padding: 1.1rem 1.25rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-surface); margin: 1.5rem 0; }
  .quick-answer-label { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary); }
  .quick-answer p:last-child { margin: 0; color: var(--color-text); }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
