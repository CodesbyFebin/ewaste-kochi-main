---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "How to Prepare Your Device for Sale or Recycling";
const description = "How to Prepare Your Device for Sale or Recycling — practical guidance for Kochi households and businesses, covering sell old electronics Kochi, sell old laptop Ko...";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "How to Prepare Your Device for Sale or Recycling", path: "/blog/how-to-prepare-your-device-for-sale-or-recycling/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/how-to-prepare-your-device-for-sale-or-recycling/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/how-to-prepare-your-device-for-sale-or-recycling/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "Is resale better than recycling?", a: "For working devices, resale is usually worth checking first since it captures more value than recycling. Non-working or very old devices are often better suited to recycling." },
  { q: "Is cash guaranteed?", a: "Payment is arranged once a quote is accepted, confirmed at the time of inspection rather than promised in advance." },
  { q: "Can batteries be sold?", a: "Batteries are generally handled through battery recycling rather than resale, given the different safety and handling requirements." },
  { q: "What is condition-based value?", a: "It means the quote reflects the device's actual working status, physical condition and completeness rather than a flat rate by model alone." },
];
---

<Layout title={title} description={description} path="/blog/how-to-prepare-your-device-for-sale-or-recycling/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>How to Prepare Your Device for Sale or Recycling</h1>
  <p class="lede">A step-by-step answer, covering what actually matters and what you can skip. A device that doesn't power on isn't automatically worthless — component and scrap value can still apply.</p>

  <CtaBar whatsappMessage="Hi, I have a question about how to prepare your device for sale or recycling." />

  <ul class="key-takeaways">
    <li>Working and non-working devices can both have value — ask either way.</li>
    <li>Quotes are condition-based, confirmed after inspection, not fixed in advance.</li>
    <li>Wipe your data before handover, or ask about data destruction support.</li>
  </ul>

  <section>
    <h2>Broken devices still have value</h2>
    <p>A device that doesn't power on isn't automatically worthless — component and scrap value can still apply. Describe the condition honestly rather than assuming it disqualifies the item.</p>
  </section>

  <section>
    <h2>Getting an accurate quote</h2>
    <p>Clear photos and an honest condition description — front, back, any damage — lead to a more reliable preliminary estimate. The confirmed number is always set at inspection, since condition can look different once the item is actually seen.</p>
  </section>

  <section>
    <h2>Selling in bulk</h2>
    <p>Clearing out multiple devices from an office upgrade is common — share the full list with quantities for a consolidated quote rather than handling items one at a time.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/sell-electronics/">Sell Electronics</a>
      <a href="/e-waste-scrap-prices-kochi/">Scrap Price Guide</a>
      <a href="/marketplace/">Marketplace</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/how-to-prepare-your-device-for-sale-or-recycling/" />

  <section class="final-cta">
    <h2>Have Questions About How to Prepare Your Device for Sale or Recycling?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about how to prepare your device for sale or recycling." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
