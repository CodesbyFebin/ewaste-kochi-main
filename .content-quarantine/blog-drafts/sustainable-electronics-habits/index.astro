---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Sustainable Electronics Habits";
const description = "Sustainable Electronics Habits — practical guidance for Kochi households and businesses, covering why recycle e-waste, environmental impact.";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Sustainable Electronics Habits", path: "/blog/sustainable-electronics-habits/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/sustainable-electronics-habits/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/sustainable-electronics-habits/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "Why should electronics not be dumped?", a: "Hazardous materials can leach into soil and groundwater, and batteries pose a fire risk when crushed in general waste collection." },
  { q: "What is informal scrap handling?", a: "Processing by unregistered dealers who typically skip environmental and safety safeguards." },
  { q: "What is responsible disposal?", a: "Routing electronics through an authorized recycler that handles hazardous materials, batteries and data correctly." },
  { q: "Can households reduce e-waste?", a: "Yes — extending device life through care and repair, and choosing reuse or resale over recycling when a device still works." },
];
---

<Layout title={title} description={description} path="/blog/sustainable-electronics-habits/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Sustainable Electronics Habits</h1>
  <p class="lede">Here's what you need to know, in plain terms. Routing office e-waste through a compliant recycler, keeping devices out of general waste streams, and choosing reuse or resale for working equipment all reduce a business's e-waste footprint.</p>

  <CtaBar whatsappMessage="Hi, I have a question about sustainable electronics habits." />

  <ul class="key-takeaways">
    <li>Small household habits — not mixing e-waste with general trash — add up.</li>
    <li>Battery separation is both a safety and an environmental measure.</li>
    <li>Reuse and repair reduce e-waste more than recycling alone.</li>
  </ul>

  <section>
    <h2>What businesses can do</h2>
    <p>Routing office e-waste through a compliant recycler, keeping devices out of general waste streams, and choosing reuse or resale for working equipment all reduce a business's e-waste footprint.</p>
  </section>

  <section>
    <h2>Reuse comes before recycling</h2>
    <p>A device that still works and gets reused avoids the energy cost of disassembly and material recovery entirely. Repair, when practical, extends a device's life further still — recycling is the right path only once neither is realistic.</p>
  </section>

  <section>
    <h2>Why battery separation matters environmentally</h2>
    <p>Batteries left in general waste can leak chemicals or, if damaged, cause fires in collection vehicles. Separating them protects both the environment and the people handling waste.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/trust/">Trust & Compliance</a>
      <a href="/recycling/">E-Waste Recycling</a>
      <a href="/pickup/">Pickup</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/sustainable-electronics-habits/" />

  <section class="final-cta">
    <h2>Have Questions About Sustainable Electronics Habits?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about sustainable electronics habits." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
