---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Old Computer Accessories Recycling in Kochi | Keyboards, Mice & Parts";
const description =
  "How to recycle old computer accessories in Kochi — keyboards, mice, speakers, webcams, hard drives and other peripherals. Preparation and pickup tips.";
const datePublished = "2026-07-08";
const dateModified = "2026-07-08";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Old Computer Accessories Recycling", path: "/blog/old-computer-accessories-recycling-kochi/" },
];

const jsonLd = [
  { "@context": "https://schema.org", "@type": "BlogPosting", headline: title, description, datePublished, dateModified, author: { "@type": "Organization", name: BUSINESS.legalName }, publisher: { "@id": `${SITE_URL}/#organization` }, mainEntityOfPage: `${SITE_URL}/blog/old-computer-accessories-recycling-kochi/` },
  { "@context": "https://schema.org", "@type": "WebPage", "@id": `${SITE_URL}/blog/old-computer-accessories-recycling-kochi/`, name: title, description, dateModified },
];

const faqItems = [
  { q: "Can old keyboards and mice be recycled?", a: "Yes. Keyboards, mice, speakers, webcams and other computer peripherals are accepted for recycling." },
  { q: "Do I need to separate computer accessories from other e-waste?", a: "Not necessarily. You can include them with other electronics in the same pickup. Bundling them together helps." },
  { q: "Can broken or damaged accessories be recycled?", a: "Yes. Non-functional accessories are accepted. Mention any damage when contacting us." },
  { q: "Can offices recycle bulk computer accessories?", a: "Yes. Offices with accumulated peripherals from IT upgrades can request bulk pickup. Send quantities for planning." },
  { q: "Are old speakers and webcams accepted?", a: "Yes. Computer speakers, webcams, microphones and other peripherals are all accepted for recycling." },
];
---

<Layout title={title} description={description} path="/blog/old-computer-accessories-recycling-kochi/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Old Computer Accessories Recycling in Kochi</h1>
  <p class="lede">Old keyboards, mice, speakers and other computer peripherals accumulate over time. Here is how to recycle them in Kochi.</p>
  <CtaBar whatsappMessage="Hi, I have old computer accessories for recycling." />

  <div class="quick-answer">
    <p class="quick-answer-label">Quick answer</p>
    <p>
      Yes — keyboards, mice, speakers, webcams, hard drives and other
      peripherals are all accepted. You can bundle them with other
      electronics in the same pickup; no need to separate accessories
      unless a wireless device still has a battery inside.
    </p>
  </div>

  <ul class="key-takeaways">
    <li>Accessories don't need to be sorted separately from other e-waste.</li>
    <li>Remove batteries from wireless devices first if easily accessible.</li>
    <li>Offices with bulk accumulated peripherals can request a combined pickup.</li>
  </ul>

  <section><h2>What computer accessories are accepted</h2><ul><li>Keyboards — wired and wireless</li><li>Mice and trackpads</li><li>Computer speakers</li><li>Webcams and microphones</li><li>External hard drives and USB drives</li><li>Docking stations and hubs</li><li>Graphics cards, RAM, internal components</li><li>Cooling fans and power supplies</li></ul></section>
  <section><h2>Preparing accessories for pickup</h2><ul class="check-list"><li>Bundle cables and dongles with their devices if possible</li><li>Remove batteries from wireless devices if easily accessible</li><li>Take photos showing the types and quantity</li><li>For offices — group similar items together</li><li>Flag any damaged or non-functional items</li></ul></section>
  <section><h2>What to include in your message</h2><ul class="check-list"><li>Types and approximate quantity</li><li>Whether items are working or not</li><li>Any batteries inside wireless devices</li><li>Your pickup location in Kochi</li></ul></section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/computer-scrap-buyers-kochi/">Computer Scrap Buyers</a>
      <a href="/pickup/">Book Pickup</a>
    </div>
  </section>

  <p class="mal-support">മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.</p>
  <Faq items={faqItems} />
  <section class="final-cta">
    <h2>Have Old Computer Accessories to Recycle?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have old computer accessories for recycling." compact />
  </section>
  <p class="updated">Last updated: {dateModified}</p>
</Layout>
<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .check-list { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1.25rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .quick-answer { padding: 1.1rem 1.25rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-surface); margin: 1.5rem 0; }
  .quick-answer-label { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary); }
  .quick-answer p:last-child { margin: 0; color: var(--color-text); }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>