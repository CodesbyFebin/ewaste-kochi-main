---
import LocationHub from "../../../components/LocationHub.astro";

const name = "North Paravur";
const path = "/locations/north-paravur/";
const title = "E-Waste Pickup in North Paravur | Feasibility Check";
const description =
  "E-waste pickup support for North Paravur homes and businesses. Send electronics, battery and IT asset details to check feasibility.";
const context =
  "North Paravur pickup requests are reviewed based on item quantity, route availability and handling needs. Contact first for a realistic pickup answer.";
---

<LocationHub name={name} path={path} title={title} description={description} context={context} />
