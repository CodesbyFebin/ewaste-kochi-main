---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DirectAnswer from "../../../components/DirectAnswer.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "E-Waste Recycling in Kannur, Kerala | Pickup Feasibility Check";
const description =
  "Kannur isn't a standard doorstep pickup area for Ewaste Kochi, but we check feasibility for Kannur enquiries — bulk, business, and drop-off options. Contact us to find out what's possible.";
const lastUpdated = "2026-07-15";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Locations", path: "/locations/" },
  { name: "Kannur", path: "/locations/kannur/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "E-waste pickup feasibility check",
    provider: { "@id": `${SITE_URL}/#organization` },
    areaServed: { "@type": "Place", name: "Kannur, Kerala" },
    url: `${SITE_URL}/locations/kannur/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/locations/kannur/`,
    name: title,
    description,
    dateModified: lastUpdated,
  },
];

const faqItems = [
  {
    q: "Do you offer doorstep e-waste pickup in Kannur?",
    a: "Not as a standard, scheduled service — Kannur is the farthest of the districts we get regular enquiries from and is well outside our core Kochi-metro coverage. We check feasibility case by case, particularly for bulk or business volumes, rather than promising pickup upfront.",
  },
  {
    q: "What makes pickup feasible from Kannur?",
    a: "Mostly item volume, type, and exact location, weighed against the roughly 250 km distance from Kochi — the longest we regularly hear from. A single device is a very hard case for a dedicated trip; genuinely large institutional or business lots are a different calculation. Message us with details.",
  },
  {
    q: "Can Kannur businesses or institutions get pickup arranged?",
    a: "Occasionally — it depends heavily on volume given the distance. If your Kannur business has a genuine large-scale IT or equipment clearance, contact us with an item list and we'll confirm feasibility honestly rather than assume either way.",
  },
  {
    q: "Is there an extra cost given the distance?",
    a: "If a pickup is arranged, any additional logistics cost for the distance would be discussed and agreed upfront — never assumed or added after the fact.",
  },
  {
    q: "What should I do if pickup isn't feasible for my situation?",
    a: "See our recycling guide for general, responsible disposal guidance that applies wherever you are in Kerala, and check locally for authorized collection points in the Malabar region in the meantime.",
  },
  {
    q: "If you do collect from Kannur, are the same safety and data standards used?",
    a: "Yes — the same handling process, battery safety precautions, and data destruction standards apply regardless of location. Distance changes whether pickup is feasible, not how it's handled once collected.",
  },
];
---

<Layout title={title} description={description} path="/locations/kannur/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>E-Waste Recycling in Kannur</h1>
  <p class="lede">
    Ewaste Kochi primarily supports Kochi, Ernakulam, Kakkanad, Kalamassery,
    Ernakulam South, Aluva and nearby Kochi-metro enquiry areas. For other
    Kerala districts, contact us to check pickup feasibility. Kannur is roughly 250 km away — the
    farthest of the districts we regularly hear from, and well outside our
    core zone, so we don't run scheduled routes here. We do check
    feasibility for Kannur enquiries case by case, especially for large
    bulk or business volumes.
  </p>

  <DirectAnswer>
    <p>{description}</p>
  </DirectAnswer>

  <CtaBar whatsappMessage="Hi, I'm in Kannur and want to check if e-waste pickup is feasible for my situation." />

  <section>
    <h2>About Kannur</h2>
    <p>
      Kannur is a Malabar-region city known for its handloom weaving
      tradition, a working port, and a growing airport and cantonment area
      that has brought newer business activity to the district.
    </p>
  </section>

  <section>
    <h2>What's possible from Kannur</h2>
    <p>
      Given the distance, a single old phone or laptop is a very hard case
      for a dedicated trip. Genuinely large office IT decommissioning,
      institutional battery lots, or other bulk volumes are a different
      calculation — message us with a rough item list and quantity so we
      can give an honest feasibility answer rather than a guess.
    </p>
  </section>

  <section>
    <h2>Compliance</h2>
    <p>
      If a pickup is arranged from Kannur, it follows the same documented
      environmental handling practices used across all our service areas.
      Documentation support may be available depending on the service type
      and agreed handling process — contact us via our
      <a href="/contact/">contact page</a> to confirm what's available.
    </p>
  </section>

  <section>
    <h2>Not feasible right now?</h2>
    <p>
      If a Kannur pickup doesn't work out for your specific case, our
      <a href="/recycling/">recycling guide</a> covers responsible disposal
      principles that apply anywhere in Kerala, and our
      <a href="/blog/recycling-basics/">recycling basics</a> guide is a good
      starting point for finding a locally authorized option in the
      meantime.
    </p>
  </section>

  <section>
    <h2>Other areas</h2>
    <p>
      See the full <a href="/locations/">locations directory</a> for our
      core Kochi-metro service areas and other Kerala districts we check
      feasibility for.
    </p>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} heading="Kannur Pickup FAQs" />

  <p class="updated">Last updated: <time datetime={lastUpdated}>{lastUpdated}</time></p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
</style>
