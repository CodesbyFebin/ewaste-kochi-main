---
import LocationHub from "../../../components/LocationHub.astro";

const name = "Vyttila";
const path = "/locations/vyttila/";
const title = "E-Waste Pickup in Vyttila | Home & Office Electronics";
const description =
  "E-waste pickup support in Vyttila for old electronics, batteries, laptops, desktops and office IT scrap. Confirm availability with item details.";
const context =
  "Vyttila is a common Kochi-metro enquiry area for apartment, home and office e-waste pickup. Share exact location, photos and quantities before scheduling.";
---

<LocationHub name={name} path={path} title={title} description={description} context={context} />
