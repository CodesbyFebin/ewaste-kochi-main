---
import LocationHub from "../../../components/LocationHub.astro";

const name = "Thrikkakara";
const path = "/locations/thrikkakara/";
const title = "E-Waste Pickup in Thrikkakara | IT & Home Electronics";
const description =
  "E-waste pickup support in Thrikkakara for homes, offices, batteries, laptops, desktops and IT assets. Pickup is confirmed after feasibility review.";
const context =
  "Thrikkakara is a common enquiry area for home electronics and office IT refreshes around the Kakkanad and Infopark side of Kochi. Confirm details on WhatsApp first.";
