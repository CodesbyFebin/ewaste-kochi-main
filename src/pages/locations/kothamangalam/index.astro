---
import LocationHub from "../../../components/LocationHub.astro";

const name = "Kothamangalam";
const path = "/locations/kothamangalam/";
const title = "E-Waste Pickup in Kothamangalam | Feasibility Check";
const description =
  "E-waste pickup support for Kothamangalam homes, shops and businesses. Share item details, photos and location to confirm feasibility before pickup.";
const context =
  "Kothamangalam enquiries are reviewed case by case because route timing, item volume and exact address affect feasibility. Bulk or business clearances are more practical than single-item long-distance trips.";
---

<LocationHub name={name} path={path} title={title} description={description} context={context} />
