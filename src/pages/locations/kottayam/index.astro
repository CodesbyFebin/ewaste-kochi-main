---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DirectAnswer from "../../../components/DirectAnswer.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "E-Waste Recycling in Kottayam, Kerala | Pickup Feasibility Check";
const description =
  "Kottayam isn't a standard doorstep pickup area for Ewaste Kochi, but we check feasibility for Kottayam enquiries — bulk, business, and drop-off options. Contact us to find out what's possible.";
const lastUpdated = "2026-07-15";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Locations", path: "/locations/" },
  { name: "Kottayam", path: "/locations/kottayam/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "E-waste pickup feasibility check",
    provider: { "@id": `${SITE_URL}/#organization` },
    areaServed: { "@type": "Place", name: "Kottayam, Kerala" },
    url: `${SITE_URL}/locations/kottayam/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/locations/kottayam/`,
    name: title,
    description,
    dateModified: lastUpdated,
  },
];

const faqItems = [
  {
    q: "Do you offer doorstep e-waste pickup in Kottayam?",
    a: "Not as a standard, scheduled service — Kottayam is outside our core Kochi-metro coverage. We do check feasibility for individual Kottayam enquiries, particularly bulk or business volumes, rather than promising pickup upfront.",
  },
  {
    q: "What makes pickup feasible from Kottayam?",
    a: "Mainly item volume, type, and exact location. A single device is harder to justify a dedicated trip for; office clearances, bulk battery lots, or institutional volumes are more often workable. Message us with details and we'll tell you honestly whether it's practical.",
  },
  {
    q: "Can businesses or institutions in Kottayam still get pickup arranged?",
    a: "Often, yes — bulk volume changes the logistics math. Publishing houses, offices, and institutions in Kottayam with a genuine bulk clearance should contact us directly with an item list; we'll confirm feasibility rather than assume either way.",
  },
  {
    q: "Is there an extra cost for pickup this far from Kochi?",
    a: "If a pickup is arranged, any additional logistics cost for the distance would be discussed and agreed upfront — never assumed or added after the fact.",
  },
  {
    q: "What should I do if pickup isn't feasible for my situation?",
    a: "See our recycling guide for general, responsible disposal guidance that applies wherever you are in Kerala, and check locally for authorized collection points in the meantime.",
  },
  {
    q: "If you do collect from Kottayam, are the same safety and data standards used?",
    a: "Yes — the same handling process, battery safety precautions, and data destruction standards apply regardless of location. Distance changes whether pickup is feasible, not how it's handled once collected.",
  },
];
---

<Layout title={title} description={description} path="/locations/kottayam/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>E-Waste Recycling in Kottayam</h1>
  <p class="lede">
    Ewaste Kochi primarily supports Kochi, Ernakulam, Kakkanad, Kalamassery,
    Ernakulam South, Aluva and nearby Kochi-metro enquiry areas. For other
    Kerala districts, contact us to check pickup feasibility. Kottayam is roughly 60 km away —
    outside that core zone, so we don't run scheduled routes here. We do
    check feasibility for Kottayam enquiries case by case, especially for
    bulk or business volumes.
  </p>

  <DirectAnswer>
    <p>{description}</p>
  </DirectAnswer>

  <CtaBar whatsappMessage="Hi, I'm in Kottayam and want to check if e-waste pickup is feasible for my situation." />

  <section>
    <h2>About Kottayam</h2>
    <p>
      Kottayam is known for its publishing and printing industry — it's
      sometimes called Kerala's "district of letters" — alongside rubber
      cultivation and the backwater tourism around Kumarakom. It sits
      inland, connected to Kochi via NH966/MC Road.
    </p>
  </section>

  <section>
    <h2>What's possible from Kottayam</h2>
    <p>
      A single old laptop or phone usually doesn't justify a dedicated trip
      over this distance. Office clearances, publishing-house IT
      decommissioning, school or institutional battery lots, and other bulk
      volumes are a different calculation — those are worth messaging us
      about directly with a rough item list and quantity, so we can give an
      honest answer on feasibility rather than a guess.
    </p>
  </section>

  <section>
    <h2>Compliance</h2>
    <p>
      If a pickup is arranged from Kottayam, it follows the same documented
      environmental handling practices used across all our service areas.
      Documentation support may be available depending on the service type
      and agreed handling process — contact us via our
      <a href="/contact/">contact page</a> to confirm what's available.
    </p>
  </section>

  <section>
    <h2>Not feasible right now?</h2>
    <p>
      If a Kottayam pickup doesn't work out for your specific case, our
      <a href="/recycling/">recycling guide</a> covers responsible disposal
      principles that apply anywhere in Kerala, and our
      <a href="/blog/recycling-basics/">recycling basics</a> guide is a good
      starting point for finding a locally authorized option in the
      meantime.
    </p>
  </section>

  <section>
    <h2>Business and institutional pickup</h2>
    <p>
      For publishing houses, offices and institutions with a structured,
      asset-tracked decommissioning need rather than a one-off pickup, see
      <a href="/locations/kottayam/itad/">ITAD for Kottayam</a>.
    </p>
  </section>

  <section>
    <h2>Other areas</h2>
    <p>
      See the full <a href="/locations/">locations directory</a> for our
      core Kochi-metro service areas and other Kerala districts we check
      feasibility for.
    </p>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} heading="Kottayam Pickup FAQs" />

  <p class="updated">Last updated: <time datetime={lastUpdated}>{lastUpdated}</time></p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
</style>
