---
import LocationHub from "../../../components/LocationHub.astro";

const name = "Kalady";
const path = "/locations/kalady/";
const title = "E-Waste Pickup in Kalady | Feasibility Check";
const description =
  "E-waste pickup feasibility checks for Kalady electronics, batteries and office IT assets. Contact first with quantity, condition and location.";
const context =
  "Kalady is reviewed as a route-feasibility enquiry rather than a guaranteed pickup area. Bulk, business or institutional quantities are more likely to be workable.";
---

<LocationHub name={name} path={path} title={title} description={description} context={context} />
