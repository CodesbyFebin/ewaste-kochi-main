---
import LocationHub from "../../../components/LocationHub.astro";

const name = "Maradu";
const path = "/locations/maradu/";
const title = "E-Waste Pickup in Maradu | Electronics Collection Support";
const description =
  "E-waste pickup support in Maradu for homes, apartments, shops and offices. Share item details and photos to confirm pickup availability.";
const context =
  "Maradu is a Kochi-metro enquiry area where pickup feasibility depends on building access, quantity, batteries, bulky items and current scheduling.";
---

<LocationHub name={name} path={path} title={title} description={description} context={context} />
