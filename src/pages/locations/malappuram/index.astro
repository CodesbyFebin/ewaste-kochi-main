---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "E-Waste Recycling in Malappuram, Kerala | Pickup Feasibility Check";
const description =
  "Malappuram isn't a standard doorstep pickup area for Ewaste Kochi, but we check feasibility for Malappuram enquiries — bulk, business, and drop-off options. Contact us to find out what's possible.";
const lastUpdated = "2026-07-15";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Locations", path: "/locations/" },
  { name: "Malappuram", path: "/locations/malappuram/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "E-waste pickup feasibility check",
    provider: { "@id": `${SITE_URL}/#organization` },
    areaServed: { "@type": "Place", name: "Malappuram, Kerala" },
    url: `${SITE_URL}/locations/malappuram/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/locations/malappuram/`,
    name: title,
    description,
    dateModified: lastUpdated,
  },
];

const faqItems = [
  {
    q: "Do you offer doorstep e-waste pickup in Malappuram?",
    a: "Not as a standard, scheduled service — Malappuram is outside our core Kochi-metro coverage. We check feasibility for individual Malappuram enquiries, particularly bulk or business volumes, rather than promising pickup upfront.",
  },
  {
    q: "What makes pickup feasible from Malappuram?",
    a: "Mostly item volume, type, and exact location, weighed against the roughly 100-130 km distance from Kochi depending on the specific town. A single device is a hard case; office or institutional clearances from towns like Manjeri, Perinthalmanna, or Tirur are more workable. Message us with details.",
  },
  {
    q: "Can businesses or institutions across Malappuram district get pickup arranged?",
    a: "Sometimes — bulk volume changes the logistics math, and the exact town matters given Malappuram's size. If your business has a genuine IT or equipment clearance, contact us with an item list and location and we'll confirm feasibility rather than assume either way.",
  },
  {
    q: "Is there an extra cost given the distance?",
    a: "If a pickup is arranged, any additional logistics cost for the distance would be discussed and agreed upfront — never assumed or added after the fact.",
  },
  {
    q: "What should I do if pickup isn't feasible for my situation?",
    a: "See our recycling guide for general, responsible disposal guidance that applies wherever you are in Kerala, and check locally for authorized collection points in your part of the district in the meantime.",
  },
  {
    q: "If you do collect from Malappuram, are the same safety and data standards used?",
    a: "Yes — the same handling process, battery safety precautions, and data destruction standards apply regardless of location. Distance changes whether pickup is feasible, not how it's handled once collected.",
  },
];
---

<Layout title={title} description={description} path="/locations/malappuram/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>E-Waste Recycling in Malappuram</h1>
  <p class="lede">
    Ewaste Kochi is based in Ernakulam, and our standard free doorstep
    pickup covers Kochi, Ernakulam, Kakkanad, Kalamassery, Ernakulam South,
    Aluva and nearby Kochi-metro areas. Malappuram is roughly 100-130 km
    away depending on the specific town — outside that core zone, so we
    don't run scheduled routes here. We do check feasibility for
    Malappuram enquiries case by case, especially for bulk or business
    volumes.
  </p>

  <CtaBar whatsappMessage="Hi, I'm in Malappuram and want to check if e-waste pickup is feasible for my situation." />

  <section>
    <h2>About Malappuram</h2>
    <p>
      Malappuram is Kerala's most populous district, spanning a number of
      sizeable towns including Manjeri, Perinthalmanna, and Tirur, each
      with its own local business and institutional activity.
    </p>
  </section>

  <section>
    <h2>What's possible from Malappuram</h2>
    <p>
      A single old phone or laptop usually doesn't justify a dedicated trip
      over this distance. Office IT decommissioning, school or
      institutional battery lots, and other genuinely large volumes from
      anywhere in the district are a different calculation — message us
      with a rough item list, quantity, and your specific town so we can
      give an honest feasibility answer rather than a guess.
    </p>
  </section>

  <section>
    <h2>Compliance</h2>
    <p>
      If a pickup is arranged from Malappuram, it follows the same
      documented environmental handling practices used across all our
      service areas. Documentation support may be available depending on
      the service type and agreed handling process — contact us via our
      <a href="/contact/">contact page</a> to confirm what's available.
    </p>
  </section>

  <section>
    <h2>Not feasible right now?</h2>
    <p>
      If a Malappuram pickup doesn't work out for your specific case, our
      <a href="/recycling/">recycling guide</a> covers responsible disposal
      principles that apply anywhere in Kerala, and our
      <a href="/blog/recycling-basics/">recycling basics</a> guide is a good
      starting point for finding a locally authorized option in the
      meantime.
    </p>
  </section>

  <section>
    <h2>Other areas</h2>
    <p>
      See the full <a href="/locations/">locations directory</a> for our
      core Kochi-metro service areas and other Kerala districts we check
      feasibility for.
    </p>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} heading="Malappuram Pickup FAQs" />

  <p class="updated">Last updated: {lastUpdated}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
</style>
