---
import IndexedLegacyGuide from "../../../../components/IndexedLegacyGuide.astro";
import { INDEXED_LOCATION_SERVICE_PAGES } from "../../../../data/gscIndexedGeneratedPages";

export function getStaticPaths() {
  return INDEXED_LOCATION_SERVICE_PAGES.map((page) => ({
    params: { location: page.locationSlug, service: page.serviceSlug },
    props: { page },
  }));
}

const { page } = Astro.props;

// GSC flagged this legacy generated URL as a Soft 404. The malformed
// location/service combination has a clear, semantically equivalent
// canonical location page, so consolidate it with a permanent redirect
// rather than leaving a thin generated page indexable.
if (
  page.locationSlug === "malappuram" &&
  page.serviceSlug === "network-equipment-disposal-kochi"
) {
  return Astro.redirect("/locations/malappuram/", 301);
}

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Locations", path: "/locations/" },
  { name: page.locationName ?? "Location", path: `/locations/${page.locationSlug}/` },
  { name: page.serviceName, path: page.path },
];
---

<IndexedLegacyGuide page={page} breadcrumbs={breadcrumbs} />
