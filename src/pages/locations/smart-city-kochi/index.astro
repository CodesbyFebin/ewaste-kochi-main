---
import LocationHub from "../../../components/LocationHub.astro";

const name = "Smart City Kochi";
const path = "/locations/smart-city-kochi/";
const title = "E-Waste Pickup for Smart City Kochi | IT Asset Collection";
const description =
  "E-waste pickup support for Smart City Kochi offices and nearby homes, including IT assets, servers, batteries and data-bearing devices.";
const context =
  "Smart City Kochi enquiries are often business or ITAD oriented. Share asset type, quantity, storage-device details and documentation needs before scheduling.";
---

<LocationHub name={name} path={path} title={title} description={description} context={context} />
