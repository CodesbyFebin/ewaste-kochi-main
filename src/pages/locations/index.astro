---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CtaBar from "../../components/CtaBar.astro";
import Faq from "../../components/Faq.astro";
import { SITE_URL } from "../../data/site";

const title = "E-Waste Pickup Locations in Kochi & Kerala | Ewaste Kochi";
const description =
  "Doorstep e-waste pickup areas across Kochi and Ernakulam district. Find your neighborhood and book a free pickup — contact us to check other Kerala districts.";
const lastUpdated = "2026-07-15";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Locations", path: "/locations/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/locations/`,
    name: title,
    description,
    dateModified: lastUpdated,
  },
];

const builtLocations = [
  { name: "Kakkanad", href: "/locations/kakkanad/" },
  { name: "Ernakulam South", href: "/locations/ernakulam-south/" },
  { name: "Kalamassery", href: "/locations/kalamassery/" },
  { name: "Edappally", href: "/locations/edappally/" },
  { name: "Infopark Kochi", href: "/locations/infopark-kochi/" },
  { name: "Kadavanthra", href: "/locations/kadavanthra/" },
  { name: "Aluva", href: "/locations/aluva/" },
  { name: "Angamaly", href: "/locations/angamaly/" },
  { name: "Palarivattom", href: "/locations/palarivattom/" },
  { name: "Fort Kochi", href: "/locations/fort-kochi/" },
  { name: "Thrikkakara", href: "/locations/thrikkakara/" },
  { name: "Thrippunithura", href: "/locations/thrippunithura/" },
  { name: "Kaloor", href: "/locations/kaloor/" },
  { name: "Smart City Kochi", href: "/locations/smart-city-kochi/" },
];

const otherServedAreas = [
  "Vyttila", "North Paravur", "Perumbavoor", "Maradu", "Kothamangalam",
  "Muvattupuzha", "Willingdon Island",
];

const feasibilityCheckAreas = [
  { name: "Kottayam", href: "/locations/kottayam/" },
  { name: "Kozhikode", href: "/locations/kozhikode/" },
  { name: "Palakkad", href: "/locations/palakkad/" },
  { name: "Kollam", href: "/locations/kollam/" },
  { name: "Thiruvananthapuram", href: "/locations/thiruvananthapuram/" },
  { name: "Kannur", href: "/locations/kannur/" },
  { name: "Thrissur", href: "/locations/thrissur/" },
  { name: "Malappuram", href: "/locations/malappuram/" },
];

const faqItems = [
  {
    q: "Do you cover areas outside Kochi city?",
    a: "We primarily support Kochi, Ernakulam, Kakkanad, Kalamassery, Ernakulam South, Aluva and nearby Kochi-metro enquiry areas. For other Kerala districts, contact us to check pickup feasibility rather than assuming coverage.",
  },
  {
    q: "What if my neighborhood isn't listed with its own page yet?",
    a: "We're still building out dedicated pages for every area we serve within the Kochi-metro area. If you don't see your neighborhood here, message us directly to confirm coverage rather than assuming either way.",
  },
  {
    q: "Is pickup free everywhere you serve?",
    a: "Doorstep pickup is free for qualifying quantities across our core service areas, whether or not that area has its own page yet. Feasibility still depends on item type, quantity, condition and location.",
  },
];
---

<Layout title={title} description={description} path="/locations/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Locations We Serve</h1>
  <p class="lede">
    We primarily support Kochi, Ernakulam, Kakkanad, Kalamassery, Ernakulam
    South, Aluva and nearby Kochi-metro enquiry areas. Below are the areas
    with a dedicated local page, plus other neighborhoods we currently
    serve. For other Kerala districts, contact us to check pickup
    feasibility rather than assuming coverage. Not sure if we cover your
    street? See
    <a href="/services/electronics-recycling-near-me/">electronics recycling
    near me</a> for how to check quickly.
  </p>

  <CtaBar whatsappMessage="Hi, I'd like to check if you cover my area for e-waste pickup." />

  <section>
    <h2>Areas with a dedicated page</h2>
    <div class="location-grid">
      {builtLocations.map((loc) => (
        <a class="location-card" href={loc.href}>{loc.name}</a>
      ))}
    </div>
  </section>

  <section>
    <h2>Also serving</h2>
    <p class="area-chips">
      {otherServedAreas.join(" · ")}
    </p>
    <p class="note">
      Dedicated pages for these areas are being added as part of the ongoing
      site rebuild. In the meantime, message us your address on WhatsApp and
      we'll confirm pickup availability directly.
    </p>
  </section>

  <section>
    <h2>Other Kerala districts — feasibility check, not guaranteed pickup</h2>
    <p class="note">
      These districts are outside our core Kochi-metro coverage, so we
      don't run scheduled doorstep routes there. We do check feasibility
      for individual enquiries — especially bulk or business volumes —
      rather than promising pickup upfront.
    </p>
    <div class="location-grid feasibility-grid">
      {feasibilityCheckAreas.map((loc) => (
        <a class="location-card feasibility-card" href={loc.href}>{loc.name}</a>
      ))}
    </div>
  </section>

  <Faq items={faqItems} />

  <p class="updated">Last updated: {lastUpdated}</p>
</Layout>

<style>
  .lede {
    font-size: 1.1rem;
    color: var(--color-muted);
    max-width: 46rem;
  }
  .location-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .location-card {
    display: block;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    text-decoration: none;
    color: var(--color-primary-dark);
    font-weight: 600;
    text-align: center;
  }
  .location-card:hover {
    border-color: var(--color-primary);
  }
  .area-chips {
    color: var(--color-muted);
    line-height: 2;
  }
  .feasibility-card {
    color: var(--color-muted);
    border-style: dashed;
    font-weight: 500;
  }
  .feasibility-card:hover {
    color: var(--color-primary-dark);
  }
  .note {
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .updated {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: 2rem;
  }
  @media (min-width: 700px) {
    .location-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
