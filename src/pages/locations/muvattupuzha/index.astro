---
import LocationHub from "../../../components/LocationHub.astro";

const name = "Muvattupuzha";
const path = "/locations/muvattupuzha/";
const title = "E-Waste Pickup in Muvattupuzha | Electronics Collection Check";
const description =
  "E-waste pickup feasibility checks for Muvattupuzha electronics, batteries, laptops and office IT assets. Contact first before assuming pickup.";
const context =
  "Muvattupuzha requests can include homes, shops, offices and institutional clearouts. Pickup feasibility depends on item type, quantity, condition and route availability.";
---

<LocationHub name={name} path={path} title={title} description={description} context={context} />
