---
import LocationHub from "../../../components/LocationHub.astro";

const name = "Fort Kochi";
const path = "/locations/fort-kochi/";
const title = "E-Waste Recycling in Fort Kochi | Pickup Feasibility Check";
const description =
  "E-waste recycling and pickup feasibility checks for Fort Kochi homes, shops and small offices. Send item details to confirm what can be collected.";
const context =
  "Fort Kochi enquiries can need extra scheduling checks because access, route timing and item volume vary by address. Ewaste Kochi confirms feasibility before pickup.";
---

<LocationHub name={name} path={path} title={title} description={description} context={context} />
