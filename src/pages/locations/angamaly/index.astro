---
import LocationHub from "../../../components/LocationHub.astro";

const name = "Angamaly";
const path = "/locations/angamaly/";
const title = "E-Waste Collection in Angamaly | Pickup Feasibility Check";
const description =
  "E-waste pickup support for Angamaly homes and businesses. Share item details, photos and location to check feasibility for electronics, batteries and IT assets.";
const context =
  "Angamaly enquiries often include airport-corridor homes, shops, small offices and bulk IT clearouts. Ewaste Kochi checks pickup feasibility case by case before confirming a slot.";
---

<LocationHub name={name} path={path} title={title} description={description} context={context} />
