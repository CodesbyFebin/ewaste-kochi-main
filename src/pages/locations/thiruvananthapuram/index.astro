---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "E-Waste Recycling in Thiruvananthapuram, Kerala | Pickup Feasibility Check";
const description =
  "Thiruvananthapuram isn't a standard doorstep pickup area for Ewaste Kochi, but we check feasibility for Thiruvananthapuram enquiries — bulk, business, and drop-off options. Contact us to find out what's possible.";
const lastUpdated = "2026-07-15";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Locations", path: "/locations/" },
  { name: "Thiruvananthapuram", path: "/locations/thiruvananthapuram/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "E-waste pickup feasibility check",
    provider: { "@id": `${SITE_URL}/#organization` },
    areaServed: { "@type": "Place", name: "Thiruvananthapuram, Kerala" },
    url: `${SITE_URL}/locations/thiruvananthapuram/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/locations/thiruvananthapuram/`,
    name: title,
    description,
    dateModified: lastUpdated,
  },
];

const faqItems = [
  {
    q: "Do you offer doorstep e-waste pickup in Thiruvananthapuram?",
    a: "Not as a standard, scheduled service — Thiruvananthapuram is well outside our core Kochi-metro coverage. We check feasibility for individual Thiruvananthapuram enquiries, particularly bulk or business volumes, rather than promising pickup upfront.",
  },
  {
    q: "What makes pickup feasible from Thiruvananthapuram?",
    a: "Mostly item volume, type, and exact location, weighed against the roughly 195 km distance from Kochi. A single device is a hard case; office IT clearances from Technopark-area businesses or government-adjacent institutions are more workable. Message us with details.",
  },
  {
    q: "Can Technopark or government-sector offices get pickup arranged?",
    a: "Sometimes — bulk volume changes the logistics math. If your Thiruvananthapuram office has a genuine IT asset clearance, contact us with an item list and we'll confirm feasibility rather than assume either way.",
  },
  {
    q: "Is there an extra cost given the distance?",
    a: "If a pickup is arranged, any additional logistics cost for the distance would be discussed and agreed upfront — never assumed or added after the fact.",
  },
  {
    q: "What should I do if pickup isn't feasible for my situation?",
    a: "See our recycling guide for general, responsible disposal guidance that applies wherever you are in Kerala, and check locally for authorized collection points in the capital region in the meantime.",
  },
  {
    q: "If you do collect from Thiruvananthapuram, are the same safety and data standards used?",
    a: "Yes — the same handling process, battery safety precautions, and data destruction standards apply regardless of location. Distance changes whether pickup is feasible, not how it's handled once collected.",
  },
];
---

<Layout title={title} description={description} path="/locations/thiruvananthapuram/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>E-Waste Recycling in Thiruvananthapuram</h1>
  <p class="lede">
    Ewaste Kochi is based in Ernakulam, and our standard free doorstep
    pickup covers Kochi, Ernakulam, Kakkanad, Kalamassery, Ernakulam South,
    Aluva and nearby Kochi-metro areas. Thiruvananthapuram is roughly 195
    km south — outside that core zone, so we don't run scheduled routes
    here. We do check feasibility for Thiruvananthapuram enquiries case by
    case, especially for bulk or business volumes.
  </p>

  <CtaBar whatsappMessage="Hi, I'm in Thiruvananthapuram and want to check if e-waste pickup is feasible for my situation." />

  <section>
    <h2>About Thiruvananthapuram</h2>
    <p>
      Thiruvananthapuram is Kerala's capital city, home to the state's
      administrative offices and the Technopark IT corridor — one of
      India's larger technology parks, with a significant concentration of
      office IT equipment turning over each year.
    </p>
  </section>

  <section>
    <h2>What's possible from Thiruvananthapuram</h2>
    <p>
      A single old phone or laptop usually doesn't justify a dedicated trip
      over this distance. Office IT decommissioning from Technopark-area
      companies, institutional battery lots, and other genuinely large
      volumes are a different calculation — message us with a rough item
      list and quantity so we can give an honest feasibility answer rather
      than a guess.
    </p>
  </section>

  <section>
    <h2>Compliance</h2>
    <p>
      If a pickup is arranged from Thiruvananthapuram, it follows the same
      documented environmental handling practices used across all our
      service areas. Documentation support may be available depending on
      the service type and agreed handling process — contact us via our
      <a href="/contact/">contact page</a> to confirm what's available.
    </p>
  </section>

  <section>
    <h2>Not feasible right now?</h2>
    <p>
      If a Thiruvananthapuram pickup doesn't work out for your specific
      case, our <a href="/recycling/">recycling guide</a> covers
      responsible disposal principles that apply anywhere in Kerala, and
      our <a href="/blog/recycling-basics/">recycling basics</a> guide is a
      good starting point for finding a locally authorized option in the
      meantime.
    </p>
  </section>

  <section>
    <h2>Other areas</h2>
    <p>
      See the full <a href="/locations/">locations directory</a> for our
      core Kochi-metro service areas and other Kerala districts we check
      feasibility for.
    </p>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} heading="Thiruvananthapuram Pickup FAQs" />

  <p class="updated">Last updated: {lastUpdated}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
</style>
