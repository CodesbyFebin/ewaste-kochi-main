---
import LocationHub from "../../../components/LocationHub.astro";

const name = "Perumbavoor";
const path = "/locations/perumbavoor/";
const title = "E-Waste Pickup in Perumbavoor | Electronics & Battery Check";
const description =
  "E-waste pickup support in Perumbavoor for electronics, batteries, computers and office IT assets. Pickup is confirmed only after feasibility review.";
