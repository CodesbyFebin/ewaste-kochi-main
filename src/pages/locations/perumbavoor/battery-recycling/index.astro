---
import Layout from "../../../../layouts/Layout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import CtaBar from "../../../../components/CtaBar.astro";
import Faq from "../../../../components/Faq.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../../data/site";

const title = "Battery Recycling in Perumbavoor | UPS, Inverter & Lithium Pickup";
const description =
  "Battery recycling collection for Perumbavoor households and businesses — UPS, inverter, lithium and power-tool batteries, checked for pickup feasibility before scheduling.";
const lastUpdated = "2026-07-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Locations", path: "/locations/" },
  { name: "Perumbavoor", path: "/locations/perumbavoor/" },
  { name: "Battery Recycling", path: "/locations/perumbavoor/battery-recycling/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Battery recycling",
    provider: { "@id": `${SITE_URL}/#organization` },
    areaServed: { "@type": "Place", name: "Perumbavoor, Kerala" },
    url: `${SITE_URL}/locations/perumbavoor/battery-recycling/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/locations/perumbavoor/battery-recycling/`,
    name: title,
    description,
    dateModified: lastUpdated,
  },
];

const faqItems = [
  {
    q: "Why would a Perumbavoor business have more batteries to recycle than a typical household?",
    a: "Perumbavoor's plywood and timber-processing units, along with other small manufacturing operations in the area, commonly run backup power and material-handling equipment on UPS or inverter batteries, which need periodic replacement. Household inverter batteries follow the same collection process.",
  },
  {
    q: "Do you collect both lead-acid and lithium batteries?",
    a: "Yes — inverter and UPS batteries (typically lead-acid) and lithium batteries from laptops, power tools, and small electronics are all accepted. Mention the type and rough quantity when you enquire.",
  },
  {
    q: "Is there a minimum quantity for a business battery pickup?",
    a: "No fixed minimum, but larger or recurring volumes are easier to justify a dedicated visit for — mention if this is a one-off or an ongoing need.",
  },
  {
    q: "How should batteries be stored before pickup?",
    a: "Keep terminals covered or taped, store away from heat, and separate damaged or swollen batteries from the rest. Flag any damaged units specifically when you book.",
  },
];
---

<Layout title={title} description={description} path="/locations/perumbavoor/battery-recycling/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Battery Recycling in Perumbavoor</h1>
  <p class="lede">
    Perumbavoor enquiries cover a mix of household and business volumes,
    and batteries — inverter, UPS, and lithium — are a regular part of
    that mix given the area's manufacturing and timber-processing
    activity. This page covers the battery side specifically. For general
    pickup context, see the <a href="/locations/perumbavoor/">Perumbavoor
    location page</a>; for the full service breakdown, see
    <a href="/battery-recycling/">battery recycling</a>.
  </p>

  <CtaBar whatsappMessage="Hi, I have batteries to recycle in Perumbavoor — can you check pickup feasibility?" />

  <section>
    <h2>Why this comes up often here</h2>
    <p>
      Small manufacturing and plywood-processing units in and around
      Perumbavoor commonly rely on backup power during outages, which means
      UPS and inverter batteries get replaced on a cycle. Households in the
      area follow the same general pattern with smaller inverter setups.
    </p>
  </section>

  <section>
    <h2>What's accepted</h2>
    <ul>
      <li>Inverter and UPS batteries (lead-acid)</li>
      <li>Laptop and power-tool lithium batteries</li>
      <li>Mobile phone and power bank batteries</li>
      <li>Damaged or swollen batteries — flagged separately for safe handling</li>
    </ul>
  </section>

  <section>
    <h2>Business volumes</h2>
    <p>
      For manufacturing units or workshops with a recurring battery
      replacement cycle, mention this when you first reach out — a
      repeatable pickup arrangement can be set up instead of booking each
      batch individually.
    </p>
  </section>

  <section>
    <h2>Compliance</h2>
    <p>
      Battery collection in Perumbavoor follows the same documented
      environmental handling practices used across all our service areas.
      Documentation support may be available depending on the service type
      and agreed handling process — confirm via our
      <a href="/contact/">contact page</a>.
    </p>
  </section>

  <section>
    <h2>Other areas</h2>
    <p>
      See the <a href="/locations/perumbavoor/">Perumbavoor location
      page</a> for general pickup context, or the full
      <a href="/locations/">locations directory</a> for everywhere else we
      serve.
    </p>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} heading="Perumbavoor Battery Recycling FAQs" />

  <p class="updated">Last updated: {lastUpdated}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
</style>
