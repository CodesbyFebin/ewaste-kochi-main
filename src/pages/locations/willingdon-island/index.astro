---
import LocationHub from "../../../components/LocationHub.astro";

const name = "Willingdon Island";
const path = "/locations/willingdon-island/";
const title = "E-Waste Pickup in Willingdon Island | Business IT Support";
const description =
  "E-waste pickup checks for Willingdon Island offices, facilities and nearby homes, including IT assets, batteries and data-bearing devices.";
const context =
  "Willingdon Island enquiries are often business or facility oriented. Share item lists, access details and documentation needs before pickup is confirmed.";
---

<LocationHub name={name} path={path} title={title} description={description} context={context} />
