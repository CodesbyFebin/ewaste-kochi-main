---
import Layout from "../../../../layouts/Layout.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import DirectAnswer from "../../../../components/DirectAnswer.astro";
import CtaBar from "../../../../components/CtaBar.astro";
import Faq from "../../../../components/Faq.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../../data/site";

const title = "Data Destruction for Willingdon Island Offices | Secure Drive Handling";
const description =
  "Data destruction planning for Willingdon Island offices, port-linked businesses and facilities — wiping, degaussing, shredding choices and documentation discussions.";
const lastUpdated = "2026-07-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Locations", path: "/locations/" },
  { name: "Willingdon Island", path: "/locations/willingdon-island/" },
  { name: "Data Destruction", path: "/locations/willingdon-island/data-destruction/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Data destruction",
    provider: { "@id": `${SITE_URL}/#organization` },
    areaServed: { "@type": "Place", name: "Willingdon Island, Kochi, Kerala" },
    url: `${SITE_URL}/locations/willingdon-island/data-destruction/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/locations/willingdon-island/data-destruction/`,
    name: title,
    description,
    dateModified: lastUpdated,
  },
];

const faqItems = [
  {
    q: "Why would a Willingdon Island office need dedicated data destruction rather than a standard pickup?",
    a: "Willingdon Island is home to port authority, shipping, and government-linked offices alongside corporate tenants — the kind of workplaces that regularly retire devices holding operational, logistics or administrative records. A standard pickup collects hardware; data destruction adds a verifiable step for what was on the drives before they leave the building.",
  },
  {
    q: "Can destruction happen on-site rather than off-site?",
    a: "See our data destruction service page for the specific methods available and how on-site versus off-site handling is decided — it depends on volume, device type and what the business needs to witness.",
  },
  {
    q: "Do you provide anything to confirm destruction happened?",
    a: "Documentation support may be available depending on the service type and agreed handling process. Confirm what your office needs before the collection date via our contact page.",
  },
  {
    q: "Is this only for large offices, or can a small facility on the island request it too?",
    a: "Any office with data-bearing devices to retire can request this — volume affects scheduling and logistics, not eligibility.",
  },
];
---

<Layout title={title} description={description} path="/locations/willingdon-island/data-destruction/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Data Destruction for Willingdon Island Offices</h1>
  <p class="lede">
    Willingdon Island enquiries are often business or facility oriented —
    the island is built around port, shipping and corporate tenants rather
    than dense residential streets. This page covers the data-security
    side of retiring office hardware there specifically. For general
    pickup context, see the
    <a href="/locations/willingdon-island/">Willingdon Island location
    page</a>; for the full service breakdown, see
    <a href="/data-destruction/">data destruction</a>.
  </p>

  <DirectAnswer>
    <p>{description}</p>
  </DirectAnswer>

  <CtaBar whatsappMessage="Hi, I need secure data destruction for our Willingdon Island office." />

  <section>
    <h2>Why this matters here specifically</h2>
    <p>
      Offices tied to port operations, logistics coordination or
      government-linked functions tend to hold operational and
      administrative records on retired laptops, desktops and servers.
      Deleting files or reformatting a drive doesn't guarantee the data is
      unrecoverable — a planned data destruction route reduces that risk.
    </p>
  </section>

  <section>
    <h2>Methods available</h2>
    <p>
      Overwriting, degaussing and physical shredding are all available
      depending on the device and what the business needs — see the full
      <a href="/data-destruction/">data destruction page</a> for how each
      method works and which devices they suit.
    </p>
  </section>

  <section>
    <h2>What to send before scheduling</h2>
    <ul>
      <li>A rough count of devices and drive types (HDD, SSD, mixed)</li>
      <li>Whether destruction needs to be witnessed on-site</li>
      <li>Access details for the facility</li>
      <li>Any documentation your office needs afterward</li>
    </ul>
  </section>

  <section>
    <h2>Compliance</h2>
    <p>
      Collection follows the same documented environmental handling
      practices used across all our service areas. Documentation support
      may be available depending on the service type and agreed handling
      process — confirm via our <a href="/contact/">contact page</a>.
    </p>
  </section>

  <section>
    <h2>Other areas</h2>
    <p>
      See the <a href="/locations/willingdon-island/">Willingdon Island
      location page</a> for general pickup context, or the full
      <a href="/locations/">locations directory</a> for everywhere else we
      serve.
    </p>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} heading="Willingdon Island Data Destruction FAQs" />

  <p class="updated">Last updated: <time datetime={lastUpdated}>{lastUpdated}</time></p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
</style>
