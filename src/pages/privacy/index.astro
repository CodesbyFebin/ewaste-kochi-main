---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { BUSINESS, SITE_URL } from "../../data/site";

const title = "Privacy Policy | Ewaste Kochi";
const description = "How Ewaste Kochi collects, uses, and protects information shared for pickups, quotes, and enquiries.";
const lastUpdated = "2026-07-07";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Privacy Policy", path: "/privacy/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/privacy/`,
    name: title,
    description,
    dateModified: lastUpdated,
  },
];
---

<Layout title={title} description={description} path="/privacy/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Privacy Policy</h1>
  <p class="updated">Last updated: {lastUpdated}</p>

  <section>
    <h2>What we collect</h2>
    <p>
      When you contact us via WhatsApp, phone, email, or a form on this site
      to request a pickup, quote, or information, we collect what you
      provide directly: your name, phone number, address or service area,
      and details about the devices involved (type, condition, quantity).
    </p>
  </section>

  <section>
    <h2>How we use it</h2>
    <p>
      This information is used to schedule pickups, provide quotes, issue
      recycling or data destruction certificates on request, and respond to
      your enquiries. We do not sell your personal information to third
      parties.
    </p>
  </section>

  <section>
    <h2>Sharing</h2>
    <p>
      We may share information with logistics or processing partners only
      as needed to complete a pickup, recycling, or data destruction service
      you've requested, and with regulatory bodies where required by law.
    </p>
  </section>

  <section>
    <h2>Data on devices you give us</h2>
    <p>
      For devices going through our <a href="/data-destruction/">data
      destruction</a> service, any data on the device is handled solely for
      the purpose of destruction and is not accessed, copied, or retained by
      us. See that page for method details.
    </p>
  </section>

  <section>
    <h2>Cookies</h2>
    <p>
      This site uses minimal cookies necessary for basic functionality. We
      do not use third-party advertising trackers.
    </p>
  </section>

  <section>
    <h2>Your choices</h2>
    <p>
      You can ask us to delete contact information we hold about you, or
      correct inaccurate details, by contacting us at
      {BUSINESS.email}.
    </p>
  </section>

  <section>
    <h2>Contact</h2>
    <p>
      Questions about this policy can be sent to {BUSINESS.email} or via our
      <a href="/contact/">contact page</a>.
    </p>
  </section>
</Layout>

<style>
  .updated { font-size: 0.8rem; color: var(--color-muted); margin-bottom: 2rem; }
</style>
