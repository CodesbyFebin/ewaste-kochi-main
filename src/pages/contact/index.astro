---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import DirectAnswer from "../../components/DirectAnswer.astro";
import CtaBar from "../../components/CtaBar.astro";
import LangSwitch from "../../components/LangSwitch.astro";
import { BUSINESS, SITE_URL, telLink } from "../../data/site";
import { getHreflang } from "../../data/routes";

const title = "Contact Ewaste Kochi | Book a Pickup or Ask a Question";
const description =
  "Reach Ewaste Kochi by phone, WhatsApp, or email. Address, business hours, and quick links to book a pickup or request a quote.";
const lastUpdated = "2026-07-07";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Contact", path: "/contact/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/contact/`,
    name: title,
    description,
    dateModified: lastUpdated,
  },
];
---

<Layout title={title} description={description} path="/contact/" jsonLd={jsonLd} hreflang={getHreflang("/contact/")}>
  <Breadcrumbs items={breadcrumbItems} />
  <LangSwitch current="en" otherPath="/ml/contact/" />
  <h1>Contact Us</h1>
  <p class="lede">
    WhatsApp is usually the fastest way to reach us — for pickups, quotes,
    and general questions alike.
  </p>

  <DirectAnswer>
    <p>{description}</p>
  </DirectAnswer>

  <CtaBar whatsappMessage="Hi, I'd like to get in touch." />

  <section class="contact-grid">
    <div>
      <h2>Details</h2>
      <p><strong>Phone / WhatsApp:</strong> <a href={telLink()}>{BUSINESS.phoneDisplay}</a></p>
      <p><strong>Email:</strong> <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a></p>
      <p><strong>Address:</strong> {BUSINESS.address.streetAddress}, {BUSINESS.address.addressLocality}, {BUSINESS.address.addressRegion} {BUSINESS.address.postalCode}</p>
      <p><strong>Hours:</strong> {BUSINESS.hoursDisplay}</p>
    </div>
    <div>
      <h2>What to include when you message us</h2>
      <ul>
        <li>What you have (device type, quantity)</li>
        <li>Your area in Kochi/Kerala</li>
        <li>Whether you want to recycle, sell, or need data destruction</li>
        <li>For businesses: rough asset count and timeline</li>
      </ul>
    </div>
  </section>

  <section>
    <h2>Find us on the map</h2>
    <p>
      We're based in Thrippunithura, Ernakulam — use the map below to check
      the location, or share your own address on WhatsApp and we'll confirm
      pickup feasibility from there.
    </p>
    <div class="map-embed">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d125744.63273804834!2d76.2447004890625!3d9.973853345731698!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3b0873e1e02e1053%3A0xc6baa7e9228b3049!2sKochi%20Secure%20E-Waste%20%26%20Certified%20ITAD%20-%20Data%20Destruction%20Solutions!5e0!3m2!1sen!2sin!4v1779116858396!5m2!1sen!2sin"
        width="100%"
        height="450"
        style="border:0"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title={`Google Map showing the ${BUSINESS.legalName} location`}
      ></iframe>
    </div>
  </section>

  <section>
    <h2>Documentation requests</h2>
    <p>
      If you need a recycling certificate, data destruction certificate, or
      other compliance documentation for your records, mention this when
      you contact us — documentation support may be available depending on
      the service type and agreed handling process.
    </p>
  </section>

  <p class="updated">Last updated: <time datetime={lastUpdated}>{lastUpdated}</time></p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .contact-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; margin: 1.5rem 0; }
  .contact-grid h2 { font-size: 1.1rem; }
  .contact-grid p { margin: 0.3rem 0; }
  .contact-grid ul { padding-left: 1.25rem; color: var(--color-muted); }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .map-embed {
    margin: 1rem 0 0;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    overflow: hidden;
  }
  .map-embed iframe { display: block; }
  @media (min-width: 700px) {
    .contact-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
