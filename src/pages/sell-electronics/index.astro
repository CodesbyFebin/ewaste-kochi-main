---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CtaBar from "../../components/CtaBar.astro";
import Faq from "../../components/Faq.astro";
import LangSwitch from "../../components/LangSwitch.astro";
import DirectAnswer from "../../components/DirectAnswer.astro";
import { BUSINESS, SITE_URL, telLink } from "../../data/site";
import { getHreflang } from "../../data/routes";

const title = "Sell Old Electronics in Kochi + Free Pan-India Ship-In";
const description =
  "Sell laptops, phones, tablets for cash. Kochi doorstep pickup — free. Pan-India ship-in — free, we cover Shiprocket. Photo-based quote, final price on inspection.";
const lastUpdated = "2026-08-11";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Sell Electronics", path: "/sell-electronics/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Electronics buyback",
    provider: { "@id": `${SITE_URL}/#organization` },
    areaServed: "Kochi, Ernakulam, Kerala",
    url: `${SITE_URL}/sell-electronics/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/sell-electronics/`,
    name: title,
    description,
    dateModified: lastUpdated,
  },
];

const conditionRows = [
  { tier: "Fully working", detail: "Powers on, functions normally, no major physical damage", value: "Highest quote tier" },
  { tier: "Partially working", detail: "Functions with an issue — cracked screen, weak battery, missing charger", value: "Still valued, at a reduced quote" },
  { tier: "Non-working / scrap", detail: "Doesn't power on or has major damage", value: "Valued for parts and material recovery rather than resale" },
];

const categories = [
  { title: "Computers", items: ["Laptops — working or non-working", "Desktop towers", "Monitors and peripherals"] },
  { title: "Mobile devices", items: ["Smartphones", "Tablets", "Smartwatches"] },
  { title: "Office & bulk", items: ["Multiple laptops from an upgrade", "Desktops and monitors as a batch", "Networking gear alongside a refresh"] },
];

const scenarios = [
  { title: "Upgrading to a new laptop", copy: "A strong resale candidate if it's in reasonable shape — worth checking value before defaulting to recycling." },
  { title: "A phone with a battery issue", copy: "Still worth a quote — mention the battery condition specifically, since it affects the number." },
  { title: "A dead laptop with its charger", copy: "Non-working devices can still have component or scrap value depending on the model." },
  { title: "Office device upgrade", copy: "A batch of laptops or desktops replaced at once — mention the count for a combined pickup and quote." },
];

const faqItems = [
  {
    q: "What determines how much I get for my device?",
    a: "Device type and model, age, working condition (screen, battery health, physical damage), and current demand for that model. We give a preliminary range over WhatsApp and confirm after inspection.",
  },
  {
    q: "Do you buy non-working devices too?",
    a: "Yes, at a scrap-value price rather than a working-device price — useful if a laptop or phone no longer powers on but you still want it out of the house responsibly.",
  },
  {
    q: "Is my data safe when I sell a device?",
    a: "We can wipe storage before resale on request, following the same process used in our data destruction service — ask for this explicitly when you schedule pickup.",
  },
  {
    q: "How fast is the process?",
    a: "Timing depends on your area, item details and current scheduling. Share complete photos and model details for the fastest realistic confirmation.",
  },
  {
    q: "Can businesses sell multiple devices at once?",
    a: "Yes — for bulk device sales as part of an office upgrade, message us with quantities and we'll arrange a single consolidated pickup and quote.",
  },
  {
    q: "Is the quote guaranteed before you see the device?",
    a: "No. What you get upfront is a preliminary range based on your description and photos — the confirmed quote depends on inspection at pickup.",
  },
  {
    q: "What accessories should I include?",
    a: "Original charger, box, and any accessories can help the quote, especially for recent laptops and phones. It's not required, but worth including if you still have them.",
  },
  {
    q: "Can I sell a device with a cracked screen?",
    a: "Yes — physical damage is factored into the quote rather than disqualifying the device. Mention it upfront for a more accurate preliminary estimate.",
  },
  {
    q: "What if I don't like the quote after inspection?",
    a: "You're not obligated to accept it. You can choose to recycle the item instead — see our recycling page — which is always an option regardless of resale value.",
  },
  {
    q: "How is payment arranged?",
    a: "Payment is arranged once you accept the confirmed quote at pickup — ask about the specific method (UPI, bank transfer) when you book so there are no surprises on the day.",
  },
];
---

<Layout title={title} description={description} path="/sell-electronics/" jsonLd={jsonLd} hreflang={getHreflang("/sell-electronics/")}>
  <Breadcrumbs items={breadcrumbItems} />
  <LangSwitch current="en" otherPath="/ml/sell-electronics/" />
  <h1>Sell Your Old Electronics in Kochi</h1>
  <p class="lede">
    If you have a laptop, phone, or computer you'd rather sell than let sit
    unused, we give a preliminary estimate and confirm the quote after
    inspection at doorstep pickup — whether the device is fully working,
    partially working, or scrap. Not
    sure whether to <a href="/recycling/">donate, sell or recycle old
    electronics</a>? This page covers selling specifically — the linked
    guide covers the other options.
  </p>

  <DirectAnswer>
    <p>
      Send model, age, working condition, battery status and photos for an
      indicative quote. Final value is confirmed after inspection, so there is
      no best-price, instant-cash or guaranteed quote before pickup.
    </p>
  </DirectAnswer>

  <CtaBar whatsappMessage="Hi, I'd like to sell an old device — please give me a quote." />

  <ul class="key-takeaways">
    <li>Quote is condition-based and confirmed after inspection, never guaranteed upfront.</li>
    <li>Non-working devices can still have scrap or component value — worth asking rather than assuming zero.</li>
    <li>Photos and complete details get a more accurate preliminary estimate.</li>
    <li>Data can be wiped before resale on request.</li>
  </ul>

  <section>
    <h2>What affects your quote</h2>
    <ul class="check-list">
      <li>Device type and model (newer, higher-spec models generally fetch more)</li>
      <li>Working condition — does it power on, hold charge, and function normally?</li>
      <li>Physical condition — screen, body, ports, and accessories included</li>
      <li>Battery health, especially for laptops and phones</li>
      <li>Current market demand for that specific model</li>
    </ul>
    <p>
      Be upfront about condition when you message us — it gets you a more
      accurate preliminary quote and avoids surprises at pickup.
    </p>
  </section>

  <section>
    <h2>Condition guide</h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Condition</th>
            <th scope="col">What it means</th>
            <th scope="col">What to expect</th>
          </tr>
        </thead>
        <tbody>
          {conditionRows.map((row) => (
            <tr>
              <td><strong>{row.tier}</strong></td>
              <td>{row.detail}</td>
              <td>{row.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>What we buy</h2>
    <div class="item-grid">
      {categories.map((cat) => (
        <div class="item-card">
          <h3>{cat.title}</h3>
          <ul class="check-list">
            {cat.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>How it works</h2>
    <ol class="process-list">
      <li><strong>Message us</strong> with device details and condition over WhatsApp or phone.</li>
      <li><strong>Get a preliminary quote</strong> based on your description.</li>
      <li><strong>Schedule doorstep pickup</strong> at a convenient time.</li>
      <li><strong>Quick condition check</strong> and final quote confirmed on the spot.</li>
      <li><strong>Payment</strong> arranged once you accept — ask about the specific arrangement when you book.</li>
    </ol>
  </section>

  <section>
    <h2>Who this is for</h2>
    <p>
      Individuals upgrading a personal device, and small offices clearing out
      a handful of old laptops or phones. For larger bulk sales as part of an
      IT asset refresh, or if you need data destruction certificates and
      inventory documentation, see our <a href="/itad/">ITAD service</a>
      instead. For a look at what drives pricing, see
      <a href="/e-waste-scrap-prices-kochi/">e-waste scrap prices</a>, and
      for bulk computer or office IT lots specifically, see
      <a href="/computer-scrap-buyers-kochi/">computer scrap buyers</a>.
    </p>
  </section>

  <section>
    <h2>Common selling scenarios</h2>
    <div class="scenario-grid">
      {scenarios.map((s) => (
        <div class="scenario-card">
          <h3>{s.title}</h3>
          <p>{s.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>Data safety</h2>
    <p>
      On request, we wipe storage on any device before resale using the same
      process described on our <a href="/data-destruction/">data
      destruction</a> page — worth asking for explicitly if the device held
      personal accounts, photos, or documents.
    </p>
  </section>

  <section>
    <h2>Mistakes to avoid</h2>
    <ul class="check-list">
      <li>Assuming a preliminary quote is final before the device is actually inspected</li>
      <li>Handing over a device without backing up or wiping personal data first</li>
      <li>Describing condition vaguely — specific detail gets a more accurate estimate</li>
      <li>Assuming a non-working device has zero value without asking</li>
    </ul>
  </section>

  <section>
    <h2>Selling a laptop specifically?</h2>
    <p>
      See our guide: <a href="/blog/sell-old-laptop-kochi/">Sell Old Laptop
      in Kochi — condition checklist and quote guide</a>, covering what to
      check before you sell and what actually drives the price, or
      <a href="/blog/how-to-sell-old-electronics-kochi/">how to sell old
      electronics in Kochi</a> for the full step-by-step process.
    </p>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <section class="final-cta">
    <h2>Ready to Sell Your Old Electronics?</h2>
    <p>Share your item photos and details on WhatsApp for a condition-based quote.</p>
    <CtaBar whatsappMessage="Hi, I'd like to sell an old device — please give me a quote." compact />
  </section>

  <p class="updated">Last updated: <time datetime={lastUpdated}>{lastUpdated}</time></p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  .process-list, .check-list { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1.25rem; color: var(--color-muted); }
  .table-scroll { overflow-x: auto; margin-top: 1rem; border: 1px solid var(--color-border); border-radius: 0.5rem; }
  table { border-collapse: collapse; width: 100%; min-width: 560px; font-size: 0.9rem; }
  th, td { text-align: left; padding: 0.6rem 0.85rem; border-bottom: 1px solid var(--color-border); vertical-align: top; }
  th { background: var(--color-bg); font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--color-muted); font-weight: 800; }
  tbody tr:last-child td { border-bottom: none; }
  .item-grid { display: grid; grid-template-columns: 1fr; gap: 0.9rem; margin-top: 1rem; }
  .item-card { padding: 1rem 1.1rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-surface); }
  .item-card h3 { margin: 0 0 0.5rem; font-size: 1rem; color: var(--color-primary); }
  .item-card ul { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.35rem; font-size: 0.92rem; }
  .scenario-grid { display: grid; grid-template-columns: 1fr; gap: 0.9rem; margin-top: 1rem; }
  .scenario-card { padding: 1rem 1.1rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-surface); }
  .scenario-card h3 { margin: 0 0 0.4rem; font-size: 0.98rem; }
  .scenario-card p { margin: 0; color: var(--color-muted); font-size: 0.9rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.75rem 1.25rem; border-radius: 0.75rem; text-align: center; background: linear-gradient(135deg, var(--color-surface), var(--color-bg)); border: 1px solid var(--color-border); margin: 2.5rem 0; }
  .final-cta p { margin: 0.5rem 0 0; color: var(--color-muted); }
  @media (min-width: 640px) {
    .item-grid { grid-template-columns: repeat(3, 1fr); }
    .scenario-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
