---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CtaBar from "../../components/CtaBar.astro";
import Faq from "../../components/Faq.astro";
import { BUSINESS, SITE_URL, telLink } from "../../data/site";

const title = "Sell Old Electronics in Kochi | Best Quote + Free Pickup";
const description =
  "List your used laptop, phone, or IT equipment for an instant quote, or browse inspected refurbished devices. Doorstep pickup and payment across Kochi.";
const lastUpdated = "2026-07-07";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Marketplace", path: "/marketplace/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Used electronics marketplace",
    provider: { "@id": `${SITE_URL}/#organization` },
    areaServed: "Kochi, Ernakulam, Kerala",
    url: `${SITE_URL}/marketplace/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/marketplace/`,
    name: title,
    description,
    dateModified: lastUpdated,
  },
];

const faqItems = [
  {
    q: "What's the difference between Marketplace and Sell Electronics?",
    a: "Marketplace is our two-sided platform — it covers both listing your device for sale and the inspected devices we have available. Sell Electronics is the dedicated flow if you specifically want to sell and get paid, with valuation guidance for common device conditions.",
  },
  {
    q: "How is my device valued?",
    a: "Valuation depends on device type, age, working condition, and current market demand. We give a preliminary estimate over WhatsApp based on your description, then confirm the final quote at pickup after a quick inspection.",
  },
  {
    q: "How do I get paid?",
    a: "Payment is made at the time of doorstep pickup once the device condition is confirmed, typically via UPI or cash.",
  },
  {
    q: "What if the device turns out to be in worse condition than described?",
    a: "Our team will let you know the revised quote on the spot before finalizing anything — you're not obligated to proceed if the adjusted price doesn't work for you.",
  },
  {
    q: "Can I sell non-working devices too?",
    a: "Non-working devices are usually better suited to our recycling or sell-electronics scrap valuation rather than the marketplace, since marketplace listings are for functional resale. Ask us and we'll point you to the right option.",
  },
];
---

<Layout title={title} description={description} path="/marketplace/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Marketplace</h1>
  <p class="lede">
    Our marketplace is where working electronics change hands in Kochi —
    list your own device for an instant quote and doorstep payment, or ask us
    about currently available inspected refurbished units.
  </p>

  <CtaBar whatsappMessage="Hi, I'd like to list a device on the marketplace." />

  <section>
    <h2>What you can do here</h2>
    <p>
      Sell a working or partially working laptop, phone, or IT accessory for
      cash with doorstep pickup and payment. If you're specifically looking
      to sell rather than browse, our <a href="/sell-electronics/">Sell
      Electronics</a> page has device-condition and valuation guidance built
      for that flow.
    </p>
  </section>

  <section>
    <h2>How listing and selling works</h2>
    <ol class="process-list">
      <li><strong>Tell us about your device</strong> — type, age, and condition — over WhatsApp.</li>
      <li><strong>Get a preliminary quote</strong> based on your description.</li>
      <li><strong>Schedule doorstep pickup</strong> at a convenient time.</li>
      <li><strong>Quick inspection and final quote</strong> confirmed on the spot.</li>
      <li><strong>Instant payment</strong> once you accept the final quote.</li>
    </ol>
  </section>

  <section>
    <h2>Who this is for</h2>
    <p>
      Anyone upgrading a working laptop or phone and wanting a fair cash
      return instead of letting it sit unused, plus offices looking to
      liquidate functional equipment after an upgrade cycle. For bulk
      corporate resale as part of an asset refresh, see <a href="/itad/">ITAD</a>
      for the fuller process including data destruction and reporting. See
      <a href="/e-waste-scrap-prices-kochi/">e-waste scrap prices</a> for
      what drives valuation, and <a href="/computer-scrap-buyers-kochi/">
      computer scrap buyers</a> for bulk office IT lots.
    </p>
  </section>

  <section>
    <h2>Compliance and data safety</h2>
    <p>
      Any device with storage is checked and, on request, wiped before resale
      to make sure your personal data doesn't travel with the device. See
      our <a href="/data-destruction/">data destruction</a> page for details
      on wiping standards.
    </p>
  </section>

  <section>
    <h2>Coverage</h2>
    <p>
      Marketplace pickup and payment is available across Kochi and Ernakulam
      district. Check the <a href="/locations/">locations directory</a> or
      just message us your area.
    </p>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <p class="updated">Last updated: {lastUpdated}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .process-list { display: flex; flex-direction: column; gap: 0.6rem; padding-left: 1.25rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
</style>
