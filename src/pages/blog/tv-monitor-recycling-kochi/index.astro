---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DirectAnswer from "../../../components/DirectAnswer.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import LongformExpansion from "../../../components/LongformExpansion.astro";
import Sources from "../../../components/Sources.astro";
import { BUSINESS, SITE_URL } from "../../../data/site";

const title = "TV & Monitor Recycling in Kochi";
const description = "How to recycle CRT and flat-panel TVs and monitors in Kochi, including hazardous components.";
const lastUpdated = "2026-08-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Devices & Materials", path: "/blog/devices-materials/" },
  { name: "TV & Monitor Recycling", path: "/blog/tv-monitor-recycling-kochi/" }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": "2026-08-18",
    "dateModified": lastUpdated,
    "author": { "@type": "Organization", name: BUSINESS.legalName },
    "publisher": { "@id": `${SITE_URL}/#organization` },
    "mainEntityOfPage": `${SITE_URL}/blog/tv-monitor-recycling-kochi/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/tv-monitor-recycling-kochi/`,
    "name": title,
    "description": description,
    "dateModified": lastUpdated,
  }
];

const faqItems = [
  {
    q: "Are TVs hazardous?",
    a: "Yes — leaded glass and mercury backlights need certified handling."
  },
  {
    q: "Should I remove the stand?",
    a: "Yes, and unplug cables before pickup."
  },
  {
    q: "CRT vs LCD handling?",
    a: "Both regulated; CRT is heavier and more hazardous."
  },
  {
    q: "How is pickup confirmed?",
    a: "After you send model and condition details."
  }
];

const sourceItems = [
  {
    title: "E-Waste Management Rules and related regulatory resources",
    href: "https://cpcb.nic.in/rules-6/",
    publisher: "Central Pollution Control Board",
    note: "Official CPCB resource page for e-waste rules and updates."
  },
  {
    title: "EPR E-Waste portal",
    href: "https://eprewastecpcb.in/",
    publisher: "Central Pollution Control Board",
    note: "Official portal for e-waste EPR registration and compliance workflows."
  },
  {
    title: "Kerala State Pollution Control Board",
    href: "https://kspcb.kerala.gov.in/",
    publisher: "Kerala State Pollution Control Board",
    note: "Regional enforcement and authorization for e-waste recyclers in Kerala."
  }
];
---

<Layout title={title} description={description} path="/blog/tv-monitor-recycling-kochi/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />

  <h1>TV & Monitor Recycling</h1>

  <DirectAnswer>
    <p>TVs and monitors need careful recycling because of leaded glass and mercury backlights. In Kochi, keep screens intact, separate stands and cables, and arrange authorised pickup with photos.</p>
  </DirectAnswer>

  <CtaBar whatsappMessage="Hi, I have an old TV or monitor to recycle in Kochi." />

  <section id="section-1">
    <h2>Why screens are sensitive</h2>
    <p>CRT glass contains lead; LCD backlights contain mercury.</p>
    <p>Both need certified processing, not general disposal.</p>
  </section>
  <section id="section-2">
    <h2>Prepare the unit</h2>
    <p>Keep the screen intact, remove the stand and unplug cables.</p>
    <p>Photos help the team plan safe handling and transport.</p>
  </section>
  <section id="section-3">
    <h2>CRT vs flat-panel</h2>
    <p>Older CRTs are heavier and hazardous; flat panels are lighter but still regulated.</p>
    <p>The handling route reflects the screen type.</p>
  </section>
  <section id="section-4">
    <h2>Pickup confirmation</h2>
    <p>Send model and condition details so the team matches the route.</p>
    <p>Large or damaged screens may need special loading.</p>
  </section>

  <RelatedContent>
    <h2>Explore more guides</h2>
    <ul>
      <li><a href="/blog/devices-materials/">Devices & Materials hub</a></li>
      <li><a href="/blog/general-ewaste/">General e-waste basics</a></li>
      <li><a href="/recycling/">Recycling service</a></li>
      <li><a href="/pickup/">Book a pickup</a></li>
    </ul>
  </RelatedContent>

  <LongformExpansion
    label="Expanded field guide"
    audience="households and businesses in Kochi"
    localIntent="tv & monitor recycling with authorised pickup"
    items={["old electronics", "batteries", "cables", "data devices"]}
    themes={["Preparation", "Safety", "Compliance", "Recovery"]}
  />

  <section id="faq-section">
    <h2>Frequently asked questions</h2>
    <Faq items={faqItems} heading="TV & Monitor Recycling FAQs" />
  </section>

  <Sources items={sourceItems} heading="Official sources & regulatory references" />
</Layout>

<style>
  .blog-hub { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; }
  .blog-hub h1 { font-size: 2.5rem; margin-bottom: 1rem; color: var(--color-primary); text-align: center; }
  .blog-hub section { margin-bottom: 3rem; padding: 2rem; background: var(--color-bg); border-radius: 0.75rem; border: 1px solid var(--color-border); }
  .blog-hub h2 { color: var(--color-primary); margin-bottom: 1.5rem; font-size: 1.8rem; }
  .blog-hub ul { margin-bottom: 1rem; padding-left: 1.5rem; }
  .blog-hub li { margin-bottom: 0.5rem; line-height: 1.6; }
  @media (max-width: 768px) {
    .blog-hub h1 { font-size: 2rem; }
    .blog-hub section { padding: 1.5rem; }
    .blog-hub h2 { font-size: 1.5rem; }
  }
</style>
