---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "TV Cable and AV Wire Disposal";
const description = "TV Cable and AV Wire Disposal — practical guidance for Kochi households and businesses, covering cable recycling, charger recycling, copper wire scrap.";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "TV Cable and AV Wire Disposal", path: "/blog/tv-cable-and-av-wire-disposal/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/tv-cable-and-av-wire-disposal/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/tv-cable-and-av-wire-disposal/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "What affects cable quote?", a: "Quantity and copper content mainly — condition matters less than for other electronics." },
  { q: "Can offices request cable pickup?", a: "Yes, especially useful after an office move or network upgrade." },
  { q: "Is pickup available in Kochi?", a: "For tv cable and av wire disposal: Ewaste Kochi primarily supports Kochi, Ernakulam, Kakkanad, Kalamassery, Ernakulam South, Aluva and nearby Kochi-metro enquiry areas. For other Kerala districts, contact us to check pickup feasibility." },
  { q: "Are network cables accepted?", a: "Yes, ethernet and other network cables are accepted." },
];
---

<Layout title={title} description={description} path="/blog/tv-cable-and-av-wire-disposal/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>TV Cable and AV Wire Disposal</h1>
  <p class="lede">Here's what you need to know, in plain terms. An accumulated tangle of network cables, power cords and adapters from an office move or upgrade is a common single pickup — a rough quantity estimate is enough.</p>

  <CtaBar whatsappMessage="Hi, I have a question about tv cable and av wire disposal." />

  <ul class="key-takeaways">
    <li>Old cables shouldn't go in household waste any more than larger electronics.</li>
    <li>No need to sort cables by type before pickup — general grouping is enough.</li>
    <li>Copper content gives cables modest scrap value, more so in bulk.</li>
  </ul>

  <section>
    <h2>Bulk cable pickup for offices</h2>
    <p>An accumulated tangle of network cables, power cords and adapters from an office move or upgrade is a common single pickup — a rough quantity estimate is enough.</p>
  </section>

  <section>
    <h2>Do cables have value?</h2>
    <p>Cables and wire carry modest scrap value, mainly from copper content — more noticeable in bulk quantities than for a handful of chargers.</p>
  </section>

  <section>
    <h2>Chargers and adapters</h2>
    <p>Old chargers and adapters, even without a matching device, are accepted as standard e-waste — no need to find their original device first.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/recycling/">E-Waste Recycling</a>
      <a href="/e-waste-scrap-prices-kochi/">Scrap Price Guide</a>
      <a href="/pickup/">Pickup</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/tv-cable-and-av-wire-disposal/" />

  <section class="final-cta">
    <h2>Have Questions About TV Cable and AV Wire Disposal?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about tv cable and av wire disposal." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
