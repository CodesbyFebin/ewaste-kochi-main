---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "What to Do with Unsellable Electronics";
const description = "What to Do with Unsellable Electronics — practical guidance for Kochi households and businesses, covering sell old electronics Kochi, sell old laptop Kochi, scrap...";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "What to Do with Unsellable Electronics", path: "/blog/what-to-do-with-unsellable-electronics/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/what-to-do-with-unsellable-electronics/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/what-to-do-with-unsellable-electronics/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "Can I sell old electronics in Kochi?", a: "For what to do with unsellable electronics: yes. Message the device type, condition and photos on WhatsApp for a preliminary quote, then arrange doorstep pickup and payment if you accept it." },
  { q: "Can offices sell bulk electronics?", a: "For what to do with unsellable electronics: yes, message the full list with quantities for a consolidated quote." },
  { q: "What electronics may have resale value?", a: "For what to do with unsellable electronics: laptops, phones, tablets and some desktop components most commonly have resale value, but it depends on condition and demand — ask about any specific device." },
  { q: "What is condition-based value?", a: "For what to do with unsellable electronics: it means the quote reflects the device's actual working status, physical condition and completeness rather than a flat rate by model alone." },
];
---

<Layout title={title} description={description} path="/blog/what-to-do-with-unsellable-electronics/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>What to Do with Unsellable Electronics</h1>
  <p class="lede">Here's what you need to know, in plain terms. A device that doesn't power on isn't automatically worthless — component and scrap value can still apply.</p>

  <CtaBar whatsappMessage="Hi, I have a question about what to do with unsellable electronics." />

  <ul class="key-takeaways">
    <li>You can always choose recycling instead if the quote doesn't work for you.</li>
    <li>Wipe your data before handover, or ask about data destruction support.</li>
    <li>Quotes are condition-based, confirmed after inspection, not fixed in advance.</li>
  </ul>

  <section>
    <h2>Broken devices still have value</h2>
    <p>For what to do with unsellable electronics, a device that doesn't power on isn't automatically worthless — component and scrap value can still apply. Describe the condition honestly rather than assuming it disqualifies the item.</p>
  </section>

  <section>
    <h2>Selling in bulk</h2>
    <p>For what to do with unsellable electronics, clearing out multiple devices from an office upgrade is common — share the full list with quantities for a consolidated quote rather than handling items one at a time.</p>
  </section>

  <section>
    <h2>Data comes first</h2>
    <p>For what to do with unsellable electronics, before selling any device with storage, back up what you want to keep and either wipe it yourself or ask about data destruction support. This applies to laptops, phones and tablets alike, working or not.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/sell-electronics/">Sell Electronics</a>
      <a href="/e-waste-scrap-prices-kochi/">Scrap Price Guide</a>
      <a href="/marketplace/">Marketplace</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/what-to-do-with-unsellable-electronics/" />

  <section class="final-cta">
    <h2>Have Questions About What to Do with Unsellable Electronics?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about what to do with unsellable electronics." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
