---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Why Photos Help Confirm E-Waste Pickup Faster in Kochi";
const description =
  "Why sending photos before an e-waste pickup in Kochi speeds up confirmation — what photos to send, what they help confirm, and how to take useful shots quickly.";
const datePublished = "2026-07-08";
const dateModified = "2026-07-08";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Why Photos Help Confirm Pickup Faster", path: "/blog/photos-for-pickup-confirmation/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/photos-for-pickup-confirmation/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/photos-for-pickup-confirmation/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  {
    q: "Is a photo required before every pickup?",
    a: "Not required for standard household items, but it helps for anything damaged, bulky, or battery-related.",
  },
  {
    q: "What if I can't send photos?",
    a: "Describe items as clearly as possible — type, condition, approximate size, and any issues. We'll confirm based on your description.",
  },
  {
    q: "What should a battery photo show?",
    a: "Show the battery itself from the side and front — especially if it looks swollen, is leaking, or has visible damage.",
  },
];
---

<Layout title={title} description={description} path="/blog/photos-for-pickup-confirmation/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Why Photos Help Confirm Pickup Faster</h1>
  <p class="lede">
    Sending a few photos before booking doesn't just help us — it gets
    you a faster answer on whether pickup is possible and what to expect.
    Here's what's worth photographing and why.
  </p>

  <CtaBar whatsappMessage="Hi, I'd like to send photos of my e-waste before booking pickup." />

  <div class="quick-answer">
    <p class="quick-answer-label">Quick answer</p>
    <p>
      Photos aren't required for standard household items, but they
      speed up confirmation for batteries, damaged electronics, large
      or heavy items, and anything unusual — a clear front-and-side
      shot avoids surprises on pickup day.
    </p>
  </div>

  <ul class="key-takeaways">
    <li>Batteries, damage and bulky items benefit most from a photo upfront.</li>
    <li>A written description is enough for standard phones, cables and small electronics.</li>
    <li>Model labels in photos help with quotes for servers and valuable laptops.</li>
  </ul>

  <section>
    <h2>What photos help us confirm</h2>
    <ul class="check-list">
      <li>Whether an item is accepted (unusual or borderline items)</li>
      <li>Whether damage affects pickup feasibility</li>
      <li>Whether a battery is safe to handle in standard collection</li>
      <li>Approximate quote for scrap or resale value</li>
      <li>Whether special handling or equipment is needed</li>
    </ul>
  </section>

  <section>
    <h2>Items where photos matter most</h2>
    <ul class="check-list">
      <li><strong>Batteries:</strong> Show any swelling, leakage, or visible damage</li>
      <li><strong>Damaged electronics:</strong> Cracked screens, broken casings, water damage</li>
      <li><strong>Large or heavy items:</strong> Old CRT TVs, server racks, large UPS units</li>
      <li><strong>Servers and networking gear:</strong> Model labels help with quote and handling</li>
      <li><strong>Unknown items:</strong> Anything you're not sure about — photo clears it up fast</li>
    </ul>
  </section>

  <section>
    <h2>For standard household items, photos are optional</h2>
    <p>
      A pile of old phones, cables, and a non-working laptop doesn't need
      photos upfront. A written description — type, rough quantity,
      condition — is enough for standard household pickups.
    </p>
  </section>

  <section>
    <h2>How to take useful photos</h2>
    <ul class="check-list">
      <li>Clear, in focus, with reasonable lighting</li>
      <li>Front and side views for batteries and damaged items</li>
      <li>Model label visible for servers, networking gear, and laptops with value</li>
      <li>If possible, show the whole pile for bulk pickups — helps with scheduling</li>
    </ul>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/pickup/">Book Pickup</a>
      <a href="/battery-recycling/">Battery Recycling</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/photos-for-pickup-confirmation/" />
  <section class="final-cta">
    <h2>Ready to Send Photos and Book Pickup?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I'd like to send photos of my e-waste before booking pickup." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .check-list { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1.25rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .quick-answer { padding: 1.1rem 1.25rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-surface); margin: 1.5rem 0; }
  .quick-answer-label { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary); }
  .quick-answer p:last-child { margin: 0; color: var(--color-text); }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
