---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "E-Waste Pickup in Kakkanad | Kochi Electronics Collection";
const description =
  "E-waste pickup and recycling services in Kakkanad, Kochi. How to book electronics collection near Infopark, apartments and offices in Kakkanad.";
const datePublished = "2026-07-08";
const dateModified = "2026-07-08";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "E-Waste Pickup in Kakkanad", path: "/blog/ewaste-pickup-kakkanad/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/ewaste-pickup-kakkanad/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/ewaste-pickup-kakkanad/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  {
    q: "Is e-waste pickup available in Kakkanad?",
    a: "We serve Kakkanad and nearby areas within Kochi-metro. Contact us with your location and item details, and we will confirm pickup feasibility.",
  },
  {
    q: "Can I book pickup near Infopark Kakkanad?",
    a: "Yes. Offices and tech parks near Infopark, SEZ and other Kakkanad business areas can request e-waste collection. Send us the item list and location.",
  },
  {
    q: "Do you pick up from apartments in Kakkanad?",
    a: "Yes. Apartments, villas and flats in Kakkanad can request pickup. Include your building name and floor details when contacting us.",
  },
  {
    q: "What items can I include from Kakkanad?",
    a: "Old laptops, computers, monitors, printers, UPS batteries, cables, mobile phones and other electronics. Send a list and we will confirm.",
  },
  {
    q: "How do I check if my Kakkanad location is serviceable?",
    a: "Message us on WhatsApp with your address or area name within Kakkanad, and we will let you know if pickup is possible.",
  },
];
---

<Layout title={title} description={description} path="/blog/ewaste-pickup-kakkanad/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>E-Waste Pickup in Kakkanad</h1>
  <p class="lede">
    Kakkanad is a key area for e-waste collection in Kochi, with many
    offices, tech parks and residential communities. Here is how to
    book an electronics pickup in Kakkanad.
  </p>

  <CtaBar whatsappMessage="Hi, I need an e-waste pickup in Kakkanad." />

  <div class="quick-answer">
    <p class="quick-answer-label">Quick answer</p>
    <p>
      Yes — Kakkanad is a key service area, with a dedicated
      <a href="/locations/kakkanad/">location page</a> covering Infopark,
      SEZ and residential zones. Message your location, a rough item
      list and preferred timeframe on WhatsApp to confirm pickup.
    </p>
  </div>

  <ul class="key-takeaways">
    <li>Kakkanad has a dedicated location page with full service details.</li>
    <li>Infopark and SEZ offices, plus residential apartments and villas, are all covered.</li>
    <li>An item list prepared in advance speeds up office pickups.</li>
  </ul>

  <section>
    <h2>Service availability in Kakkanad</h2>
    <p>
      For pickups in Kakkanad, Ewaste Kochi primarily serves Kochi, Ernakulam, Kakkanad, Kalamassery,
      Ernakulam South, Aluva and nearby Kochi-metro enquiry areas. For other
      Kerala districts, contact us to check pickup feasibility.
    </p>
    <p>
      Kakkanad is one of our key service areas. Whether you are near
      Infopark, SEZ, or in a residential apartment complex, reach out
      with your location and item details for confirmation.
    </p>
  </section>

  <section>
    <h2>Common pickup locations in Kakkanad</h2>
    <ul>
      <li>Infopark and SEZ areas — IT offices and tech parks</li>
      <li>Kakkanad residential apartments and villas</li>
      <li>Small businesses and shops in Kakkanad</li>
      <li>Co-working spaces and shared offices</li>
      <li>Educational institutions near Kakkanad</li>
    </ul>
  </section>

  <section>
    <h2>What to include in your pickup request</h2>
    <ul class="check-list">
      <li>Your specific location within Kakkanad (area name, landmark or map location)</li>
      <li>Rough list of items (type and quantity)</li>
      <li>Photos of large or battery-containing items</li>
      <li>Preferred pickup date or timeframe</li>
      <li>Any access instructions (apartment floor, office reception, etc.)</li>
    </ul>
  </section>

  <section>
    <h2>Pickup considerations for Kakkanad</h2>
    <p>
      For office pickups near Infopark, we recommend preparing an item
      list in advance. For apartment pickups, confirm building access
      and floor details when you message us. Large items like old UPS
      batteries or CRT monitors should be flagged beforehand.
    </p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/locations/kakkanad/">Kakkanad Location</a>
      <a href="/itad/">ITAD for Business</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/ewaste-pickup-kakkanad/" />
  <section class="final-cta">
    <h2>Have Questions About E-Waste Pickup in Kakkanad?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I need an e-waste pickup in Kakkanad." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .check-list { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1.25rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .quick-answer { padding: 1.1rem 1.25rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-surface); margin: 1.5rem 0; }
  .quick-answer-label { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary); }
  .quick-answer p:last-child { margin: 0; color: var(--color-text); }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>