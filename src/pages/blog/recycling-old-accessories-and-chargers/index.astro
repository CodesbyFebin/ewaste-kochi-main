---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Recycling Old Accessories and Chargers";
const description = "Recycling Old Accessories and Chargers — practical guidance for Kochi households and businesses, covering mobile recycling, tablet recycling, charger disposal.";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Recycling Old Accessories and Chargers", path: "/blog/recycling-old-accessories-and-chargers/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/recycling-old-accessories-and-chargers/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/recycling-old-accessories-and-chargers/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "Is resale better than recycling?", a: "For a working phone, resale is usually worth checking first — non-working devices are typically better suited to recycling." },
  { q: "How do I book mobile recycling?", a: "Message the details for recycling old accessories and chargers — device type, condition and your location — on WhatsApp to get started." },
  { q: "Are chargers accepted?", a: "Yes, chargers and cables are accepted, including on their own without an accompanying device." },
  { q: "Can accessories be recycled?", a: "Yes, chargers, cases and cables can all be recycled alongside or separately from the device." },
];
---

<Layout title={title} description={description} path="/blog/recycling-old-accessories-and-chargers/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Recycling Old Accessories and Chargers</h1>
  <p class="lede">Here's what you need to know, in plain terms. Chargers, cables, earbuds and headphones are genuine e-waste, even though they're easy to overlook — include them in the same pickup rather than putting them in general waste.</p>

  <CtaBar whatsappMessage="Hi, I have a question about recycling old accessories and chargers." />

  <ul class="key-takeaways">
    <li>Swollen batteries in any small device should never be removed yourself.</li>
    <li>Working phones may have resale value — check before recycling.</li>
    <li>Small items like chargers and earbuds are e-waste too — include them.</li>
  </ul>

  <section>
    <h2>Accessories and small accessories</h2>
    <p>Chargers, cables, earbuds and headphones are genuine e-waste, even though they're easy to overlook — include them in the same pickup rather than putting them in general waste.</p>
  </section>

  <section>
    <h2>Battery safety in small devices</h2>
    <p>Phone, tablet and power bank batteries are lithium-ion and can swell or become hazardous if damaged. Never attempt to remove a swollen battery yourself — flag it with a photo instead.</p>
  </section>

  <section>
    <h2>Resale for phones and tablets</h2>
    <p>A working phone, even a few years old, may still have resale value — brand, model, condition and battery health all factor in. Non-working devices can still have component value.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/sell-electronics/">Sell Electronics</a>
      <a href="/recycling/">E-Waste Recycling</a>
      <a href="/marketplace/">Marketplace</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/recycling-old-accessories-and-chargers/" />

  <section class="final-cta">
    <h2>Have Questions About Recycling Old Accessories and Chargers?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about recycling old accessories and chargers." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
