---
import Layout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DirectAnswer from '../components/DirectAnswer.astro';
import CtaBar from '../components/CtaBar.astro';
import Faq from '../components/Faq.astro';
import RelatedContent from '../components/RelatedContent.astro';
import LongformExpansion from '../components/LongformExpansion.astro';
import Sources from '../components/Sources.astro';
import { BUSINESS, SITE_URL } from '../data/site';

const title = "Donate Electronics in Kochi | Free Pickup & Tax Receipts";
const description = "Donate working laptops, tablets, and appliances in Kochi. Ewaste Kochi partners with verified NGOs. Get a tax-deductible donation certificate. Free pickup available.";
const canonical = "https://www.ewastekochi.com/donate";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Donation", path: "/donate" }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": "2026-08-18",
    "dateModified": "2026-08-18",
    "author": { "@type": "Organization", name: BUSINESS.legalName },
    "publisher": { "@id": `${SITE_URL}/#organization` },
    "mainEntityOfPage": `${SITE_URL}/donate/,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/donate/`,
    "name": title,
    "description": description,
    "dateModified": "2026-08-18",
  }
];

const faqs = [
  {
    question: "What electronics can I donate?",
    answer: "We accept functional laptops, tablets, smartphones, desktops, monitors, and small appliances. Devices must turn on and have no broken screens."
  },
  {
    question: "Do you provide a tax receipt?",
    answer: "Yes! Every donation comes with a formal Certificate of Donation and a tax-deductible receipt from our partner NGOs."
  },
  {
    question: "Is pickup free for donations?",
    answer: "Yes, doorstep pickup is completely free for all functional electronic donations in Kochi and Ernakulam."
  },
  {
    question: "What happens to broken devices?",
    answer: "Broken devices cannot be donated for safety reasons. They are sent to our authorized recycling facility for safe, CPCB-compliant processing."
  }
];

const sourceItems = [
  {
    title: "E-Waste Management Rules and related regulatory resources",
    href: "https://cpcb.nic.in/rules-6/",
    publisher: "Central Pollution Control Board",
    note: "Official CPCB resource page for e-waste rules and updates."
  },
  {
    title: "EPR E-Waste portal",
    href: "https://eprewastecpcb.in/",
    publisher: "Central Pollution Control Board",
    note: "Official portal for e-waste EPR registration and compliance workflows."
  },
  {
    title: "Kerala State Pollution Control Board",
    href: "https://kspcb.kerala.gov.in/",
    publisher: "Kerala State Pollution Control Board",
    note: "Regional enforcement for e-waste recycling in Kerala."
  }
];
---

<Layout title={title} description={description} path="/donate/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />

  <h1>Donate Electronics in Kochi</h1>

  <DirectAnswer>
    <p>You can <strong>donate working electronics in Kochi</strong> through Ewaste Kochi's <em>Reuse & Donate</em> program. We partner with verified NGOs, schools, and community centers to accept functional laptops, tablets, and appliances. 
    <br><br>
    <strong>How it works:</strong> Call 1800-267-1683 or email <code>donate@ewastekochi.in</code>. We schedule a free pickup, verify the device, and issue a <strong>tax-deductible donation certificate</strong> immediately.
    </p>
  </DirectAnswer>

  <CtaBar whatsappMessage="Hi, I want to donate electronics." />

  <section id="eligible-devices">
    <h2>Eligible Devices</h2>
    <p class="lede">We accept functional electronics that are in working condition and have no major damage.</p>

    <div class="grid md:grid-cols-2 gap-6">
      <div class="bg-white p-6 rounded-lg border border-gray-200">
        <h3 class="text-xl font-bold mb-3">Computers & Laptops</h3>
        <ul class="list-disc pl-5 space-y-2">
          <li>Laptops (Windows/Mac, working battery)</li>
          <li>Desktop computers (Tower units)</li>
          <li>Monitors & displays</li>
        </ul>
      </div>

      <div class="bg-white p-6 rounded-lg border border-gray-200">
        <h3 class="text-xl font-bold mb-3">Mobile Devices</h3>
        <ul class="list-disc pl-5 space-y-2">
          <li>Smartphones (Android/iOS)</li>
          <li>Tablets & iPads</li>
          <li>Feature phones (unlocked)</li>
        </ul>
      </div>

      <div class="bg-white p-6 rounded-lg border border-gray-200">
        <h3 class="text-xl font-bold mb-3">Home Electronics</h3>
        <ul class="list-disc pl-5 space-y-2">
          <li>Microwaves, toasters, ovens</li>
          <li>Vacuum cleaners</li>
          <li>Small kitchen appliances</li>
        </ul>
      </div>

      <div class="bg-white p-6 rounded-lg border border-gray-200">
        <h3 class="text-xl font-bold mb-3">IT Equipment</h3>
        <ul class="list-disc pl-5 space-y-2">
          <li>Printers & scanners</li>
          <li>Network equipment</li>
          <li>Servers (small scale)</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="non-eligible">
    <h2>Non-Eligible Items</h2>
    <div class="bg-red-50 border border-red-200 p-6 rounded-lg">
      <h3 class="text-xl font-bold text-red-800 mb-3">Do NOT Donate</h3>
      <ul class="list-disc pl-5 space-y-2 text-red-700">
        <li>Broken screens or cracked casings</li>
        <li>Devices with dead batteries or power issues</li>
        <li>Large appliances (Refrigerators, ACs, washing machines)</li>
        <li>CRT Monitors/TVs (hazardous glass)</li>
        <li>Electrical cables & wiring</li>
      </ul>
    </div>
  </section>

  <section id="impact">
    <h2>Your Impact</h2>
    <p class="bg-green-50 p-6 rounded-lg">
      <strong>Donating extends the life of electronics</strong>, reduces e-waste in landfills, and provides technology to underprivileged students. 
      <strong>100% of your donation goes directly to verified educational NGOs in Kerala.</strong>
    </p>
  </section>

  <LongformExpansion
    label="Expanded Donation Field Guide"
    audience="households"
    localIntent="donate electronics for community programs in Kochi"
    items={["laptops", "tablets", "smartphones", "monitors"]}
    themes={["Preparation", "Safety", "Documentation", "Verification"]}
  />

  <section id="faq-section">
    <h2>Frequently Asked Questions</h2>
    <Faq items={faqs} heading="E-Waste Donation FAQs" />
  </section>

  <Sources items={sourceItems} heading="Official Sources & Regulatory References" />
</Layout>

<style>
  .blog-hub {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .blog-hub h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-primary);
    text-align: center;
  }

  .lede {
    font-size: 1.2rem;
    color: var(--color-muted);
    text-align: center;
    margin-bottom: 2rem;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .blog-hub section {
    margin-bottom: 3rem;
    padding: 2rem;
    background: var(--color-bg);
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
  }

  .blog-hub h2 {
    color: var(--color-primary);
    margin-bottom: 1.5rem;
    font-size: 1.8rem;
  }

  .blog-hub h3 {
    color: var(--color-primary);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.3rem;
  }

  .blog-hub ul {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .blog-hub li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .blog-hub h1 {
      font-size: 2rem;
    }

    .blog-hub section {
      padding: 1.5rem;
    }

    .blog-hub h2 {
      font-size: 1.5rem;
    }

    .blog-hub h3 {
      font-size: 1.2rem;
    }
  }
</style>
