---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "How to Identify Damaged Batteries";
const description = "How to Identify Damaged Batteries — practical guidance for Kochi households and businesses, covering battery recycling near me, UPS battery recycling, lithium bat...";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "How to Identify Damaged Batteries", path: "/blog/how-to-identify-damaged-batteries/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/how-to-identify-damaged-batteries/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/how-to-identify-damaged-batteries/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "Can damaged batteries be recycled?", a: "Yes, damaged batteries are accepted but need to be flagged in advance for safe handling." },
  { q: "Where can I recycle batteries in Kochi?", a: "Book a pickup with Ewaste Kochi for UPS, inverter, laptop, mobile and lithium batteries — mention the type and condition on WhatsApp." },
  { q: "What should I do with swollen batteries?", a: "Don't puncture or move it more than necessary — keep it in a cool, ventilated spot away from other items and flag it with a photo before pickup." },
  { q: "Are laptop batteries accepted?", a: "Yes, both batteries still inside a laptop and removed battery packs are accepted." },
];
---

<Layout title={title} description={description} path="/blog/how-to-identify-damaged-batteries/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>How to Identify Damaged Batteries</h1>
  <p class="lede">A step-by-step answer, covering what actually matters and what you can skip. A swollen battery has already started to fail internally — don't puncture it, don't try to flatten it back into shape, and keep it away from other items and heat.</p>

  <CtaBar whatsappMessage="Hi, I have a question about how to identify damaged batteries." />

  <ul class="key-takeaways">
    <li>Batteries should never be mixed with general household or e-waste bins.</li>
    <li>Swollen, leaking or damaged batteries need photos before pickup.</li>
    <li>Lead-acid (UPS/inverter) and lithium batteries carry different risks.</li>
  </ul>

  <section>
    <h2>Damaged batteries need extra care</h2>
    <p>For how to identify damaged batteries, a swollen battery has already started to fail internally — don't puncture it, don't try to flatten it back into shape, and keep it away from other items and heat. Photograph it and flag it specifically when booking so the team can plan safe handling.</p>
  </section>

  <section>
    <h2>UPS and inverter batteries</h2>
    <p>For how to identify damaged batteries, these are heavy, sealed lead-acid batteries and one of the largest single battery items most households or offices deal with. Keep them upright, note the approximate size, and mention floor or lift access if they need to be moved.</p>
  </section>

  <section>
    <h2>Safe storage before pickup</h2>
    <p>Keep batteries dry, away from direct heat and sunlight, and don't stack heavy items on top. Separate anything visibly damaged from healthy batteries rather than storing them together.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/battery-recycling/">Battery Recycling</a>
      <a href="/pickup/">Book Pickup</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/how-to-identify-damaged-batteries/" />

  <section class="final-cta">
    <h2>Have Questions About How to Identify Damaged Batteries?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about how to identify damaged batteries." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
