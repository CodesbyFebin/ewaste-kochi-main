---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "What Residents Should Bring for E-Waste Pickup";
const description = "What Residents Should Bring for E-Waste Pickup — practical guidance for Kochi households and businesses, covering housing society e-waste pickup, apartment e-wast...";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "What Residents Should Bring for E-Waste Pickup", path: "/blog/what-residents-should-bring-for-e-waste-pickup/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/what-residents-should-bring-for-e-waste-pickup/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/what-residents-should-bring-for-e-waste-pickup/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "What items can residents bring?", a: "For what residents should bring for e-waste pickup: phones, laptops, cables, batteries and general household electronics — check with organizers for the specific drive's scope." },
  { q: "What details should organizers send?", a: "Estimated item count, the collection date and location, and any known battery or bulky items." },
  { q: "What should not be accepted?", a: "Organizers should check with us on anything unusual in advance rather than accepting items they're unsure about." },
  { q: "Can pickup be scheduled?", a: "For what residents should bring for e-waste pickup: yes, an agreed date and time is set with the organizer once feasibility is confirmed." },
];
---

<Layout title={title} description={description} path="/blog/what-residents-should-bring-for-e-waste-pickup/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>What Residents Should Bring for E-Waste Pickup</h1>
  <p class="lede">Here's what you need to know, in plain terms. Decide on a date and common collection point, announce it to residents with a rough list of accepted items, and share the estimated total with us in advance so the visit can be planned.</p>

  <CtaBar whatsappMessage="Hi, I have a question about what residents should bring for e-waste pickup." />

  <ul class="key-takeaways">
    <li>A resident or association can coordinate a combined collection for a building.</li>
    <li>Individual flats can still book their own pickup — a drive isn't mandatory.</li>
    <li>Batteries need separate, well-ventilated storage at a community collection point.</li>
  </ul>

  <section>
    <h2>Planning a collection day</h2>
    <p>For what residents should bring for e-waste pickup, decide on a date and common collection point, announce it to residents with a rough list of accepted items, and share the estimated total with us in advance so the visit can be planned.</p>
  </section>

  <section>
    <h2>Individual pickups still work</h2>
    <p>For what residents should bring for e-waste pickup, a community drive isn't required — any individual flat can book its own pickup at any time, the same as a standalone home.</p>
  </section>

  <section>
    <h2>Organizing a building-wide collection</h2>
    <p>For what residents should bring for e-waste pickup, a resident or the apartment association contacts us with an estimated item count and address. Residents bring items to a common area at an agreed time, and the team collects from that single point.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/pickup/">Book Pickup</a>
      <a href="/locations/">Locations</a>
      <a href="/recycling/">Recycling</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/what-residents-should-bring-for-e-waste-pickup/" />

  <section class="final-cta">
    <h2>Have Questions About What Residents Should Bring for E-Waste Pickup?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about what residents should bring for e-waste pickup." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
