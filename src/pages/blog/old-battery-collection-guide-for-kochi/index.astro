---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Old Battery Collection Guide for Kochi Households";
const description =
  "How to safely store, sort and hand over old batteries in Kochi. Laptop, phone, UPS, inverter. Free doorstep pickup. Damaged batteries: flag with photos first.";
const datePublished = "2026-07-14";
const dateModified = "2026-08-11";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Old Battery Collection Guide for Kochi", path: "/blog/old-battery-collection-guide-for-kochi/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/old-battery-collection-guide-for-kochi/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/old-battery-collection-guide-for-kochi/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "What happens after battery collection?", a: "For old battery collection guide: batteries are kept separate from general e-waste throughout and routed to processing appropriate to their chemistry — lead-acid and lithium are handled differently." },
  { q: "Is battery pickup available for offices?", a: "For old battery collection guide: yes, including bulk pickup for UPS rooms and server room batteries." },
  { q: "How do I book battery pickup?", a: "For old battery collection guide: message the battery type, quantity and condition on WhatsApp, with photos for anything damaged." },
  { q: "Is battery recycling free?", a: "For old battery collection guide: feasibility for battery pickup depends on battery type and chemistry, quantity, condition and your location." },
];
---

<Layout title={title} description={description} path="/blog/old-battery-collection-guide-for-kochi/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Old Battery Collection Guide for Kochi</h1>
  <p class="lede">Here's what's actually available and how to check feasibility for your specific area. These are heavy, sealed lead-acid batteries and one of the largest single battery items most households or offices deal with.</p>

  <CtaBar whatsappMessage="Hi, I have a question about old battery collection guide for kochi." />

  <ul class="key-takeaways">
    <li>Keep batteries dry, upright and away from heat until collected.</li>
    <li>Lead-acid (UPS/inverter) and lithium batteries carry different risks.</li>
    <li>Swollen, leaking or damaged batteries need photos before pickup.</li>
  </ul>

  <section>
    <h2>UPS and inverter batteries</h2>
    <p>For old battery collection guide, these are heavy, sealed lead-acid batteries and one of the largest single battery items most households or offices deal with. Keep them upright, note the approximate size, and mention floor or lift access if they need to be moved.</p>
  </section>

  <section>
    <h2>Damaged batteries need extra care</h2>
    <p>For old battery collection guide, a swollen battery has already started to fail internally — don't puncture it, don't try to flatten it back into shape, and keep it away from other items and heat. Photograph it and flag it specifically when booking so the team can plan safe handling.</p>
  </section>

  <section>
    <h2>Safe storage before pickup</h2>
    <p>For old battery collection guide, keep batteries dry, away from direct heat and sunlight, and don't stack heavy items on top. Separate anything visibly damaged from healthy batteries rather than storing them together.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/battery-recycling/">Battery Recycling</a>
      <a href="/pickup/">Book Pickup</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/old-battery-collection-guide-for-kochi/" />

  <section class="final-cta">
    <h2>Have Questions About Old Battery Collection Guide for Kochi?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about old battery collection guide for kochi." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
