const title = "IT Asset Disposition India | ITAD Services & Compliance | Ewaste Kochi";
const description = "IT asset disposition (ITAD) in India covers secure retirement of IT hardware, data destruction, and CPCB-compliant recycling. Learn the ITAD framework and provider selection.";
const datePublished = "2026-08-18";
const dateModified = "2026-08-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "IT Asset Disposition India", path: "/blog/it-asset-disposition-india/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "IT Asset Disposition India | ITAD Services & Compliance | Ewaste Kochi",
    "description": "IT asset disposition (ITAD) in India covers secure retirement of IT hardware, data destruction, and CPCB-compliant recycling. Learn the ITAD framework and provider selection.",
    "datePublished": "2026-08-18",
    "dateModified": "2026-08-18",
    "author": {
      "@type": "Organization",
      "name": "E-Waste Kochi"
    },
    "publisher": {
