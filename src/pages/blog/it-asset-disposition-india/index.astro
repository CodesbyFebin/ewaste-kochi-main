    },
    "mainEntityOfPage": "https://www.ewastekochi.com/blog/it-asset-disposition-india/",
    "faq": [
      {
        "@type": "Question",
        "name": "Is ITAD legally required in India?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "ITAD practices are required to comply with E-Waste Rules 2022 and data protection obligations, though not as a standalone legal mandate."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between ITAD and recycling?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "ITAD is a comprehensive program including data destruction and asset tracking. Recycling focuses on material recovery. ITAD is appropriate for high-value or data-sensitive assets."
        }
      },
      {
