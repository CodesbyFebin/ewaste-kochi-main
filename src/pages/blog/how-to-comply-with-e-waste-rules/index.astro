    },
    "mainEntityOfPage": "https://www.ewastekochi.com/blog/how-to-comply-with-e-waste-rules/",
    "faq": [
      {
        "@type": "Question",
        "name": "What are the penalties for non-compliance?",
        "acceptedAnswer": {
          "@type": "Answer",
