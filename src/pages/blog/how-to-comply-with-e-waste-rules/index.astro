const title = "How to Comply with E-Waste Rules | CPCB Compliance Guide | Ewaste Kochi";
const description = "A practical compliance guide for households and businesses: understand E-Waste Rules 2022, channel e-waste through authorized recyclers, and maintain records.";
const datePublished = "2026-08-18";
