---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "E-Waste Collection for Kochi Offices";
const description = "E-Waste Collection for Kochi Offices — practical guidance for Kochi households and businesses, covering e-waste pickup Kakkanad, Kalamassery, Ernakulam South.";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "E-Waste Collection for Kochi Offices", path: "/blog/e-waste-collection-for-kochi-offices/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/e-waste-collection-for-kochi-offices/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/e-waste-collection-for-kochi-offices/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "Which Kochi areas are supported?", a: "For e-waste collection offices: Ewaste Kochi primarily supports Kochi, Ernakulam, Kakkanad, Kalamassery, Ernakulam South, Aluva and nearby Kochi-metro enquiry areas. For other Kerala districts, contact us to check pickup feasibility." },
  { q: "Can offices request pickup?", a: "Yes, business addresses are covered the same way as residential ones." },
  { q: "How do I send map location?", a: "Use WhatsApp's location-sharing feature to send a precise pin alongside a text description of the building." },
  { q: "Should I share location?", a: "Yes, a specific address or WhatsApp location pin speeds up confirmation significantly." },
];
---

<Layout title={title} description={description} path="/blog/e-waste-collection-for-kochi-offices/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>E-Waste Collection for Kochi Offices</h1>
  <p class="lede">What this looks like specifically for your situation, not just general advice. Both residential and commercial pickups are supported across the service area — include building name and floor, or business address, when you message.</p>

  <CtaBar whatsappMessage="Hi, I have a question about e-waste collection for kochi offices." />

  <ul class="key-takeaways">
    <li>Areas outside the core Kochi-metro zone should always be checked first.</li>
    <li>A precise address or WhatsApp location pin speeds up confirmation.</li>
    <li>Kakkanad, Kalamassery and Ernakulam South have dedicated location pages.</li>
  </ul>

  <section>
    <h2>Apartments and offices</h2>
    <p>For e-waste collection offices, both residential and commercial pickups are supported across the service area — include building name and floor, or business address, when you message.</p>
  </section>

  <section>
    <h2>Aluva</h2>
    <p>For e-waste collection offices, aluva town and surrounding residential areas are within the Kochi-metro service zone — message your specific area to confirm.</p>
  </section>

  <section>
    <h2>Ernakulam South</h2>
    <p>For e-waste collection offices, ernakulam South is a core service area with a dedicated location page, including areas near the railway station and central Ernakulam.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/locations/">Locations</a>
      <a href="/locations/kakkanad/">Kakkanad Location</a>
      <a href="/locations/kalamassery/">Kalamassery</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/e-waste-collection-for-kochi-offices/" />

  <section class="final-cta">
    <h2>Have Questions About E-Waste Collection for Kochi Offices?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about e-waste collection for kochi offices." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
