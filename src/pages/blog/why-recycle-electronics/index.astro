---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DirectAnswer from "../../../components/DirectAnswer.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import LongformExpansion from "../../../components/LongformExpansion.astro";
import Sources from "../../../components/Sources.astro";
import { BUSINESS, SITE_URL } from "../../../data/site";

const title = "Why Recycling Electronics Matters in Kochi";
const description = "The environmental, legal and data-security reasons to recycle old electronics through authorised channels in Kochi and Ernakulam.";
const lastUpdated = "2026-08-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "General E-Waste", path: "/blog/general-ewaste/" },
  { name: "Why Recycling Electronics Matters", path: "/blog/why-recycle-electronics/" }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": "2026-08-18",
    "dateModified": lastUpdated,
    "author": { "@type": "Organization", name: BUSINESS.legalName },
    "publisher": { "@id": `${SITE_URL}/#organization` },
    "mainEntityOfPage": `${SITE_URL}/blog/why-recycle-electronics/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/why-recycle-electronics/`,
    "name": title,
    "description": description,
    "dateModified": lastUpdated,
  }
];

const faqItems = [
  {
    q: "Does recycling really recover materials?",
    a: "Yes. Copper, aluminium, gold and rare-earth elements are extracted and reused in new manufacturing through certified processes."
  },
  {
    q: "Is my data safe if I recycle?",
    a: "It is when drives go through certified destruction first. Ask for a Certificate of Destruction for business equipment."
  },
  {
    q: "What is the biggest risk of not recycling?",
    a: "Toxic metals leaking into soil and water, plus the loss of recoverable materials that simply get buried."
  },
  {
    q: "Is recycling legally required?",
    a: "E-waste is regulated separately from household waste; authorised handling is the expected, low-friction way to comply."
  }
];

const sourceItems = [
  {
    title: "E-Waste Management Rules and related regulatory resources",
    href: "https://cpcb.nic.in/rules-6/",
    publisher: "Central Pollution Control Board",
    note: "Official CPCB resource page for e-waste rules and updates."
  },
  {
    title: "EPR E-Waste portal",
    href: "https://eprewastecpcb.in/",
    publisher: "Central Pollution Control Board",
    note: "Official portal for e-waste EPR registration and compliance workflows."
  },
  {
    title: "Kerala State Pollution Control Board",
    href: "https://kspcb.kerala.gov.in/",
    publisher: "Kerala State Pollution Control Board",
    note: "Regional enforcement and authorization for e-waste recyclers in Kerala."
  }
];
---

<Layout title={title} description={description} path="/blog/why-recycle-electronics/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />

  <h1>Why Recycling Electronics Matters</h1>

  <DirectAnswer>
    <p>Recycling electronics keeps toxic metals out of soil and water, recovers valuable materials, and protects your data. In Kochi, authorised recycling also keeps you aligned with India's e-waste rules.</p>
  </DirectAnswer>

  <CtaBar whatsappMessage="Hi, I want to recycle old electronics the right way in Kochi." />

  <section id="section-1">
    <h2>Protecting health and environment</h2>
    <p>Improper dumping releases lead, mercury and brominated compounds into the environment where they persist for decades.</p>
    <p>Authorised recycling intercepts these materials before they reach soil and groundwater around Kochi and the backwaters.</p>
  </section>
  <section id="section-2">
    <h2>Recovering scarce materials</h2>
    <p>A single laptop contains gold, copper, aluminium and rare-earth magnets worth recovering.</p>
    <p>Recycling closes the loop so fewer virgin mines are needed to make the next generation of devices.</p>
  </section>
  <section id="section-3">
    <h2>Data security is part of recycling</h2>
    <p>Old phones and computers often leave home with recoverable personal and business data still on the drive.</p>
    <p>Certified data destruction before processing ensures your information is irrecoverable and your compliance record is complete.</p>
  </section>
  <section id="section-4">
    <h2>Staying within the law</h2>
    <p>India's E-Waste (Management) Rules separate electronic waste from municipal garbage for a reason.</p>
    <p>Using authorised channels in Kochi is the straightforward way to meet that expectation without paperwork headaches.</p>
  </section>

  <RelatedContent>
    <h2>Explore more guides</h2>
    <ul>
      <li><a href="/blog/general-ewaste/">General E-Waste hub</a></li>
      <li><a href="/blog/general-ewaste/">General e-waste basics</a></li>
      <li><a href="/recycling/">Recycling service</a></li>
      <li><a href="/pickup/">Book a pickup</a></li>
    </ul>
  </RelatedContent>

  <LongformExpansion
    label="Expanded field guide"
    audience="households and businesses in Kochi"
    localIntent="why recycling electronics matters with authorised pickup"
    items={["old electronics", "batteries", "cables", "data devices"]}
    themes={["Preparation", "Safety", "Compliance", "Recovery"]}
  />

  <section id="faq-section">
    <h2>Frequently asked questions</h2>
    <Faq items={faqItems} heading="Why Recycling Electronics Matters FAQs" />
  </section>

  <Sources items={sourceItems} heading="Official sources & regulatory references" />
</Layout>

<style>
  .blog-hub { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; }
  .blog-hub h1 { font-size: 2.5rem; margin-bottom: 1rem; color: var(--color-primary); text-align: center; }
  .blog-hub section { margin-bottom: 3rem; padding: 2rem; background: var(--color-bg); border-radius: 0.75rem; border: 1px solid var(--color-border); }
  .blog-hub h2 { color: var(--color-primary); margin-bottom: 1.5rem; font-size: 1.8rem; }
  .blog-hub ul { margin-bottom: 1rem; padding-left: 1.5rem; }
  .blog-hub li { margin-bottom: 0.5rem; line-height: 1.6; }
  @media (max-width: 768px) {
    .blog-hub h1 { font-size: 2rem; }
    .blog-hub section { padding: 1.5rem; }
    .blog-hub h2 { font-size: 1.5rem; }
  }
</style>
