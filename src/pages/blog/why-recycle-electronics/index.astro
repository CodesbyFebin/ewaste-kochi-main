import { BUSINESS, SITE_URL } from "../../../data/site";

const title = "Why Recycle Electronics? | Environmental & Security Reasons | Ewaste Kochi";
const description = "Recycling electronics protects health, recovers valuable metals, prevents data breaches, and ensures legal compliance under E-Waste Rules 2022.";
const datePublished = "2026-08-18";
const dateModified = "2026-08-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Why Recycle Electronics?", path: "/blog/why-recycle-electronics/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Why Recycle Electronics? | Environmental & Security Reasons | Ewaste Kochi",
    "description": "Recycling electronics protects health, recovers valuable metals, prevents data breaches, and ensures legal compliance under E-Waste Rules 2022.",
    "datePublished": "2026-08-18",
    "dateModified": "2026-08-18",
    "author": {
      "@type": "Organization",
      "name": "E-Waste Kochi"
    },
    "publisher": {
      "@id": "https://www.ewastekochi.com/#organization"
    },
    "mainEntityOfPage": "https://www.ewastekochi.com/blog/why-recycle-electronics/",
    "faq": [
      {
        "@type": "Question",
        "name": "Does recycling actually recover valuable materials?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Authorized recyclers recover ferrous and non-ferrous metals, plastics, and glass using mechanical and manual sorting under controlled conditions."
        }
      },
      {
        "@type": "Question",
        "name": "Will I get paid for recycling old electronics?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Some functional or high-value devices may qualify for resale or buyback. Non-functional or obsolete devices are typically recycled free of charge or at a nominal handling fee."
        }
      },
      {
        "@type": "Question",
        "name": "Is recycling required by law?",
        "acceptedAnswer": {
