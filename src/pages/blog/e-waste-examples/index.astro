---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DirectAnswer from "../../../components/DirectAnswer.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "E-Waste Examples: Common Electronic Items to Recycle in Kerala";
const description =
  "See common e-waste examples in Kerala — computers, phones, batteries, office electronics, cables and more — plus which items need data or battery safety before recycling.";
const datePublished = "2026-07-07";
const dateModified = "2026-08-15";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "E-Waste Examples", path: "/blog/e-waste-examples/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/e-waste-examples/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/e-waste-examples/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  {
    q: "Do small items like chargers and cables really count?",
    a: "Yes — they're often overlooked, but cables, chargers, and small accessories are e-waste and shouldn't go in general trash.",
  },
  {
    q: "What if I'm not sure whether something qualifies?",
    a: "Send us a photo over WhatsApp and we'll confirm before you schedule a pickup.",
  },
  {
    q: "Do all of these need data wiping?",
    a: "Only devices with storage — computers, laptops, phones, tablets, and some office equipment like printers with internal memory. Cables, basic peripherals, and most appliances don't hold data.",
  },
];
---

<Layout title={title} description={description} path="/blog/e-waste-examples/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>E-Waste Examples: Common Items You Should Recycle in Kerala</h1>
  <p class="lede">
    E-waste covers more than just old computers. This practical list shows
    common household and office electronics that count as e-waste, plus the
    items that need data wiping or battery-safety handling before recycling.
  </p>

  <DirectAnswer>
    <p>{description}</p>
  </DirectAnswer>

  <CtaBar whatsappMessage="Hi, I'd like to check what e-waste items you can collect." />

  <section>
    <h2>What counts as e-waste?</h2>
    <p>
      A practical rule of thumb is that discarded equipment with electronics,
      a circuit board, a plug or a battery should be treated as e-waste rather
      than ordinary household rubbish. Common examples include computers,
      phones, chargers, batteries, printers, routers, TVs and office IT gear.
      If you are unsure about a specific item, send a photo before pickup.
    </p>
  </section>

  <section>
    <h2>Computers and laptops</h2>
    <p>
      Desktops, laptops, monitors, keyboards, mice, and docking stations.
      These often include data-bearing storage, so <a href="/data-destruction/">data
      wiping</a> matters before they're recycled or resold. If you're
      selling rather than recycling, see
      <a href="/computer-scrap-buyers-kochi/">computer scrap buyers</a>.
    </p>
  </section>

  <section>
    <h2>Mobile phones and tablets</h2>
    <p>
      Smartphones, basic phones, and tablets — all carry personal data and
      a battery, so both data wiping and battery-safe handling apply.
    </p>
  </section>

  <section>
    <h2>Batteries and UPS units</h2>
    <p>
      UPS batteries, inverter batteries, laptop and phone batteries, and
      power banks need separate handling from general e-waste — see
      <a href="/battery-recycling/">battery recycling</a> for why, and what
      we accept.
    </p>
  </section>

  <section>
    <h2>Office electronics</h2>
    <p>
      Printers, scanners, routers, networking switches, and servers.
      Larger volumes or server-specific hardware are usually better
      handled through <a href="/itad/">ITAD</a> or dedicated
      <a href="/server-recycling-kochi/">server recycling</a> rather than
      a one-off pickup.
    </p>
  </section>

  <section>
    <h2>Cables, chargers, and accessories</h2>
    <p>
      Easy to forget, but genuinely e-waste — old chargers, cables,
      adapters, and similar accessories. No data or battery concerns
      usually apply here, so these are some of the simplest items to hand
      over.
    </p>
  </section>

  <section>
    <h2>TVs and monitors</h2>
    <p>
      Both modern LED/LCD screens and older CRT (tube) televisions — see
      <a href="/tv-recycling-kochi/">TV recycling</a> for details specific
      to displays.
    </p>
  </section>

  <section>
    <h2>Items that need data wiping first</h2>
    <p>
      Anything with storage — computers, laptops, phones, tablets, and
      some printers or networking gear with internal memory. See
      <a href="/data-destruction/">data destruction</a> for how this
      works.
    </p>
  </section>

  <section>
    <h2>Items that need battery-safety handling</h2>
    <p>
      Anything with a built-in or removable battery, especially if it's
      swollen, damaged, or leaking — see
      <a href="/battery-recycling/">battery recycling</a> for safe interim
      storage guidance.
    </p>
  </section>

  <section>
    <h2>How to recycle these items with Ewaste Kochi</h2>
    <p>
      Share the item list, photos and your location first. We can then confirm
      the appropriate route for general electronics, batteries, data-bearing
      devices or business IT assets. Pickup feasibility depends on item type,
      quantity, condition, location and current scheduling.
    </p>
    <CtaBar whatsappMessage="Hi, I have e-waste items to recycle. Here are the item details and my location:" compact />
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/e-waste-examples/" />

  <p class="updated">Last updated: <time datetime={dateModified}>{dateModified}</time></p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
</style>