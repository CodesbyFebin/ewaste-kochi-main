---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Office E-Waste Preparation Checklist";
const description = "Office E-Waste Preparation Checklist — practical guidance for Kochi households and businesses, covering prepare electronics, e-waste pickup checklist, safety.";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Office E-Waste Preparation Checklist", path: "/blog/office-e-waste-preparation-checklist/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/office-e-waste-preparation-checklist/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/office-e-waste-preparation-checklist/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "How do I store batteries safely?", a: "For office e-waste preparation checklist: keep them dry, away from heat, upright, and separate from other items until pickup." },
  { q: "What should I confirm before pickup?", a: "For office e-waste preparation checklist: your pickup slot, any access details, and whether data destruction is included if needed." },
  { q: "What should homes prepare?", a: "For office e-waste preparation checklist: items gathered in one place, batteries separated, and data wiped from anything with storage." },
  { q: "What affects feasibility?", a: "Feasibility for office e-waste preparation checklist depends on item type, quantity, condition and your location." },
];
---

<Layout title={title} description={description} path="/blog/office-e-waste-preparation-checklist/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Office E-Waste Preparation Checklist</h1>
  <p class="lede">A practical checklist you can run through before booking — not everything on it applies to every pickup. A rough asset list, labelled data-bearing devices, and clear access details (floor, loading dock) help a business pickup run smoothly, especially for larger quantities.</p>

  <CtaBar whatsappMessage="Hi, I have a question about office e-waste preparation checklist." />

  <ul class="key-takeaways">
    <li>Data and battery preparation matter more than exact item sorting.</li>
    <li>Photos of damaged, bulky or battery items speed up confirmation.</li>
    <li>You can add items after booking — just mention them before pickup day.</li>
  </ul>

  <section>
    <h2>Preparation for offices</h2>
    <p>For office e-waste preparation checklist, a rough asset list, labelled data-bearing devices, and clear access details (floor, loading dock) help a business pickup run smoothly, especially for larger quantities.</p>
  </section>

  <section>
    <h2>The essentials</h2>
    <p>For office e-waste preparation checklist, back up and wipe data-bearing devices, separate batteries into their own bag, flag anything damaged or bulky, and note your pickup address and preferred timeframe. Not everything on a general checklist applies to every pickup.</p>
  </section>

  <section>
    <h2>Battery preparation specifically</h2>
    <p>Identify all battery-containing items, keep them in a separate bag, and flag anything swollen, leaking or unusually warm before pickup rather than during it.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/pickup/">Book Pickup</a>
      <a href="/battery-recycling/">Battery Recycling</a>
      <a href="/data-destruction/">Data Destruction</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/office-e-waste-preparation-checklist/" />

  <section class="final-cta">
    <h2>Have Questions About Office E-Waste Preparation Checklist?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about office e-waste preparation checklist." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
