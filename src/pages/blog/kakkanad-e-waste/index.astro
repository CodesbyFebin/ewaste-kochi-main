---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DirectAnswer from "../../../components/DirectAnswer.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import LongformExpansion from "../../../components/LongformExpansion.astro";
import Sources from "../../../components/Sources.astro";
import { BUSINESS, SITE_URL } from "../../../data/site";

const title = "E-Waste Pickup in Kakkanad & Infopark";
const description = "Kakkanad and Infopark e-waste collection for IT parks, offices and nearby residences.";
const lastUpdated = "2026-08-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Locations & Services", path: "/blog/locations-services/" },
  { name: "E-Waste Pickup in Kakkanad", path: "/blog/kakkanad-e-waste/" }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": "2026-08-18",
    "dateModified": lastUpdated,
    "author": { "@type": "Organization", name: BUSINESS.legalName },
    "publisher": { "@id": `${SITE_URL}/#organization` },
    "mainEntityOfPage": `${SITE_URL}/blog/kakkanad-e-waste/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/kakkanad-e-waste/`,
    "name": title,
    "description": description,
    "dateModified": lastUpdated,
  }
];

const faqItems = [
  {
    q: "Do you cover Infopark offices?",
    a: "Yes, Kakkanad IT-park pickups are common with an inventory shared in advance."
  },
  {
    q: "What helps a fast Kakkanad slot?",
    a: "Clear item list, quantities, access window and photos."
  },
  {
    q: "Is data destruction available?",
    a: "Yes, for storage-bearing devices, with certificates."
  },
  {
    q: "Can Kakkanad societies batch pickups?",
    a: "Yes, apartment batches are straightforward to arrange."
  }
];

const sourceItems = [
  {
    title: "E-Waste Management Rules and related regulatory resources",
    href: "https://cpcb.nic.in/rules-6/",
    publisher: "Central Pollution Control Board",
    note: "Official CPCB resource page for e-waste rules and updates."
  },
  {
    title: "EPR E-Waste portal",
    href: "https://eprewastecpcb.in/",
    publisher: "Central Pollution Control Board",
    note: "Official portal for e-waste EPR registration and compliance workflows."
  },
  {
    title: "Kerala State Pollution Control Board",
    href: "https://kspcb.kerala.gov.in/",
    publisher: "Kerala State Pollution Control Board",
    note: "Regional enforcement and authorization for e-waste recyclers in Kerala."
  }
];
---

<Layout title={title} description={description} path="/blog/kakkanad-e-waste/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />

  <h1>E-Waste Pickup in Kakkanad</h1>

  <DirectAnswer>
    <p>Kakkanad and Infopark have strong e-waste pickup coverage thanks to dense IT offices. Share your campus or society details, item list and photos so the team can confirm a slot.</p>
  </DirectAnswer>

  <CtaBar whatsappMessage="Hi, I'm in Kakkanad/Infopark and want to schedule a pickup." />

  <section id="section-1">
    <h2>Why Kakkanad is well covered</h2>
    <p>High volumes of IT assets make Kakkanad and Infopark frequent pickup zones.</p>
    <p>Offices and apartments alike can arrange Kakkanad collections with clear details.</p>
  </section>
  <section id="section-2">
    <h2>Office and campus requests</h2>
    <p>Kakkanad IT parks share asset inventories, access windows and data-destruction needs.</p>
    <p>Bulk lots are easier to plan when listed in advance.</p>
  </section>
  <section id="section-3">
    <h2>Residences and societies</h2>
    <p>Nearby Kakkanad apartments can batch collections for convenience.</p>
    <p>Building and lift details help the team plan the Kakkanad slot.</p>
  </section>
  <section id="section-4">
    <h2>Confirming the slot</h2>
    <p>For Kakkanad, feasibility is confirmed after reviewing your items and photos.</p>
    <p>Data-bearing devices are routed through certified destruction.</p>
  </section>

  <RelatedContent>
    <h2>Explore more guides</h2>
    <ul>
      <li><a href="/blog/locations-services/">Locations & Services hub</a></li>
      <li><a href="/blog/general-ewaste/">General e-waste basics</a></li>
      <li><a href="/recycling/">Recycling service</a></li>
      <li><a href="/pickup/">Book a pickup</a></li>
    </ul>
  </RelatedContent>

  <LongformExpansion
    label="Expanded field guide"
    audience="households and businesses in Kochi"
    localIntent="e-waste pickup in kakkanad with authorised pickup"
    items={["old electronics", "batteries", "cables", "data devices"]}
    themes={["Preparation", "Safety", "Compliance", "Recovery"]}
  />

  <section id="faq-section">
    <h2>Frequently asked questions</h2>
    <Faq items={faqItems} heading="E-Waste Pickup in Kakkanad FAQs" />
  </section>

  <Sources items={sourceItems} heading="Official sources & regulatory references" />
</Layout>

<style>
  .blog-hub { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; }
  .blog-hub h1 { font-size: 2.5rem; margin-bottom: 1rem; color: var(--color-primary); text-align: center; }
  .blog-hub section { margin-bottom: 3rem; padding: 2rem; background: var(--color-bg); border-radius: 0.75rem; border: 1px solid var(--color-border); }
  .blog-hub h2 { color: var(--color-primary); margin-bottom: 1.5rem; font-size: 1.8rem; }
  .blog-hub ul { margin-bottom: 1rem; padding-left: 1.5rem; }
  .blog-hub li { margin-bottom: 0.5rem; line-height: 1.6; }
  @media (max-width: 768px) {
    .blog-hub h1 { font-size: 2rem; }
    .blog-hub section { padding: 1.5rem; }
    .blog-hub h2 { font-size: 1.5rem; }
  }
</style>
