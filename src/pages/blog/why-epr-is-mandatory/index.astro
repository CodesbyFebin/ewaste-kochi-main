import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL } from "../../../data/site";

const title = "Why Is EPR Mandatory? | Extended Producer Responsibility Explained | Ewaste Kochi";
const description = "EPR is mandatory because informal e-waste recycling causes severe environmental and health damage. Learn how EPR shifts responsibility to producers.";
const datePublished = "2026-08-18";
const dateModified = "2026-08-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Why Is EPR Mandatory?", path: "/blog/why-epr-is-mandatory/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Why Is EPR Mandatory? | Extended Producer Responsibility Explained | Ewaste Kochi",
    "description": "EPR is mandatory because informal e-waste recycling causes severe environmental and health damage. Learn how EPR shifts responsibility to producers.",
    "datePublished": "2026-08-18",
    "dateModified": "2026-08-18",
    "author": {
      "@type": "Organization",
      "name": "E-Waste Kochi"
    },
    "publisher": {
      "@id": "https://www.ewastekochi.com/#organization"
    },
    "mainEntityOfPage": "https://www.ewastekochi.com/blog/why-epr-is-mandatory/",
    "faq": [
      {
        "@type": "Question",
        "name": "Who bears the cost of EPR?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The producer (brand or importer) bears the cost by building EPR compliance into product pricing and funding authorized collection and recycling."
        }
      },
      {
        "@type": "Question",
        "name": "Does EPR increase product prices?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "EPR may result in a marginal price increase as producers internalize recycling costs, but it is typically offset by scale efficiencies in collection and processing."
        }
      },
      {
        "@type": "Question",
        "name": "What happens if a producer fails EPR targets?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "CPCB may impose financial penalties, restrict new product placements, or suspend the producer's authorization."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.ewastekochi.com/blog/why-epr-is-mandatory/",
    "name": "Why Is EPR Mandatory? | Extended Producer Responsibility Explained | Ewaste Kochi",
