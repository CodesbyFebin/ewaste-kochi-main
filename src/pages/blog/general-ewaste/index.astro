const title = "General E-Waste: Recycling Basics, Preparation & Everyday Disposal";
const description = "Essential e-waste recycling guidance for households and small businesses. Find out what can be recycled, how to prepare items, where to find authorized services, and why proper disposal matters.";
const lastUpdated = "2026-07-09";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "General E-Waste", path: "/blog/general-ewaste/" }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": "2026-07-09",
    "dateModified": lastUpdated,
    "author": { "@type": "Organization", name: BUSINESS.legalName },
    "publisher": { "@id": `${SITE_URL}/#organization` },
    "mainEntityOfPage": `${SITE_URL}/blog/general-ewaste/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/general-ewaste/`,
    "name": title,
    "description": description,
    "dateModified": lastUpdated,
  }
];

const faqItems = [
  {
    q: "What is e-waste and how is it classified in India?",
    a: "E-waste refers to any electrical or electronic equipment—whole or in part—that is non-functional, obsolete, or intended for disposal, as well as repair or manufacturing rejects. Regulated under the E-Waste (Management) Rules, it covers household appliances (refrigerators, washing machines, air conditioners), IT/telecom gear, and consumer electronics reaching end-of-life."
  },
  {
    q: "Can e-waste just go in the recycling bin with paper and plastic?",
    a: "No. E-waste needs separate handling because of the metals, chemicals, and batteries it can contain — mixing it with general recycling can contaminate that stream and create safety hazards. See our e-waste examples guide for a fuller list."
  },
  {
    q: "Is it illegal to throw electronics in household trash in Kerala?",
    a: "E-waste is regulated separately from general household waste under national rules — see our overview of the E-Waste Management Rules 2022 for the general framework. For specifics, check with the Kerala State Pollution Control Board."
  },
  {
    q: "What should I do with e-waste right now?",
    a: "Message us for a free doorstep pickup, or check our recycling page for what's accepted and how it works."
  },
  {
    q: "Do I need documentation for home e-waste disposal?",
    a: "For small household disposals, a pickup acknowledgement is usually sufficient documentation. If you need formal proof for insurance or record-keeping, request a Certificate of Recycling from your authorized recycler."
  },
  {
    q: "Can I sell old electronics to scrap dealers instead of recycling?",
    a: "Informal sales to scrap dealers (kabariwalas) are discouraged by the rules because many scrap dealers don't follow safe recycling practices. Selling to authorized recyclers ensures proper handling of hazardous components and provides documentation."
  },
  {
    q: "How much does e-waste recycling cost for households?",
    a: "Most authorized recyclers in Kerala offer free doorstep collection for household items. Some premium services (like data destruction for sensitive devices) may have a small fee, but basic recycling is typically free."
  },
  {
    q: "Where can I find a list of authorized e-waste recyclers in Kochi?",
    a: "Check the Kerala State Pollution Control Board (KSPCB) authorized recycler list, or use our recycling service directory which links to verified providers with valid authorizations."
  ]
];

const sourceItems = [
  {
    title: "E-Waste Management Rules and related regulatory resources",
    href: "https://cpcb.nic.in/rules-6/",
    publisher: "Central Pollution Control Board",
    note: "Official CPCB resource page for e-waste rules and updates."
  },
  {
    title: "EPR E-Waste portal",
    href: "https://eprewastecpcb.in/",
