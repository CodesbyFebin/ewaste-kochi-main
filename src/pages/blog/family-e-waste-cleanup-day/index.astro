---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Family E-Waste Cleanup Day";
const description = "Family E-Waste Cleanup Day — practical guidance for Kochi households and businesses, covering housing society e-waste pickup, apartment e-waste collection, commun...";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Family E-Waste Cleanup Day", path: "/blog/family-e-waste-cleanup-day/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/family-e-waste-cleanup-day/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/family-e-waste-cleanup-day/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "Is documentation available?", a: "Documentation may be available for larger organized drives on request." },
  { q: "Should data-bearing devices be separated?", a: "Yes, residents should back up and wipe devices with storage before bringing them to a collection point." },
  { q: "How do we book a community pickup?", a: "For family e-waste cleanup day: contact us with the estimated scale and building or community address to discuss scheduling." },
  { q: "What items can residents bring?", a: "Phones, laptops, cables, batteries and general household electronics — check with organizers for the specific drive's scope." },
];
---

<Layout title={title} description={description} path="/blog/family-e-waste-cleanup-day/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Family E-Waste Cleanup Day</h1>
  <p class="lede">Here's what you need to know, in plain terms. Schools and community groups interested in an e-waste awareness or collection day should contact us directly to discuss scope and feasibility — this is handled case-by-case rather than as a standard advertised service.</p>

  <CtaBar whatsappMessage="Hi, I have a question about family e-waste cleanup day." />

  <ul class="key-takeaways">
    <li>Community and school drives are handled case-by-case — contact us to plan one.</li>
    <li>Batteries need separate, well-ventilated storage at a community collection point.</li>
    <li>Individual flats can still book their own pickup — a drive isn't mandatory.</li>
  </ul>

  <section>
    <h2>School and community awareness drives</h2>
    <p>For family e-waste cleanup day, schools and community groups interested in an e-waste awareness or collection day should contact us directly to discuss scope and feasibility — this is handled case-by-case rather than as a standard advertised service.</p>
  </section>

  <section>
    <h2>Battery safety at a community collection point</h2>
    <p>For family e-waste cleanup day, don't store large quantities of batteries in an enclosed common area without ventilation. Flag any damaged batteries in advance and keep them isolated from other collected items.</p>
  </section>

  <section>
    <h2>Individual pickups still work</h2>
    <p>For family e-waste cleanup day, a community drive isn't required — any individual flat can book its own pickup at any time, the same as a standalone home.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/pickup/">Book Pickup</a>
      <a href="/locations/">Locations</a>
      <a href="/recycling/">Recycling</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/family-e-waste-cleanup-day/" />

  <section class="final-cta">
    <h2>Have Questions About Family E-Waste Cleanup Day?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about family e-waste cleanup day." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
