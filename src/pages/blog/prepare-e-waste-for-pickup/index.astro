---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DirectAnswer from "../../../components/DirectAnswer.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import LongformExpansion from "../../../components/LongformExpansion.astro";
import Sources from "../../../components/Sources.astro";
import { BUSINESS, SITE_URL } from "../../../data/site";

const title = "How to Prepare E-Waste for Pickup in Kochi";
const description = "A practical checklist for households and offices before e-waste collection: drying, separating batteries, listing items and sharing photos.";
const lastUpdated = "2026-08-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "General E-Waste", path: "/blog/general-ewaste/" },
  { name: "How to Prepare E-Waste for Pickup", path: "/blog/prepare-e-waste-for-pickup/" }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": "2026-08-18",
    "dateModified": lastUpdated,
    "author": { "@type": "Organization", name: BUSINESS.legalName },
    "publisher": { "@id": `${SITE_URL}/#organization` },
    "mainEntityOfPage": `${SITE_URL}/blog/prepare-e-waste-for-pickup/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/prepare-e-waste-for-pickup/`,
    "name": title,
    "description": description,
    "dateModified": lastUpdated,
  }
];

const faqItems = [
  {
    q: "Should I clean devices first?",
    a: "No deep cleaning needed, but dry, dust-free items are easier to inspect and safer to handle."
  },
  {
    q: "What photos help most?",
    a: "Overall shot, close-up of model label, and any damage or battery swelling you can see."
  },
  {
    q: "Do I need to box everything?",
    a: "Not required, but grouping by type (IT, batteries, cables) helps the team load efficiently."
  },
  {
    q: "When is pickup confirmed?",
    a: "After the team reviews your list and photos and matches it to a feasible route and slot."
  }
];

const sourceItems = [
  {
    title: "E-Waste Management Rules and related regulatory resources",
    href: "https://cpcb.nic.in/rules-6/",
    publisher: "Central Pollution Control Board",
    note: "Official CPCB resource page for e-waste rules and updates."
  },
  {
    title: "EPR E-Waste portal",
    href: "https://eprewastecpcb.in/",
    publisher: "Central Pollution Control Board",
    note: "Official portal for e-waste EPR registration and compliance workflows."
  },
  {
    title: "Kerala State Pollution Control Board",
    href: "https://kspcb.kerala.gov.in/",
    publisher: "Kerala State Pollution Control Board",
    note: "Regional enforcement and authorization for e-waste recyclers in Kerala."
  }
];
---

<Layout title={title} description={description} path="/blog/prepare-e-waste-for-pickup/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />

  <h1>How to Prepare E-Waste for Pickup</h1>

  <DirectAnswer>
    <p>Before pickup, keep items dry, separate batteries, list each item with its condition, and send clear photos. That lets the Kochi team confirm acceptance and the right service route quickly.</p>
  </DirectAnswer>

  <CtaBar whatsappMessage="Hi, I have items ready and want to prepare them properly for pickup." />

  <section id="section-1">
    <h2>Gather and keep it dry</h2>
    <p>Collect everything in one dry place so nothing is forgotten at the bottom of a cupboard.</p>
    <p>Moisture causes short circuits and corrosion, so store items off the floor and away from rain.</p>
  </section>
  <section id="section-2">
    <h2>Separate batteries and data devices</h2>
    <p>Pull out user-replaceable batteries and set them aside in a non-conductive container.</p>
    <p>Keep phones, laptops and drives together so data destruction can be arranged before processing.</p>
  </section>
  <section id="section-3">
    <h2>Write a clear item list</h2>
    <p>Note the item type, quantity, brand and whether it works. This avoids confused quotes later.</p>
    <p>Mention anything unusual — damaged screens, leaking cells or mixed lots — up front.</p>
  </section>
  <section id="section-4">
    <h2>Send photos before the slot</h2>
    <p>Angled photos of damage, model labels and battery condition speed up confirmation.</p>
    <p>The team uses them to decide between recycling, resale review, data destruction or ITAD routing.</p>
  </section>

  <RelatedContent href="/blog/prepare-e-waste-for-pickup/" />

  <LongformExpansion
    label="Expanded field guide"
    audience="households and businesses in Kochi"
    localIntent="how to prepare e-waste for pickup with authorised pickup"
    items={["old electronics", "batteries", "cables", "data devices"]}
    themes={["Preparation", "Safety", "Compliance", "Recovery"]}
  />

  <section id="faq-section">
    <h2>Frequently asked questions</h2>
    <Faq items={faqItems} heading="How to Prepare E-Waste for Pickup FAQs" />
  </section>

  <Sources items={sourceItems} heading="Official sources & regulatory references" />
</Layout>

<style>
  .blog-hub { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; }
  .blog-hub h1 { font-size: 2.5rem; margin-bottom: 1rem; color: var(--color-primary); text-align: center; }
  .blog-hub section { margin-bottom: 3rem; padding: 2rem; background: var(--color-bg); border-radius: 0.75rem; border: 1px solid var(--color-border); }
  .blog-hub h2 { color: var(--color-primary); margin-bottom: 1.5rem; font-size: 1.8rem; }
  .blog-hub ul { margin-bottom: 1rem; padding-left: 1.5rem; }
  .blog-hub li { margin-bottom: 0.5rem; line-height: 1.6; }
  @media (max-width: 768px) {
    .blog-hub h1 { font-size: 2rem; }
    .blog-hub section { padding: 1.5rem; }
    .blog-hub h2 { font-size: 1.5rem; }
  }
</style>
