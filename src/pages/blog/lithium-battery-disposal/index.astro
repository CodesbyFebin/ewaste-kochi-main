---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Lithium Battery Disposal";
const description = "Lithium Battery Disposal — practical guidance for Kochi households and businesses, covering battery recycling near me, UPS battery recycling, lithium battery disp...";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Lithium Battery Disposal", path: "/blog/lithium-battery-disposal/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/lithium-battery-disposal/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/lithium-battery-disposal/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "Are lithium batteries accepted?", a: "Yes, lithium-ion batteries from laptops, phones and power banks are accepted, handled separately from lead-acid types." },
  { q: "Should I send battery photos?", a: "For lithium battery disposal: yes, especially for anything swollen, leaking or damaged — it helps the team plan safe handling in advance." },
  { q: "What happens after battery collection?", a: "For lithium battery disposal: batteries are kept separate from general e-waste throughout and routed to processing appropriate to their chemistry — lead-acid and lithium are handled differently." },
  { q: "Is battery recycling free?", a: "For lithium battery disposal: feasibility for battery pickup depends on battery type and chemistry, quantity, condition and your location." },
];
---

<Layout title={title} description={description} path="/blog/lithium-battery-disposal/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Lithium Battery Disposal</h1>
  <p class="lede">Here's what you need to know, in plain terms. Laptop, phone and power bank batteries use lithium-ion cells, which carry a different risk profile from lead-acid — they can swell or, if damaged, pose a fire risk.</p>

  <CtaBar whatsappMessage="Hi, I have a question about lithium battery disposal." />

  <ul class="key-takeaways">
    <li>Keep batteries dry, upright and away from heat until collected.</li>
    <li>Lead-acid (UPS/inverter) and lithium batteries carry different risks.</li>
    <li>Swollen, leaking or damaged batteries need photos before pickup.</li>
  </ul>

  <section>
    <h2>Lithium batteries</h2>
    <p>For lithium battery disposal, laptop, phone and power bank batteries use lithium-ion cells, which carry a different risk profile from lead-acid — they can swell or, if damaged, pose a fire risk. Keep them separate from lead-acid batteries as well as from general electronics.</p>
  </section>

  <section>
    <h2>Battery pickup for offices</h2>
    <p>For lithium battery disposal, offices with UPS rooms or multiple backup batteries can request bulk pickup — mention the quantity and types so the visit can be planned for the right vehicle and handling.</p>
  </section>

  <section>
    <h2>UPS and inverter batteries</h2>
    <p>These are heavy, sealed lead-acid batteries and one of the largest single battery items most households or offices deal with. Keep them upright, note the approximate size, and mention floor or lift access if they need to be moved.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/battery-recycling/">Battery Recycling</a>
      <a href="/pickup/">Book Pickup</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/lithium-battery-disposal/" />

  <section class="final-cta">
    <h2>Have Questions About Lithium Battery Disposal?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about lithium battery disposal." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
