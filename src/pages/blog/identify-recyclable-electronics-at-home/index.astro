---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "How to Identify Recyclable Electronics at Home | Kochi Guide";
const description =
  "How to find and identify recyclable electronics in your home — which rooms to check, what counts as e-waste, and how to assess whether items should be recycled or sold.";
const datePublished = "2026-07-08";
const dateModified = "2026-07-08";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "How to Identify Recyclable Electronics at Home", path: "/blog/identify-recyclable-electronics-at-home/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/identify-recyclable-electronics-at-home/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/identify-recyclable-electronics-at-home/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  {
    q: "How do I know whether to sell or recycle a specific item?",
    a: "If the item works and is a reasonably recent model, check if it has resale value first. Contact us with the model and condition and we'll advise.",
  },
  {
    q: "What's the easiest way to check every room?",
    a: "Go room by room and check drawers, cupboards, shelves, and storage areas specifically. Electronics hide in places people forget about — especially chargers and cables.",
  },
  {
    q: "Can old appliances like a broken hair dryer be recycled?",
    a: "Contact us with details about specific appliances to check. Our primary focus is IT and consumer electronics, but we can advise on options for other items.",
  },
];
---

<Layout title={title} description={description} path="/blog/identify-recyclable-electronics-at-home/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>How to Identify Recyclable Electronics at Home</h1>
  <p class="lede">
    Most households have more e-waste than they realise — it accumulates
    in drawers, cupboards, and storage rooms. Here's a room-by-room guide
    to finding it.
  </p>

  <CtaBar whatsappMessage="Hi, I've found old electronics at home and would like to book a pickup." />

  <div class="quick-answer">
    <p class="quick-answer-label">Quick answer</p>
    <p>
      Check each room systematically — living room, bedroom, home
      office, UPS cupboard — for old phones, chargers, cables and
      forgotten devices. For each item, ask: does it work? If yes,
      consider selling it; if no, it's a recycling candidate.
    </p>
  </div>

  <ul class="key-takeaways">
    <li>Electronics hide in places people forget — chargers, cables and old remotes count too.</li>
    <li>Storage devices (laptops, desktops, drives) need data handling before recycling.</li>
    <li>UPS and inverter batteries should be flagged separately from other items.</li>
  </ul>

  <section>
    <h2>Living room</h2>
    <ul class="item-list">
      <li>Old or broken television</li>
      <li>Set-top box no longer in use</li>
      <li>DVD or Blu-ray player</li>
      <li>Sound bar or home theatre system</li>
      <li>Remote controls with dead batteries</li>
      <li>Old gaming consoles</li>
    </ul>
  </section>

  <section>
    <h2>Bedroom and study</h2>
    <ul class="item-list">
      <li>Old phone in a drawer</li>
      <li>Broken or obsolete tablet</li>
      <li>Laptop you haven't used in a year</li>
      <li>Chargers without matching devices</li>
      <li>Earphones and headphones no longer in use</li>
      <li>Power bank that no longer charges</li>
    </ul>
  </section>

  <section>
    <h2>Home office or study</h2>
    <ul class="item-list">
      <li>Desktop computer or tower</li>
      <li>Monitor</li>
      <li>Old printer or scanner</li>
      <li>External hard drives</li>
      <li>Keyboard, mouse, or webcam no longer in use</li>
      <li>Cables and adapters in a tangled pile</li>
    </ul>
    <p>Most of these have storage and need <a href="/data-destruction/">data handling</a> before recycling.</p>
  </section>

  <section>
    <h2>UPS room or electrical cupboard</h2>
    <ul class="item-list">
      <li>Old UPS unit</li>
      <li>Inverter with a dead battery</li>
      <li>Old extension cords with circuit breakers</li>
    </ul>
    <p>Flag UPS and inverter batteries separately — see <a href="/battery-recycling/">battery recycling</a>.</p>
  </section>

  <section>
    <h2>Quick rule for each item</h2>
    <p>
      For each item you find: <strong>Does it work?</strong> If yes,
      consider <a href="/sell-electronics/">selling it</a> for a
      condition-based quote. If no, it's a recycling candidate — add it
      to your pickup list.
    </p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/pickup/">Book Pickup</a>
      <a href="/sell-electronics/">Sell Electronics</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/identify-recyclable-electronics-at-home/" />
  <section class="final-cta">
    <h2>Found Old Electronics? Book a Pickup</h2>
    <p>For how to identify recyclable electronics at home, share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I've found old electronics at home and would like to book a pickup." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .item-list { display: flex; flex-direction: column; gap: 0.35rem; padding-left: 1.25rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .quick-answer { padding: 1.1rem 1.25rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-surface); margin: 1.5rem 0; }
  .quick-answer-label { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary); }
  .quick-answer p:last-child { margin: 0; color: var(--color-text); }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
