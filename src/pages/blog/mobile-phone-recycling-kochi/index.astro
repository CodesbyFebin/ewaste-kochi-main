---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DirectAnswer from "../../../components/DirectAnswer.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import LongformExpansion from "../../../components/LongformExpansion.astro";
import Sources from "../../../components/Sources.astro";
import { BUSINESS, SITE_URL } from "../../../data/site";

const title = "Mobile Phone Recycling in Kochi";
const description = "How to recycle or resell old phones in Kochi safely, including battery and data steps.";
const lastUpdated = "2026-08-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Devices & Materials", path: "/blog/devices-materials/" },
  { name: "Mobile Phone Recycling in Kochi", path: "/blog/mobile-phone-recycling-kochi/" }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": "2026-08-18",
    "dateModified": lastUpdated,
    "author": { "@type": "Organization", name: BUSINESS.legalName },
    "publisher": { "@id": `${SITE_URL}/#organization` },
    "mainEntityOfPage": `${SITE_URL}/blog/mobile-phone-recycling-kochi/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/mobile-phone-recycling-kochi/`,
    "name": title,
    "description": description,
    "dateModified": lastUpdated,
  }
];

const faqItems = [
  {
    q: "Do I reset first?",
    a: "Yes — sign out, factory reset, remove SIM and SD."
  },
  {
    q: "Can I get value?",
    a: "Working phones may be reviewed for resale."
  },
  {
    q: "Is the battery risky?",
    a: "Lithium cells are; keep swollen ones separate and flagged."
  },
  {
    q: "Is my data safe?",
    a: "Certified handling makes it irrecoverable."
  }
];

const sourceItems = [
  {
    title: "E-Waste Management Rules and related regulatory resources",
    href: "https://cpcb.nic.in/rules-6/",
    publisher: "Central Pollution Control Board",
    note: "Official CPCB resource page for e-waste rules and updates."
  },
  {
    title: "EPR E-Waste portal",
    href: "https://eprewastecpcb.in/",
    publisher: "Central Pollution Control Board",
    note: "Official portal for e-waste EPR registration and compliance workflows."
  },
  {
    title: "Kerala State Pollution Control Board",
    href: "https://kspcb.kerala.gov.in/",
    publisher: "Kerala State Pollution Control Board",
    note: "Regional enforcement and authorization for e-waste recyclers in Kerala."
  }
];
---

<Layout title={title} description={description} path="/blog/mobile-phone-recycling-kochi/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />

  <h1>Mobile Phone Recycling in Kochi</h1>

  <DirectAnswer>
    <p>To recycle a phone in Kochi, factory reset it, remove the SIM and SD cards, and send photos. Working phones may be reviewed for resale; all go through certified data handling before recycling.</p>
  </DirectAnswer>

  <CtaBar whatsappMessage="Hi, I want to recycle or resell an old phone in Kochi." />

  <section id="section-1">
    <h2>Prepare the phone</h2>
    <p>Sign out of accounts, factory reset, and remove SIM and SD cards.</p>
    <p>This prevents lock issues and data left on the device.</p>
  </section>
  <section id="section-2">
    <h2>Battery care</h2>
    <p>Keep lithium batteries around 40–60% charge for safe transport.</p>
    <p>Swollen batteries are flagged and handled separately.</p>
  </section>
  <section id="section-3">
    <h2>Resale or recycle</h2>
    <p>Working phones may be reviewed for resale and recover value.</p>
    <p>Broken ones go to material recovery with proper handling.</p>
  </section>
  <section id="section-4">
    <h2>Data assurance</h2>
    <p>Certified handling ensures your information is not recoverable.</p>
    <p>A certificate is available where compliance requires it.</p>
  </section>

  <RelatedContent href="/blog/mobile-phone-recycling-kochi/" />

  <LongformExpansion
    label="Expanded field guide"
    audience="households and businesses in Kochi"
    localIntent="mobile phone recycling in kochi with authorised pickup"
    items={["old electronics", "batteries", "cables", "data devices"]}
    themes={["Preparation", "Safety", "Compliance", "Recovery"]}
  />

  <section id="faq-section">
    <h2>Frequently asked questions</h2>
    <Faq items={faqItems} heading="Mobile Phone Recycling in Kochi FAQs" />
  </section>

  <Sources items={sourceItems} heading="Official sources & regulatory references" />
</Layout>

<style>
  .blog-hub { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; }
  .blog-hub h1 { font-size: 2.5rem; margin-bottom: 1rem; color: var(--color-primary); text-align: center; }
  .blog-hub section { margin-bottom: 3rem; padding: 2rem; background: var(--color-bg); border-radius: 0.75rem; border: 1px solid var(--color-border); }
  .blog-hub h2 { color: var(--color-primary); margin-bottom: 1.5rem; font-size: 1.8rem; }
  .blog-hub ul { margin-bottom: 1rem; padding-left: 1.5rem; }
  .blog-hub li { margin-bottom: 0.5rem; line-height: 1.6; }
  @media (max-width: 768px) {
    .blog-hub h1 { font-size: 2rem; }
    .blog-hub section { padding: 1.5rem; }
    .blog-hub h2 { font-size: 1.5rem; }
  }
</style>
