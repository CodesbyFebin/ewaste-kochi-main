const dateModified = "2026-08-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "How to Sell Computers for Cash", path: "/blog/how-to-sell-computers-for-cash/" },
