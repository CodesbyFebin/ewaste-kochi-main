---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "What Details to Send on WhatsApp";
const description = "What Details to Send on WhatsApp — practical guidance for Kochi households and businesses, covering prepare electronics, e-waste pickup checklist, safety.";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "What Details to Send on WhatsApp", path: "/blog/what-details-to-send-on-whatsapp/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/what-details-to-send-on-whatsapp/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/what-details-to-send-on-whatsapp/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "What details should I send?", a: "Item list, rough quantity, your location, and photos of anything unusual." },
  { q: "What should I avoid?", a: "For what details to send on whatsapp: avoid mixing batteries with general electronics and leaving data unwiped on devices you're handing over." },
  { q: "What affects feasibility?", a: "For what details to send on whatsapp: whether pickup is feasible depends on the specific item type, quantity, condition and your location." },
  { q: "What should offices prepare?", a: "For what details to send on whatsapp: a rough asset list, data-bearing devices flagged, and access details for the pickup location." },
];
---

<Layout title={title} description={description} path="/blog/what-details-to-send-on-whatsapp/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>What Details to Send on WhatsApp</h1>
  <p class="lede">Here's what you need to know, in plain terms. A rough item list, your location, and photos of anything damaged, bulky or battery-related — sending this together in one message gets the fastest response.</p>

  <CtaBar whatsappMessage="Hi, I have a question about what details to send on whatsapp." />

  <ul class="key-takeaways">
    <li>Data and battery preparation matter more than exact item sorting.</li>
    <li>Photos of damaged, bulky or battery items speed up confirmation.</li>
    <li>You can add items after booking — just mention them before pickup day.</li>
  </ul>

  <section>
    <h2>What to send on WhatsApp</h2>
    <p>For what details to send on whatsapp, a rough item list, your location, and photos of anything damaged, bulky or battery-related — sending this together in one message gets the fastest response.</p>
  </section>

  <section>
    <h2>Preparation at home</h2>
    <p>For what details to send on whatsapp, gather items in one accessible place, separate batteries, and back up devices with storage — a single afternoon of preparation is usually enough for a standard household pickup.</p>
  </section>

  <section>
    <h2>Preparation for offices</h2>
    <p>For what details to send on whatsapp, a rough asset list, labelled data-bearing devices, and clear access details (floor, loading dock) help a business pickup run smoothly, especially for larger quantities.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/pickup/">Book Pickup</a>
      <a href="/battery-recycling/">Battery Recycling</a>
      <a href="/data-destruction/">Data Destruction</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/what-details-to-send-on-whatsapp/" />

  <section class="final-cta">
    <h2>Have Questions About What Details to Send on WhatsApp?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about what details to send on whatsapp." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
