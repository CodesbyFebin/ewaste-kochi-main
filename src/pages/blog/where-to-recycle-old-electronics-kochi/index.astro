    display: inline-flex;
    min-height: 38px;
    align-items: center;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 0.45rem;
    color: var(--color-primary);
    font-weight: 800;
    text-decoration: none;
    background: var(--color-surface);
  }
