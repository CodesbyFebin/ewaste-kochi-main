---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "How to Prepare Mixed Electronics";
const description = "How to Prepare Mixed Electronics — practical guidance for Kochi households and businesses, covering prepare electronics, e-waste pickup checklist, safety.";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "How to Prepare Mixed Electronics", path: "/blog/how-to-prepare-mixed-electronics/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/how-to-prepare-mixed-electronics/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/how-to-prepare-mixed-electronics/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "Can I include mixed electronics?", a: "Yes, a single pickup can cover a mix of item types." },
  { q: "Can I prepare items for resale?", a: "Yes, the same preparation — wiping data, honest condition notes, photos — applies whether you're recycling or selling." },
  { q: "What should offices prepare?", a: "For how to prepare mixed electronics: a rough asset list, data-bearing devices flagged, and access details for the pickup location." },
  { q: "What should homes prepare?", a: "Items gathered in one place, batteries separated, and data wiped from anything with storage." },
];
---

<Layout title={title} description={description} path="/blog/how-to-prepare-mixed-electronics/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>How to Prepare Mixed Electronics</h1>
  <p class="lede">A step-by-step answer, covering what actually matters and what you can skip. Back up and wipe data-bearing devices, separate batteries into their own bag, flag anything damaged or bulky, and note your pickup address and preferred timeframe.</p>

  <CtaBar whatsappMessage="Hi, I have a question about how to prepare mixed electronics." />

  <ul class="key-takeaways">
    <li>A rough list (type + quantity) is enough; serial numbers aren't needed.</li>
    <li>You can add items after booking — just mention them before pickup day.</li>
    <li>Photos of damaged, bulky or battery items speed up confirmation.</li>
  </ul>

  <section>
    <h2>The essentials</h2>
    <p>For how to prepare mixed electronics, back up and wipe data-bearing devices, separate batteries into their own bag, flag anything damaged or bulky, and note your pickup address and preferred timeframe. Not everything on a general checklist applies to every pickup.</p>
  </section>

  <section>
    <h2>What to send on WhatsApp</h2>
    <p>A rough item list, your location, and photos of anything damaged, bulky or battery-related — sending this together in one message gets the fastest response.</p>
  </section>

  <section>
    <h2>Preparation for offices</h2>
    <p>For how to prepare mixed electronics, a rough asset list, labelled data-bearing devices, and clear access details (floor, loading dock) help a business pickup run smoothly, especially for larger quantities.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/pickup/">Book Pickup</a>
      <a href="/battery-recycling/">Battery Recycling</a>
      <a href="/data-destruction/">Data Destruction</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/how-to-prepare-mixed-electronics/" />

  <section class="final-cta">
    <h2>Have Questions About How to Prepare Mixed Electronics?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about how to prepare mixed electronics." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
