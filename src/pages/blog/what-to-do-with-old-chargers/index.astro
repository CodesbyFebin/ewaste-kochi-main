---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "What to Do with Old Chargers";
const description = "What to Do with Old Chargers — practical guidance for Kochi households and businesses, covering cable recycling, charger recycling, copper wire scrap.";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "What to Do with Old Chargers", path: "/blog/what-to-do-with-old-chargers/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/what-to-do-with-old-chargers/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/what-to-do-with-old-chargers/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "Can cables be included with other e-waste?", a: "Yes, cables can be part of a general household or office pickup." },
  { q: "What affects cable quote?", a: "For what to do with old chargers: quantity and copper content mainly — condition matters less than for other electronics." },
  { q: "Can chargers be recycled?", a: "Yes, including chargers without a matching device." },
  { q: "What happens after collection?", a: "For what to do with old chargers: cables are sorted and processed for material recovery, primarily copper and other metals." },
];
---

<Layout title={title} description={description} path="/blog/what-to-do-with-old-chargers/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>What to Do with Old Chargers</h1>
  <p class="lede">Here's what you need to know, in plain terms. Old chargers and adapters, even without a matching device, are accepted as standard e-waste — no need to find their original device first.</p>

  <CtaBar whatsappMessage="Hi, I have a question about what to do with old chargers." />

  <ul class="key-takeaways">
    <li>Cables, chargers and adapters are accepted on their own, no device needed.</li>
    <li>Copper content gives cables modest scrap value, more so in bulk.</li>
    <li>No need to sort cables by type before pickup — general grouping is enough.</li>
  </ul>

  <section>
    <h2>Chargers and adapters</h2>
    <p>For what to do with old chargers, old chargers and adapters, even without a matching device, are accepted as standard e-waste — no need to find their original device first.</p>
  </section>

  <section>
    <h2>The home cable drawer</h2>
    <p>For what to do with old chargers, most households accumulate a drawer of old cables and chargers for devices long gone — this is one of the simplest items to include in a pickup since there's no data or battery concern.</p>
  </section>

  <section>
    <h2>Bulk cable pickup for offices</h2>
    <p>An accumulated tangle of network cables, power cords and adapters from an office move or upgrade is a common single pickup — a rough quantity estimate is enough.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/recycling/">E-Waste Recycling</a>
      <a href="/e-waste-scrap-prices-kochi/">Scrap Price Guide</a>
      <a href="/pickup/">Pickup</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/what-to-do-with-old-chargers/" />

  <section class="final-cta">
    <h2>Have Questions About What to Do with Old Chargers?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about what to do with old chargers." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
