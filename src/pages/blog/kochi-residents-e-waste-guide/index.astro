---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DirectAnswer from "../../../components/DirectAnswer.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import LongformExpansion from "../../../components/LongformExpansion.astro";
import Sources from "../../../components/Sources.astro";
import { BUSINESS, SITE_URL } from "../../../data/site";

const title = "Kochi Residents' E-Waste Guide";
const description = "A practical e-waste guide for Kochi residents: what to do with old electronics at home.";
const lastUpdated = "2026-08-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "General E-Waste", path: "/blog/general-ewaste/" },
  { name: "Kochi Residents' E-Waste Guide", path: "/blog/kochi-residents-e-waste-guide/" }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": "2026-08-18",
    "dateModified": lastUpdated,
    "author": { "@type": "Organization", name: BUSINESS.legalName },
    "publisher": { "@id": `${SITE_URL}/#organization` },
    "mainEntityOfPage": `${SITE_URL}/blog/kochi-residents-e-waste-guide/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/kochi-residents-e-waste-guide/`,
    "name": title,
    "description": description,
    "dateModified": lastUpdated,
  }
];

const faqItems = [
  {
    q: "Home routine?",
    a: "One box, batteries out, photos ready."
  },
  {
    q: "Data devices?",
    a: "Wipe or destroy; certified available."
  },
  {
    q: "Book how?",
    a: "List and photos; team confirms route."
  },
  {
    q: "Apartments?",
    a: "Batch collections; share details."
  }
];

const sourceItems = [
  {
    title: "E-Waste Management Rules and related regulatory resources",
    href: "https://cpcb.nic.in/rules-6/",
    publisher: "Central Pollution Control Board",
    note: "Official CPCB resource page for e-waste rules and updates."
  },
  {
    title: "EPR E-Waste portal",
    href: "https://eprewastecpcb.in/",
    publisher: "Central Pollution Control Board",
    note: "Official portal for e-waste EPR registration and compliance workflows."
  },
  {
    title: "Kerala State Pollution Control Board",
    href: "https://kspcb.kerala.gov.in/",
    publisher: "Kerala State Pollution Control Board",
    note: "Regional enforcement and authorization for e-waste recyclers in Kerala."
  }
];
---

<Layout title={title} description={description} path="/blog/kochi-residents-e-waste-guide/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />

  <h1>Kochi Residents' E-Waste Guide</h1>

  <DirectAnswer>
    <p>Kochi residents can manage e-waste by collecting items dry, separating batteries, wiping data devices, and booking authorised pickup. Never mix electronics with household garbage.</p>
  </DirectAnswer>

  <CtaBar whatsappMessage="Hi, I'm a Kochi resident wanting a simple e-waste routine." />

  <section id="section-1">
    <h2>At-home routine</h2>
    <p>One e-waste box, batteries kept out, photos when ready.</p>
    <p>Small habits prevent a cupboard of forgotten gadgets.</p>
  </section>
  <section id="section-2">
    <h2>Data devices</h2>
    <p>Wipe or plan destruction for phones and computers.</p>
    <p>Certified destruction is available.</p>
  </section>
  <section id="section-3">
    <h2>Book pickup</h2>
    <p>Send list and photos; the team confirms the route.</p>
    <p>Free for most household items.</p>
  </section>
  <section id="section-4">
    <h2>Apartments</h2>
    <p>Societies can batch collections for ease.</p>
    <p>Share building and lift details.</p>
  </section>

  <RelatedContent href="/blog/kochi-residents-e-waste-guide/" />

  <LongformExpansion
    label="Expanded field guide"
    audience="households and businesses in Kochi"
    localIntent="kochi residents' e-waste guide with authorised pickup"
    items={["old electronics", "batteries", "cables", "data devices"]}
    themes={["Preparation", "Safety", "Compliance", "Recovery"]}
  />

  <section id="faq-section">
    <h2>Frequently asked questions</h2>
    <Faq items={faqItems} heading="Kochi Residents' E-Waste Guide FAQs" />
  </section>

  <Sources items={sourceItems} heading="Official sources & regulatory references" />
</Layout>

<style>
  .blog-hub { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; }
  .blog-hub h1 { font-size: 2.5rem; margin-bottom: 1rem; color: var(--color-primary); text-align: center; }
  .blog-hub section { margin-bottom: 3rem; padding: 2rem; background: var(--color-bg); border-radius: 0.75rem; border: 1px solid var(--color-border); }
  .blog-hub h2 { color: var(--color-primary); margin-bottom: 1.5rem; font-size: 1.8rem; }
  .blog-hub ul { margin-bottom: 1rem; padding-left: 1.5rem; }
  .blog-hub li { margin-bottom: 0.5rem; line-height: 1.6; }
  @media (max-width: 768px) {
    .blog-hub h1 { font-size: 2rem; }
    .blog-hub section { padding: 1.5rem; }
    .blog-hub h2 { font-size: 1.5rem; }
  }
</style>
