---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Old Electronics Recycling for First-Time Users in Kochi";
const description =
  "A plain-language guide to recycling old electronics for the first time in Kochi — what to expect, how to book, what to prepare, and common questions answered.";
const datePublished = "2026-07-08";
const dateModified = "2026-07-08";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Old Electronics Recycling for First-Time Users in Kochi", path: "/blog/old-electronics-recycling-first-time-users/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/old-electronics-recycling-first-time-users/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/old-electronics-recycling-first-time-users/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  {
    q: "Is there anything complicated about the first pickup?",
    a: "Not really. The process is: message us with what you have and your location, agree a slot, and hand items over at pickup. That's the whole thing for most household pickups.",
  },
  {
    q: "Do I need to sort items into categories before the team arrives?",
    a: "Keep batteries separate from other items, and flag anything damaged or swollen. Beyond that, basic grouping is enough — the team handles sorting.",
  },
  {
    q: "What if I change my mind after booking?",
    a: "Contact us to reschedule. The earlier you let us know, the easier it is to rearrange the slot.",
  },
  {
    q: "Is the process the same for large items like a TV?",
    a: "Yes, but flag large or heavy items when booking so the team can plan the visit accordingly.",
  },
];
---

<Layout title={title} description={description} path="/blog/old-electronics-recycling-first-time-users/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Old Electronics Recycling for First-Time Users</h1>
  <p class="lede">
    If you've never recycled electronics before, the process is simpler
    than most people expect. Here's everything you need to know for your
    first pickup in Kochi.
  </p>

  <CtaBar whatsappMessage="Hi, it's my first time recycling electronics and I'd like to book a pickup." />

  <div class="quick-answer">
    <p class="quick-answer-label">Quick answer</p>
    <p>
      First-time recycling is simple: message us a rough item list and
      your location on WhatsApp, back up and wipe any data-bearing
      devices, keep batteries separate, and we'll confirm a free
      doorstep pickup slot. No drop-off point needed.
    </p>
  </div>

  <ul class="key-takeaways">
    <li>You never need to find a drop-off point — the team collects from your door.</li>
    <li>Data wipe and battery separation are the only steps that really matter.</li>
    <li>Standard household pickup is free for qualifying quantities.</li>
  </ul>

  <section>
    <h2>You don't need to go anywhere</h2>
    <p>
      The biggest misconception about e-waste recycling is that you need
      to find a drop-off point. You don't. Our team collects directly from
      your home or office across Kochi and Ernakulam district — you just
      need to have the items accessible when we arrive.
    </p>
  </section>

  <section>
    <h2>How to start</h2>
    <ol class="steps">
      <li>Make a rough list of what you have — type and condition, not serial numbers</li>
      <li>Note your location and any building access details</li>
      <li>Message us on WhatsApp with the list, location, and photos if you have them</li>
      <li>We'll confirm feasibility and any quote details, then agree a pickup slot</li>
    </ol>
  </section>

  <section>
    <h2>What to prepare before pickup</h2>
    <ul class="check-list">
      <li>Back up any data you need from phones and computers</li>
      <li>Factory reset phones and tablets; wipe computer drives if possible</li>
      <li>Remove SIM cards and memory cards</li>
      <li>Put batteries in a separate bag, away from other items</li>
      <li>Gather everything in one accessible place</li>
    </ul>
  </section>

  <section>
    <h2>What you don't need to do</h2>
    <p>
      You don't need to disassemble anything, clean devices, figure out
      what's valuable, or sort by material type. That's handled after
      collection.
    </p>
  </section>

  <section>
    <h2>Is it free?</h2>
    <p>
      Standard doorstep pickup is free for qualifying quantities of
      household e-waste. If some of your devices have resale or scrap
      value, you may receive payment rather than paying for collection —
      this depends on what you have and its condition. We'll confirm
      everything upfront before pickup.
    </p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/pickup/">Book Pickup</a>
      <a href="/recycling/">E-Waste Recycling</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/old-electronics-recycling-first-time-users/" />
  <section class="final-cta">
    <h2>Ready for Your First Pickup?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, it's my first time recycling electronics and I'd like to book a pickup." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .steps { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1.5rem; }
  .check-list { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1.25rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .quick-answer { padding: 1.1rem 1.25rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-surface); margin: 1.5rem 0; }
  .quick-answer-label { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary); }
  .quick-answer p:last-child { margin: 0; color: var(--color-text); }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
