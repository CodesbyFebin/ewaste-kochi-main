---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Enterprise IT Asset Pickup Planning";
const description = "Enterprise IT Asset Pickup Planning — practical guidance for Kochi households and businesses, covering server recycling, network equipment disposal, enterprise IT...";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Enterprise IT Asset Pickup Planning", path: "/blog/enterprise-it-asset-pickup-planning/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/enterprise-it-asset-pickup-planning/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/enterprise-it-asset-pickup-planning/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "How do I request server pickup?", a: "Start with a rough inventory sent on WhatsApp; we'll help refine scope and scheduling from there." },
  { q: "Can offices request server pickup?", a: "Yes, and planning ahead helps — let us know your expected timeline along with device types and quantities." },
  { q: "Should I prepare asset list?", a: "It helps — device type, model and quantity is usually enough detail." },
  { q: "What affects pickup feasibility?", a: "Pickup feasibility depends on item type, quantity, condition and location." },
];
---

<Layout title={title} description={description} path="/blog/enterprise-it-asset-pickup-planning/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Enterprise IT Asset Pickup Planning</h1>
  <p class="lede">Here's what you need to know, in plain terms. Switches, routers and firewalls are accepted alongside servers — mention configuration data concerns so the right handling is applied.</p>

  <CtaBar whatsappMessage="Hi, I have a question about enterprise it asset pickup planning." />

  <ul class="key-takeaways">
    <li>Even small offices with just a few servers can request pickup.</li>
    <li>An asset list streamlines server room cleanouts.</li>
    <li>Data destruction is available for business-critical storage.</li>
  </ul>

  <section>
    <h2>Network equipment specifically</h2>
    <p>Switches, routers and firewalls are accepted alongside servers — mention configuration data concerns so the right handling is applied.</p>
  </section>

  <section>
    <h2>For smaller setups</h2>
    <p>You don't need enterprise-scale quantities to request server or network equipment pickup — even a few retired servers or switches from a small office are welcome.</p>
  </section>

  <section>
    <h2>Server hardware value</h2>
    <p>Some server hardware retains resale or component value depending on age and specifications — mention this if you'd like a quote alongside recycling.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/server-recycling-kochi/">Server Recycling</a>
      <a href="/itad/">ITAD for Business</a>
      <a href="/data-destruction/">Data Destruction</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/enterprise-it-asset-pickup-planning/" />

  <section class="final-cta">
    <h2>Have Questions About Enterprise IT Asset Pickup Planning?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about enterprise it asset pickup planning." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
