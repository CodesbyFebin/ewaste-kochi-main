const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Industrial E-Waste Disposal", path: "/blog/industrial-e-waste-disposal/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Industrial E-Waste Disposal | Manufacturing & Heavy Equipment | Ewaste Kochi",
