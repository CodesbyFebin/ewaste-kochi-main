    },
    "mainEntityOfPage": "https://www.ewastekochi.com/blog/industrial-e-waste-disposal/",
    "faq": [
      {
        "@type": "Question",
        "name": "What industrial equipment is accepted?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We accept PLCs, control panels, sensors, power electronics, telecom gear, and associated batteries. Confirm specific items when booking."
        }
      },
      {
        "@type": "Question",
        "name": "Are hazardous industrial components accepted?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Capacitors, transformers, and other hazardous components require special handling. Flag these when booking so our team can prepare appropriate PPE and transport."
        }
      },
      {
        "@type": "Question",
