const title = "How to Recycle Laptop in India | Step-by-Step Guide | Ewaste Kochi";
const description = "Step-by-step guide to recycling laptops in India: collect, contact an authorized recycler, schedule pickup, and get your Certificate of Recycling.";
const datePublished = "2026-08-18";
const dateModified = "2026-08-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "How to Recycle Laptop in India", path: "/blog/how-to-recycle-laptop-in-india/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "headline": "How to Recycle Laptop in India | Step-by-Step Guide | Ewaste Kochi",
    "description": "Step-by-step guide to recycling laptops in India: collect, contact an authorized recycler, schedule pickup, and get your Certificate of Recycling.",
    "datePublished": "2026-08-18",
    "dateModified": "2026-08-18",
    "author": {
      "@type": "Organization",
      "name": "E-Waste Kochi"
    },
    "publisher": {
      "@id": "https://www.ewastekochi.com/#organization"
    },
    "mainEntityOfPage": "https://www.ewastekochi.com/blog/how-to-recycle-laptop-in-india/",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Step 1: Gather and Sort",
        "text": "Collect all non-functional laptops, chargers, and accessories in one place. Remove any removable storage (SD cards, external drives) and note any physical damage or battery swelling — flag this when booking."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Step 2: Back Up and Sign Out",
        "text": "Before handover, back up any remaining data and perform a factory reset. For business laptops, coordinate with your IT team to ensure no residual corporate data remains on the device."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Step 3: Book a Pickup",
        "text": "Contact Ewaste Kochi via WhatsApp or phone. Provide the number of devices, approximate types, and your address. Our team will confirm pickup timing and provide a reference number for tracking."
      }
    ],
    "faq": [
      {
        "@type": "Question",
        "name": "How long does laptop recycling take?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pickup is typically scheduled within 24-48 hours. Processing and certification take 3-5 business days after collection."
        }
      },
      {
        "@type": "Question",
        "name": "Do I need to remove the hard drive?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Not required. Our team performs certified data destruction during processing. However, you may remove drives if you prefer personal handling."
        }
      },
      {
        "@type": "Question",
        "name": "Is there a charge for laptop recycling?",
        "acceptedAnswer": {
          "@type": "Answer",
