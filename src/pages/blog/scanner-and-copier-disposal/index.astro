---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Scanner and Copier Disposal";
const description = "Scanner and Copier Disposal — practical guidance for Kochi households and businesses, covering printer recycling, scanner disposal, router recycling.";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Scanner and Copier Disposal", path: "/blog/scanner-and-copier-disposal/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/scanner-and-copier-disposal/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/scanner-and-copier-disposal/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "Are keyboards accepted?", a: "Yes, keyboards and mice are accepted individually or with a computer pickup." },
  { q: "What affects pickup feasibility?", a: "Feasibility for scanner and copier disposal depends on item type, quantity, condition and your location." },
  { q: "Are scanners accepted?", a: "Yes, scanners are accepted alongside printers and other office equipment." },
  { q: "How do I book?", a: "Message the item types, rough quantity and location on WhatsApp." },
];
---

<Layout title={title} description={description} path="/blog/scanner-and-copier-disposal/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Scanner and Copier Disposal</h1>
  <p class="lede">Here's what you need to know, in plain terms. These are accepted individually or as part of an office clearout.</p>

  <CtaBar whatsappMessage="Hi, I have a question about scanner and copier disposal." />

  <ul class="key-takeaways">
    <li>Mixed peripherals can be collected together, no need to sort by type.</li>
    <li>Routers can store Wi-Fi passwords — factory reset before handover.</li>
    <li>Cartridges don't need to be removed first, but it helps if easily done.</li>
  </ul>

  <section>
    <h2>Printers, scanners and copiers</h2>
    <p>These are accepted individually or as part of an office clearout. Ink and toner cartridges can stay installed if not easily removable — mention this when booking.</p>
  </section>

  <section>
    <h2>Keyboards, mice and small peripherals</h2>
    <p>These are accepted alongside larger equipment or on their own — no need to sort by type before pickup, general grouping is enough.</p>
  </section>

  <section>
    <h2>Routers and network devices</h2>
    <p>Routers can store Wi-Fi passwords and configuration data — a factory reset through the settings page clears this before the device is handed over.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/recycling/">E-Waste Recycling</a>
      <a href="/itad/">ITAD for Business</a>
      <a href="/pickup/">Pickup</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/scanner-and-copier-disposal/" />

  <section class="final-cta">
    <h2>Have Questions About Scanner and Copier Disposal?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about scanner and copier disposal." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
