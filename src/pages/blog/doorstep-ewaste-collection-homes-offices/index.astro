---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Doorstep E-Waste Collection for Homes and Offices in Kochi";
const description =
  "How doorstep e-waste collection works for both homes and offices in Kochi — what's different about each, what to prepare, and how to book efficiently.";
const datePublished = "2026-07-08";
const dateModified = "2026-07-08";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Doorstep E-Waste Collection for Homes and Offices in Kochi", path: "/blog/doorstep-ewaste-collection-homes-offices/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/doorstep-ewaste-collection-homes-offices/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/doorstep-ewaste-collection-homes-offices/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  {
    q: "Can a small office use the same service as a large corporate?",
    a: "Yes — the same doorstep pickup is available for small offices, small businesses, and large corporate accounts.",
  },
  {
    q: "Can a home pickup handle both household items and a few old office computers?",
    a: "Yes — mixed pickups covering household and office items are common.",
  },
  {
    q: "What if an office has strict security and visitor policies?",
    a: "Mention access requirements when booking. We work within standard building security procedures.",
  },
];
---

<Layout title={title} description={description} path="/blog/doorstep-ewaste-collection-homes-offices/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Doorstep E-Waste Collection for Homes and Offices</h1>
  <p class="lede">
    Doorstep pickup works for both households and offices — the core
    process is the same, but offices often have different preparation
    needs. Here's how each works.
  </p>

  <CtaBar whatsappMessage="Hi, I'd like to book a doorstep e-waste collection for my home / office." />

  <div class="quick-answer">
    <p class="quick-answer-label">Quick answer</p>
    <p>
      Doorstep e-waste collection works the same way for homes and
      offices in Kochi — message your item list and location, agree a
      slot, and the team collects directly from your door. Offices
      typically need a bit more planning: a rough asset list, access
      details, and any data destruction requirements confirmed upfront.
    </p>
  </div>

  <ul class="key-takeaways">
    <li>The core booking process is identical for homes and offices.</li>
    <li>Offices benefit from sharing a rough asset list before the visit.</li>
    <li>Business devices usually have stricter data-handling needs than personal ones.</li>
    <li>Larger jobs may need documented access details (security, loading bay).</li>
  </ul>

  <section>
    <h2>How household pickup works</h2>
    <p>
      Message us with your item list and address. The team collects from
      your door at an agreed slot. Typical household pickups cover phones,
      laptops, a TV or monitor, cables, batteries, and mixed small items.
      Data wiped, batteries separated, all handled at collection.
      See <a href="/pickup/">pickup</a>.
    </p>
  </section>

  <section>
    <h2>How office pickup works</h2>
    <p>
      Office pickups often involve larger quantities — multiple workstations,
      servers, networking gear, bulk batteries. For office pickups, share
      a rough asset list in advance, confirm access details, and flag any
      data destruction requirements. For larger office IT asset jobs, see
      <a href="/itad/">ITAD</a> and
      <a href="/services/it-asset-inventory-audit/">IT asset inventory
      audit</a>.
    </p>
  </section>

  <section>
    <h2>Key differences to plan for</h2>
    <table class="compare-table">
      <thead>
        <tr><th>Item</th><th>Home</th><th>Office</th></tr>
      </thead>
      <tbody>
        <tr><td>Typical quantity</td><td>Small–medium</td><td>Medium–large</td></tr>
        <tr><td>Data requirements</td><td>Personal devices</td><td>Business devices — more critical</td></tr>
        <tr><td>Asset list needed?</td><td>Usually not</td><td>Helpful for bulk</td></tr>
        <tr><td>Documentation</td><td>Optional</td><td>Often needed</td></tr>
        <tr><td>Access</td><td>Confirm floor/apartment</td><td>Confirm security, loading bay</td></tr>
      </tbody>
    </table>
  </section>  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/data-destruction/">Data Destruction</a>
      <a href="/itad/">ITAD for Business</a>
    </div>
  </section>



  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/doorstep-ewaste-collection-homes-offices/" />
  <section class="final-cta">
    <h2>Have Questions About Doorstep E-Waste Collection for Homes and Offices?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I'd like to book a doorstep e-waste collection for my home / office." compact />
  </section>


  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .compare-table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.9rem; }
  .compare-table th, .compare-table td { border: 1px solid var(--color-border); padding: 0.5rem 0.75rem; text-align: left; }
  .compare-table th { background: var(--color-surface); font-weight: 700; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .quick-answer { padding: 1.1rem 1.25rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-surface); margin: 1.5rem 0; }
  .quick-answer-label { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary); }
  .quick-answer p:last-child { margin: 0; color: var(--color-text); }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
