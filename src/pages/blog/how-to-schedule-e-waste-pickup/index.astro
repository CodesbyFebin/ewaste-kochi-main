      "name": "E-Waste Kochi"
    },
    "publisher": {
      "@id": "https://www.ewastekochi.com/#organization"
    },
    "mainEntityOfPage": "https://www.ewastekochi.com/blog/how-to-schedule-e-waste-pickup/",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Step 1: List Your Items",
        "text": "Make a quick inventory of the devices you want to dispose of — laptops, phones, TVs, batteries, appliances. Note quantities and any special conditions such as broken screens, swollen batteries, or server equipment."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Step 2: Book Online or by Phone",
