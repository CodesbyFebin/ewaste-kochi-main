const dateModified = "2026-08-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "How to Schedule E-Waste Pickup", path: "/blog/how-to-schedule-e-waste-pickup/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "headline": "How to Schedule E-Waste Pickup | Free Doorstep Collection | Ewaste Kochi",
    "description": "Schedule e-waste pickup in 3 steps: list items, share your address, and confirm timing. Free pickup for household quantities in Kochi and Ernakulam.",
    "datePublished": "2026-08-18",
    "dateModified": "2026-08-18",
    "author": {
