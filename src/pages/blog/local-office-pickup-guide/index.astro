---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Local Office Pickup Guide";
const description = "Local Office Pickup Guide — practical guidance for Kochi households and businesses, covering e-waste pickup Kakkanad, Kalamassery, Ernakulam South.";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Local Office Pickup Guide", path: "/blog/local-office-pickup-guide/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/local-office-pickup-guide/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/local-office-pickup-guide/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "Is Infopark nearby pickup possible?", a: "Yes, the Infopark and surrounding Kakkanad business area is covered for both office and residential pickups." },
  { q: "Does quantity affect pickup?", a: "Pickup feasibility depends on item type, quantity, condition and location." },
  { q: "Are local pages available?", a: "Yes, for Kakkanad, Kalamassery and Ernakulam South — other areas are confirmed individually on request." },
  { q: "Can offices request pickup?", a: "Yes, business addresses are covered the same way as residential ones." },
];
---

<Layout title={title} description={description} path="/blog/local-office-pickup-guide/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Local Office Pickup Guide</h1>
  <p class="lede">What this looks like specifically for your situation, not just general advice. Both residential and commercial pickups are supported across the service area — include building name and floor, or business address, when you message.</p>

  <CtaBar whatsappMessage="Hi, I have a question about local office pickup guide." />

  <ul class="key-takeaways">
    <li>Most Kochi-metro addresses are serviceable — message to confirm yours.</li>
    <li>Kakkanad, Kalamassery and Ernakulam South have dedicated location pages.</li>
    <li>A precise address or WhatsApp location pin speeds up confirmation.</li>
  </ul>

  <section>
    <h2>Apartments and offices</h2>
    <p>Both residential and commercial pickups are supported across the service area — include building name and floor, or business address, when you message.</p>
  </section>

  <section>
    <h2>Ernakulam South</h2>
    <p>Ernakulam South is a core service area with a dedicated location page, including areas near the railway station and central Ernakulam.</p>
  </section>

  <section>
    <h2>Checking your specific area</h2>
    <p>The fastest way to confirm coverage is to message your address or area name on WhatsApp — most Kochi-metro addresses are serviceable, and confirmation is usually quick.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/locations/">Locations</a>
      <a href="/locations/kakkanad/">Kakkanad Location</a>
      <a href="/locations/kalamassery/">Kalamassery</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/local-office-pickup-guide/" />

  <section class="final-cta">
    <h2>Have Questions About Local Office Pickup Guide?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about local office pickup guide." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
