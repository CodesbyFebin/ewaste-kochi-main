---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "Safety Guide for Heavy Electronics";
const description = "Safety Guide for Heavy Electronics — practical guidance for Kochi households and businesses, covering prepare electronics, e-waste pickup checklist, safety.";
const datePublished = "2026-07-14";
const dateModified = "2026-07-14";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Safety Guide for Heavy Electronics", path: "/blog/safety-guide-for-heavy-electronics/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/safety-guide-for-heavy-electronics/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/safety-guide-for-heavy-electronics/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "Can I include mixed electronics?", a: "Yes, a single pickup can cover a mix of item types." },
  { q: "Can heavy items be collected?", a: "Yes, with advance notice — mention size, weight and access details." },
  { q: "What affects feasibility?", a: "Whether pickup is feasible depends on the specific item type, quantity, condition and your location." },
  { q: "How do I reduce pickup delays?", a: "Send a complete first message — item list, location and photos — rather than partial details followed by back-and-forth." },
];
---

<Layout title={title} description={description} path="/blog/safety-guide-for-heavy-electronics/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Safety Guide for Heavy Electronics</h1>
  <p class="lede">Here's what you need to know, in plain terms. Any device with storage should be backed up and wiped, or flagged for data destruction, before it leaves your hands — this applies to laptops, phones, hard drives and some office equipment alike.</p>

  <CtaBar whatsappMessage="Hi, I have a question about safety guide for heavy electronics." />

  <ul class="key-takeaways">
    <li>A rough list (type + quantity) is enough; serial numbers aren't needed.</li>
    <li>You can add items after booking — just mention them before pickup day.</li>
    <li>Photos of damaged, bulky or battery items speed up confirmation.</li>
  </ul>

  <section>
    <h2>Data safety before handover</h2>
    <p>Any device with storage should be backed up and wiped, or flagged for data destruction, before it leaves your hands — this applies to laptops, phones, hard drives and some office equipment alike.</p>
  </section>

  <section>
    <h2>What to send on WhatsApp</h2>
    <p>A rough item list, your location, and photos of anything damaged, bulky or battery-related — sending this together in one message gets the fastest response.</p>
  </section>

  <section>
    <h2>The essentials</h2>
    <p>Back up and wipe data-bearing devices, separate batteries into their own bag, flag anything damaged or bulky, and note your pickup address and preferred timeframe. Not everything on a general checklist applies to every pickup.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/pickup/">Book Pickup</a>
      <a href="/battery-recycling/">Battery Recycling</a>
      <a href="/data-destruction/">Data Destruction</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/safety-guide-for-heavy-electronics/" />

  <section class="final-cta">
    <h2>Have Questions About Safety Guide for Heavy Electronics?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about safety guide for heavy electronics." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
