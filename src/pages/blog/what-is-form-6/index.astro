const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "What Is Form 6?", path: "/blog/what-is-form-6/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "What Is Form 6? | E-Waste CPCB Form Explained | Ewaste Kochi",
