---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "E-Waste Pickup for Housing Societies in Kochi | Community Guide";
const description =
  "How housing societies and apartment communities in Kochi can organise a combined e-waste pickup — coordination, what to collect, battery safety, and how to book.";
const datePublished = "2026-07-08";
const dateModified = "2026-07-08";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "E-Waste Pickup for Housing Societies in Kochi", path: "/blog/ewaste-pickup-housing-societies-kochi/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/ewaste-pickup-housing-societies-kochi/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/ewaste-pickup-housing-societies-kochi/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  {
    q: "Can a single society flat book individual pickup, or does it have to be combined?",
    a: "Individual flats can book their own pickup. A combined society collection is more efficient for larger quantities but not required.",
  },
  {
    q: "How does payment work for a society collection drive?",
    a: "Any scrap value from devices is assessed at collection. Combined pickup logistics are discussed when booking.",
  },
  {
    q: "Can the society association contact us to arrange a dedicated visit?",
    a: "Yes. Contact us with an estimated item count and the society address to discuss scheduling a dedicated collection day.",
  },
];
---

<Layout title={title} description={description} path="/blog/ewaste-pickup-housing-societies-kochi/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>E-Waste Pickup for Housing Societies in Kochi</h1>
  <p class="lede">
    A housing society or apartment complex can make e-waste pickup much
    more efficient by coordinating a combined collection — one visit
    covering multiple households, organised through the residents
    association.
  </p>

  <CtaBar whatsappMessage="Hi, I'm coordinating e-waste pickup for our housing society in Kochi." />

  <div class="quick-answer">
    <p class="quick-answer-label">Quick answer</p>
    <p>
      A resident or the association contacts us with an estimated item
      count and building address, we confirm a collection date, and
      residents bring items to a common area (lobby, car park) at the
      agreed time — one visit for the whole building instead of
      individual pickups.
    </p>
  </div>

  <ul class="key-takeaways">
    <li>Individual flats can still book their own pickup — a combined drive isn't mandatory.</li>
    <li>A common collection point (lobby, car park) makes one visit cover many households.</li>
    <li>Batteries need separate, well-ventilated storage — never packed with other items.</li>
  </ul>

  <section>
    <h2>How a combined society collection works</h2>
    <p>
      The association or a willing resident contacts us with an estimated
      item count and the building address. We confirm feasibility and
      agree a collection date. Residents bring items to a designated
      common area — lobby, car park, or ground floor — at the agreed time.
      Our team collects from that common point.
    </p>
  </section>

  <section>
    <h2>What residents should prepare</h2>
    <ul class="check-list">
      <li>Back up and wipe phones, laptops, and tablets before bringing them down</li>
      <li>Keep batteries in a separate bag — don't mix with other electronics</li>
      <li>Flag any swollen or damaged batteries and keep them isolated</li>
      <li>Label anything that needs data destruction</li>
      <li>Remove SIM cards and memory cards from phones</li>
    </ul>
  </section>

  <section>
    <h2>Items typically collected</h2>
    <p>
      Old phones, laptops, tablets, TVs, monitors, cables, chargers,
      batteries (UPS, inverter, laptop, phone), printers, and mixed
      household electronics. See <a href="/recycling/">recycling</a>
      for the full list.
    </p>
  </section>

  <section>
    <h2>Battery safety note</h2>
    <p>
      Don't store large quantities of old batteries in enclosed common
      areas or storerooms without ventilation. If any batteries look
      damaged, flag them in advance. See
      <a href="/battery-recycling/">battery recycling</a>.
    </p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/pickup/">Book Pickup</a>
      <a href="/battery-recycling/">Battery Recycling</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/ewaste-pickup-housing-societies-kochi/" />
  <section class="final-cta">
    <h2>Coordinating a Housing Society E-Waste Drive?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I'm coordinating e-waste pickup for our housing society in Kochi." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .check-list { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1.25rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .quick-answer { padding: 1.1rem 1.25rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-surface); margin: 1.5rem 0; }
  .quick-answer-label { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary); }
  .quick-answer p:last-child { margin: 0; color: var(--color-text); }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
