      "@type": "Organization",
      "name": "E-Waste Kochi"
    },
    "publisher": {
      "@id": "https://www.ewastekochi.com/#organization"
    },
    "mainEntityOfPage": "https://www.ewastekochi.com/blog/e-waste-for-schools-and-colleges/",
    "faq": [
      {
        "@type": "Question",
        "name": "Do schools have specific e-waste obligations?",
        "acceptedAnswer": {
          "@type": "Answer",
