---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "How to Book E-Waste Pickup Through WhatsApp in Kochi";
const description =
  "How to book an e-waste pickup in Kochi through WhatsApp — what details to send, how to share photos, and what to include for batteries, damaged items, and large quantities.";
const datePublished = "2026-07-08";
const dateModified = "2026-07-08";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "How to Book Pickup Through WhatsApp in Kochi", path: "/blog/pickup-on-whatsapp-kochi/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/pickup-on-whatsapp-kochi/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/pickup-on-whatsapp-kochi/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  {
    q: "What WhatsApp number should I use?",
    a: `Message us at ${BUSINESS.phoneDisplay} — the same number is used for all pickup bookings and enquiries.`,
  },
  {
    q: "Can I book in Malayalam on WhatsApp?",
    a: "Yes — message us in Malayalam and we'll respond in kind.",
  },
  {
    q: "What if I don't hear back quickly?",
    a: "If you haven't received a response within a reasonable time, try calling the same number.",
  },
];
---

<Layout title={title} description={description} path="/blog/pickup-on-whatsapp-kochi/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>How to Book Pickup Through WhatsApp</h1>
  <p class="lede">
    WhatsApp is the fastest and easiest way to book an e-waste pickup
    in Kochi. Here's exactly what to include in your first message to
    get a quick, accurate response.
  </p>

  <CtaBar whatsappMessage="Hi, I'd like to book an e-waste pickup. Here are my details:" />

  <div class="quick-answer">
    <p class="quick-answer-label">Quick answer</p>
    <p>
      Message us on WhatsApp with your item list, location, and any
      battery or data notes — that's the fastest way to book pickup in
      Kochi. Add photos for anything damaged, large, or unusual to speed
      up confirmation further.
    </p>
  </div>

  <ul class="key-takeaways">
    <li>A complete first message (items, location, batteries, data) reduces back-and-forth.</li>
    <li>A WhatsApp location pin is more precise than a text-only address.</li>
    <li>Phone booking works the same way if WhatsApp isn't convenient.</li>
  </ul>

  <section>
    <h2>What to include in your WhatsApp message</h2>
    <ul class="check-list">
      <li><strong>Item list:</strong> Type and rough quantity (e.g. "2 old laptops, 1 dead UPS, cables")</li>
      <li><strong>Location:</strong> Area name, building, floor — or share your WhatsApp location pin</li>
      <li><strong>Battery note:</strong> Mention if you have batteries, especially if damaged or swollen</li>
      <li><strong>Data note:</strong> Mention if data destruction is needed for any device</li>
      <li><strong>Preferred timing:</strong> Morning / afternoon, or a specific date if you have one</li>
    </ul>
  </section>

  <section>
    <h2>Add photos where helpful</h2>
    <p>
      Attach photos of batteries (especially damaged ones), large items,
      or anything you're unsure about. Photos speed up confirmation
      significantly. See our guide on
      <a href="/blog/photos-for-pickup-confirmation/">why photos help
      confirm pickup faster</a>.
    </p>
  </section>

  <section>
    <h2>What happens after you message</h2>
    <p>
      We'll confirm whether pickup is available in your area, any quote
      details for items with value, and a suggested pickup slot. If we
      have follow-up questions, we'll ask — so a complete initial message
      reduces back-and-forth.
    </p>
  </section>

  <section>
    <h2>Can also book by phone</h2>
    <p>
      If WhatsApp isn't convenient, call us at
      <a href={telLink()}>{BUSINESS.phoneDisplay}</a>. Same team, same
      process.
    </p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/pickup/">Book Pickup</a>
      <a href="/blog/photos-for-pickup-confirmation/">Photos for Pickup</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/pickup-on-whatsapp-kochi/" />
  <section class="final-cta">
    <h2>Ready to Book on WhatsApp?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I'd like to book an e-waste pickup. Here are my details:" compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .check-list { display: flex; flex-direction: column; gap: 0.5rem; padding-left: 1.25rem; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .quick-answer { padding: 1.1rem 1.25rem; border: 1px solid var(--color-border); border-radius: 0.5rem; background: var(--color-surface); margin: 1.5rem 0; }
  .quick-answer-label { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-primary); }
  .quick-answer p:last-child { margin: 0; color: var(--color-text); }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
