---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DirectAnswer from "../../../components/DirectAnswer.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import LongformExpansion from "../../../components/LongformExpansion.astro";
import Sources from "../../../components/Sources.astro";
import { BUSINESS, SITE_URL } from "../../../data/site";

const title = "E-Waste Compliance Checklist for Businesses";
const description = "A practical compliance checklist for Kochi companies handling end-of-life electronics.";
const lastUpdated = "2026-08-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Compliance & B2B", path: "/blog/compliance-b2b/" },
  { name: "E-Waste Compliance Checklist", path: "/blog/compliance-checklist-business/" }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": "2026-08-18",
    "dateModified": lastUpdated,
    "author": { "@type": "Organization", name: BUSINESS.legalName },
    "publisher": { "@id": `${SITE_URL}/#organization` },
    "mainEntityOfPage": `${SITE_URL}/blog/compliance-checklist-business/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/compliance-checklist-business/`,
    "name": title,
    "description": description,
    "dateModified": lastUpdated,
  }
];

const faqItems = [
  {
    q: "First step?",
    a: "Track assets to retirement."
  },
  {
    q: "Data first?",
    a: "Certified wipe/destroy before handover."
  },
  {
    q: "Authorised routing?",
    a: "Named recyclers, required certificates."
  },
  {
    q: "Review when?",
    a: "Annually or on volume change."
  }
];

const sourceItems = [
  {
    title: "E-Waste Management Rules and related regulatory resources",
    href: "https://cpcb.nic.in/rules-6/",
    publisher: "Central Pollution Control Board",
    note: "Official CPCB resource page for e-waste rules and updates."
  },
  {
    title: "EPR E-Waste portal",
    href: "https://eprewastecpcb.in/",
    publisher: "Central Pollution Control Board",
    note: "Official portal for e-waste EPR registration and compliance workflows."
  },
  {
    title: "Kerala State Pollution Control Board",
    href: "https://kspcb.kerala.gov.in/",
    publisher: "Kerala State Pollution Control Board",
    note: "Regional enforcement and authorization for e-waste recyclers in Kerala."
  }
];
---

<Layout title={title} description={description} path="/blog/compliance-checklist-business/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />

  <h1>E-Waste Compliance Checklist</h1>

  <DirectAnswer>
    <p>A business e-waste compliance checklist: track assets, destroy data, use authorised recyclers, keep manifests and certificates, and review annually. Kochi firms use this to stay audit-ready.</p>
  </DirectAnswer>

  <CtaBar whatsappMessage="Hi, we need an e-waste compliance checklist for our company." />

  <section id="section-1">
    <h2>Asset tracking</h2>
    <p>Log devices from purchase to retirement.</p>
    <p>An inventory makes bulk pickup simple.</p>
  </section>
  <section id="section-2">
    <h2>Data first</h2>
    <p>Certified wiping or destruction before handover.</p>
    <p>Attach the cert to the batch.</p>
  </section>
  <section id="section-3">
    <h2>Authorised routing</h2>
    <p>Name recyclers and require certificates.</p>
    <p>This keeps EPR and tender docs consistent.</p>
  </section>
  <section id="section-4">
    <h2>Review cycle</h2>
    <p>Check the policy annually or on volume changes.</p>
    <p>Consistency is what audits reward.</p>
  </section>

  <RelatedContent>
    <h2>Explore more guides</h2>
    <ul>
      <li><a href="/blog/compliance-b2b/">Compliance & B2B hub</a></li>
      <li><a href="/blog/general-ewaste/">General e-waste basics</a></li>
      <li><a href="/recycling/">Recycling service</a></li>
      <li><a href="/pickup/">Book a pickup</a></li>
    </ul>
  </RelatedContent>

  <LongformExpansion
    label="Expanded field guide"
    audience="households and businesses in Kochi"
    localIntent="e-waste compliance checklist with authorised pickup"
    items={["old electronics", "batteries", "cables", "data devices"]}
    themes={["Preparation", "Safety", "Compliance", "Recovery"]}
  />

  <section id="faq-section">
    <h2>Frequently asked questions</h2>
    <Faq items={faqItems} heading="E-Waste Compliance Checklist FAQs" />
  </section>

  <Sources items={sourceItems} heading="Official sources & regulatory references" />
</Layout>

<style>
  .blog-hub { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; }
  .blog-hub h1 { font-size: 2.5rem; margin-bottom: 1rem; color: var(--color-primary); text-align: center; }
  .blog-hub section { margin-bottom: 3rem; padding: 2rem; background: var(--color-bg); border-radius: 0.75rem; border: 1px solid var(--color-border); }
  .blog-hub h2 { color: var(--color-primary); margin-bottom: 1.5rem; font-size: 1.8rem; }
  .blog-hub ul { margin-bottom: 1rem; padding-left: 1.5rem; }
  .blog-hub li { margin-bottom: 0.5rem; line-height: 1.6; }
  @media (max-width: 768px) {
    .blog-hub h1 { font-size: 2rem; }
    .blog-hub section { padding: 1.5rem; }
    .blog-hub h2 { font-size: 1.5rem; }
  }
</style>
