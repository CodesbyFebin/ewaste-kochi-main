---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DirectAnswer from "../../../components/DirectAnswer.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import LongformExpansion from "../../../components/LongformExpansion.astro";
import Sources from "../../../components/Sources.astro";
import { BUSINESS, SITE_URL } from "../../../data/site";

const title = "Kochi Metro E-Waste Pickup Coverage";
const description = "Which Kochi metro areas are serviceable for doorstep e-waste pickup, and how to confirm your locality.";
const lastUpdated = "2026-08-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "Locations & Services", path: "/blog/locations-services/" },
  { name: "Kochi Metro Pickup Coverage", path: "/blog/kochi-metro-pickup/" }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": "2026-08-18",
    "dateModified": lastUpdated,
    "author": { "@type": "Organization", name: BUSINESS.legalName },
    "publisher": { "@id": `${SITE_URL}/#organization` },
    "mainEntityOfPage": `${SITE_URL}/blog/kochi-metro-pickup/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/kochi-metro-pickup/`,
    "name": title,
    "description": description,
    "dateModified": lastUpdated,
  }
];

const faqItems = [
  {
    q: "Is my area covered?",
    a: "Send locality, items and photos; the team confirms feasibility."
  },
  {
    q: "Which metro areas are common?",
    a: "Ernakulam, Kakkanad, Kalamassery, Edappally, Vyttila, Thrippunithura."
  },
  {
    q: "What if doorstep isn't feasible?",
    a: "The team proposes drop-off or alternative handling."
  },
  {
    q: "Do apartments get picked up?",
    a: "Yes, with building, floor and lift details shared early."
  }
];

const sourceItems = [
  {
    title: "E-Waste Management Rules and related regulatory resources",
    href: "https://cpcb.nic.in/rules-6/",
    publisher: "Central Pollution Control Board",
    note: "Official CPCB resource page for e-waste rules and updates."
  },
  {
    title: "EPR E-Waste portal",
    href: "https://eprewastecpcb.in/",
    publisher: "Central Pollution Control Board",
    note: "Official portal for e-waste EPR registration and compliance workflows."
  },
  {
    title: "Kerala State Pollution Control Board",
    href: "https://kspcb.kerala.gov.in/",
    publisher: "Kerala State Pollution Control Board",
    note: "Regional enforcement and authorization for e-waste recyclers in Kerala."
  }
];
---

<Layout title={title} description={description} path="/blog/kochi-metro-pickup/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />

  <h1>Kochi Metro Pickup Coverage</h1>

  <DirectAnswer>
    <p>Doorstep e-waste pickup in Kochi covers metro areas like Ernakulam, Kakkanad, Kalamassery, Edappally, Vyttila and Thrippunithura. Share your area, items and photos so the team can confirm feasibility before scheduling.</p>
  </DirectAnswer>

  <CtaBar whatsappMessage="Hi, I'm in [area] and want to confirm e-waste pickup." />

  <section id="section-1">
    <h2>Metro areas served</h2>
    <p>Core Kochi localities are commonly serviceable with the right item details.</p>
    <p>Kakkanad, Kalamassery, Edappally, Vyttila and Thrippunithura are frequent pickup zones.</p>
  </section>
  <section id="section-2">
    <h2>How coverage is confirmed</h2>
    <p>Feasibility depends on item type, quantity, condition and access.</p>
    <p>The team reviews your list and photos rather than assuming coverage.</p>
  </section>
  <section id="section-3">
    <h2>Apartments and offices</h2>
    <p>Apartments share building and lift details; offices share inventories and access.</p>
    <p>Both models work when prepared in advance.</p>
  </section>
  <section id="section-4">
    <h2>If your area is borderline</h2>
    <p>Some requests need drop-off or special handling instead of doorstep.</p>
    <p>The team suggests the realistic option instead of a false yes.</p>
  </section>

  <RelatedContent>
    <h2>Explore more guides</h2>
    <ul>
      <li><a href="/blog/locations-services/">Locations & Services hub</a></li>
      <li><a href="/blog/general-ewaste/">General e-waste basics</a></li>
      <li><a href="/recycling/">Recycling service</a></li>
      <li><a href="/pickup/">Book a pickup</a></li>
    </ul>
  </RelatedContent>

  <LongformExpansion
    label="Expanded field guide"
    audience="households and businesses in Kochi"
    localIntent="kochi metro pickup coverage with authorised pickup"
    items={["old electronics", "batteries", "cables", "data devices"]}
    themes={["Preparation", "Safety", "Compliance", "Recovery"]}
  />

  <section id="faq-section">
    <h2>Frequently asked questions</h2>
    <Faq items={faqItems} heading="Kochi Metro Pickup Coverage FAQs" />
  </section>

  <Sources items={sourceItems} heading="Official sources & regulatory references" />
</Layout>

<style>
  .blog-hub { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; }
  .blog-hub h1 { font-size: 2.5rem; margin-bottom: 1rem; color: var(--color-primary); text-align: center; }
  .blog-hub section { margin-bottom: 3rem; padding: 2rem; background: var(--color-bg); border-radius: 0.75rem; border: 1px solid var(--color-border); }
  .blog-hub h2 { color: var(--color-primary); margin-bottom: 1.5rem; font-size: 1.8rem; }
  .blog-hub ul { margin-bottom: 1rem; padding-left: 1.5rem; }
  .blog-hub li { margin-bottom: 0.5rem; line-height: 1.6; }
  @media (max-width: 768px) {
    .blog-hub h1 { font-size: 2rem; }
    .blog-hub section { padding: 1.5rem; }
    .blog-hub h2 { font-size: 1.5rem; }
  }
</style>
