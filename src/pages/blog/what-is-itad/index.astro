import { BUSINESS, SITE_URL } from "../../../data/site";

const title = "What Is ITAD? | IT Asset Disposition Explained | Ewaste Kochi";
const description = "ITAD (IT Asset Disposition) covers secure retirement of computers, servers, and storage devices with data destruction and environmental compliance.";
const datePublished = "2026-08-18";
const dateModified = "2026-08-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "What Is ITAD?", path: "/blog/what-is-itad/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "What Is ITAD? | IT Asset Disposition Explained | Ewaste Kochi",
    "description": "ITAD (IT Asset Disposition) covers secure retirement of computers, servers, and storage devices with data destruction and environmental compliance.",
    "datePublished": "2026-08-18",
    "dateModified": "2026-08-18",
    "author": {
      "@type": "Organization",
      "name": "E-Waste Kochi"
    },
    "publisher": {
      "@id": "https://www.ewastekochi.com/#organization"
    },
    "mainEntityOfPage": "https://www.ewastekochi.com/blog/what-is-itad/",
    "faq": [
      {
        "@type": "Question",
        "name": "Does ITAD include data destruction?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Certified ITAD programs include NIST 800-88-compliant data sanitization or physical destruction as part of the standard workflow."
        }
      },
      {
        "@type": "Question",
        "name": "Can ITAD assets be resold?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Functional assets can enter remarketing channels after certified data erasure. Non-functional assets proceed to material recycling."
        }
      },
      {
        "@type": "Question",
        "name": "Is ITAD required by law in India?",
        "acceptedAnswer": {
          "@type": "Answer",
