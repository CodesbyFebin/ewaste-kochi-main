---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import { BUSINESS, SITE_URL, telLink } from "../../../data/site";

const title = "How to Wipe Data Before Recycling or Selling a Phone";
const description =
  "Step-by-step: sign out of iCloud / Google, factory reset, remove SIM & SD card. Why this matters before pickup. What Ewaste Kochi does if you forget.";
const datePublished = "2026-07-14";
const dateModified = "2026-08-11";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "How to Remove Data Before Recycling a Phone", path: "/blog/how-to-remove-data-before-recycling-a-phone/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished,
    dateModified,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}/blog/how-to-remove-data-before-recycling-a-phone/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/how-to-remove-data-before-recycling-a-phone/`,
    name: title,
    description,
    dateModified,
  },
];

const faqItems = [
  { q: "What should I remove before pickup?", a: "SIM cards, memory cards, and anything personal you want to keep like a case." },
  { q: "Should I remove data first?", a: "Yes, factory reset and sign out of all accounts before handing the device over." },
  { q: "How do I book mobile recycling?", a: "Message the details for how to remove data before recycling a phone — device type, condition and your location — on WhatsApp to get started." },
  { q: "Is resale better than recycling?", a: "For how to remove data before recycling a phone: for a working phone, resale is usually worth checking first — non-working devices are typically better suited to recycling." },
];
---

<Layout title={title} description={description} path="/blog/how-to-remove-data-before-recycling-a-phone/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>How to Remove Data Before Recycling a Phone</h1>
  <p class="lede">A step-by-step answer, covering what actually matters and what you can skip. Phones and tablets store photos, messages, accounts and saved passwords.</p>

  <CtaBar whatsappMessage="Hi, I have a question about how to remove data before recycling a phone." />

  <ul class="key-takeaways">
    <li>Swollen batteries in any small device should never be removed yourself.</li>
    <li>Working phones may have resale value — check before recycling.</li>
    <li>Small items like chargers and earbuds are e-waste too — include them.</li>
  </ul>

  <section>
    <h2>Data on small devices</h2>
    <p>For how to remove data before recycling a phone, phones and tablets store photos, messages, accounts and saved passwords. A factory reset and signing out of accounts (Google, Apple ID, social media) is the essential step before any device changes hands.</p>
  </section>

  <section>
    <h2>For families</h2>
    <p>Households often accumulate phones from several replacement cycles, plus tablets, chargers and dead power banks. Gather everything in one place and wipe data on each device before pickup.</p>
  </section>

  <section>
    <h2>Accessories and small accessories</h2>
    <p>For how to remove data before recycling a phone, chargers, cables, earbuds and headphones are genuine e-waste, even though they're easy to overlook — include them in the same pickup rather than putting them in general waste.</p>
  </section>

  <section>
    <h2>Related services</h2>
    <div class="link-row">
      <a href="/sell-electronics/">Sell Electronics</a>
      <a href="/recycling/">E-Waste Recycling</a>
      <a href="/marketplace/">Marketplace</a>
    </div>
  </section>

  <p class="mal-support">
    മലയാളത്തിൽ സഹായം വേണോ? ഞങ്ങളെ <a href={telLink()}>{BUSINESS.phoneDisplay}</a> എന്ന നമ്പറിൽ വിളിക്കുകയോ വാട്സ്ആപ്പ് ചെയ്യുകയോ ചെയ്യാം.
  </p>

  <Faq items={faqItems} />

  <RelatedContent href="/blog/how-to-remove-data-before-recycling-a-phone/" />

  <section class="final-cta">
    <h2>Have Questions About How to Remove Data Before Recycling a Phone?</h2>
    <p>Share your item details and location on WhatsApp to get started.</p>
    <CtaBar whatsappMessage="Hi, I have a question about how to remove data before recycling a phone." compact />
  </section>

  <p class="updated">Last updated: {dateModified}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .key-takeaways { display: grid; gap: 0.5rem; margin: 1.5rem 0; padding-left: 1.25rem; }
  section p { line-height: 1.7; margin-bottom: 1rem; }
  .link-row { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; margin-top: 0.75rem; }
  .link-row a { color: var(--color-primary); font-weight: 800; text-decoration: none; }
  .mal-support { font-size: 0.9rem; color: var(--color-muted); padding: 0.9rem 1.1rem; background: var(--color-surface); border-radius: 0.5rem; margin: 2rem 0; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
  .final-cta { padding: 1.5rem 1.25rem; border-radius: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); text-align: center; margin: 2.5rem 0; }
  .final-cta p { color: var(--color-muted); margin: 0.4rem 0 0; }
</style>
