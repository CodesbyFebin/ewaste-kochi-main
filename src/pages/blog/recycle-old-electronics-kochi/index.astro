---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DirectAnswer from "../../../components/DirectAnswer.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import RelatedContent from "../../../components/RelatedContent.astro";
import LongformExpansion from "../../../components/LongformExpansion.astro";
import Sources from "../../../components/Sources.astro";
import { BUSINESS, SITE_URL } from "../../../data/site";

const title = "Where to Recycle Old Electronics in Kochi";
const description = "How and where to recycle old electronics in Kochi through authorised pickup and drop-off.";
const lastUpdated = "2026-08-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: "General E-Waste", path: "/blog/general-ewaste/" },
  { name: "Where to Recycle Old Electronics", path: "/blog/recycle-old-electronics-kochi/" }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": "2026-08-18",
    "dateModified": lastUpdated,
    "author": { "@type": "Organization", name: BUSINESS.legalName },
    "publisher": { "@id": `${SITE_URL}/#organization` },
    "mainEntityOfPage": `${SITE_URL}/blog/recycle-old-electronics-kochi/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/recycle-old-electronics-kochi/`,
    "name": title,
    "description": description,
    "dateModified": lastUpdated,
  }
];

const faqItems = [
  {
    q: "Where do I start?",
    a: "List items with photos and request pickup."
  },
  {
    q: "What routes exist?",
    a: "Recycling, resale review and data destruction."
  },
  {
    q: "Is it documented?",
    a: "Yes, with acknowledgements and certificates."
  },
  {
    q: "Do I prepare anything?",
    a: "Dry storage, battery separation, ready at slot."
  }
];

const sourceItems = [
  {
    title: "E-Waste Management Rules and related regulatory resources",
    href: "https://cpcb.nic.in/rules-6/",
    publisher: "Central Pollution Control Board",
    note: "Official CPCB resource page for e-waste rules and updates."
  },
  {
    title: "EPR E-Waste portal",
    href: "https://eprewastecpcb.in/",
    publisher: "Central Pollution Control Board",
    note: "Official portal for e-waste EPR registration and compliance workflows."
  },
  {
    title: "Kerala State Pollution Control Board",
    href: "https://kspcb.kerala.gov.in/",
    publisher: "Kerala State Pollution Control Board",
    note: "Regional enforcement and authorization for e-waste recyclers in Kerala."
  }
];
---

<Layout title={title} description={description} path="/blog/recycle-old-electronics-kochi/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />

  <h1>Where to Recycle Old Electronics</h1>

  <DirectAnswer>
    <p>To recycle old electronics in Kochi, list your items with photos and arrange authorised pickup. The team confirms the route — recycling, resale review or data destruction — before scheduling.</p>
  </DirectAnswer>

  <CtaBar whatsappMessage="Hi, I want to recycle old electronics in Kochi." />

  <section id="section-1">
    <h2>Start with a list</h2>
    <p>Note item type, quantity, condition and photos.</p>
    <p>This lets the team match the right service route.</p>
  </section>
  <section id="section-2">
    <h2>Three common routes</h2>
    <p>Recycling for broken items, resale review for working ones, destruction for data devices.</p>
    <p>One pickup can combine several routes.</p>
  </section>
  <section id="section-3">
    <h2>Authorised handling</h2>
    <p>Authorised recyclers document the chain and issue certificates.</p>
    <p>This protects you and the environment.</p>
  </section>
  <section id="section-4">
    <h2>Confirm and prepare</h2>
    <p>Keep items dry, separate batteries, and be ready at the slot.</p>
    <p>Acknowledgement and certificates close the loop.</p>
  </section>

  <RelatedContent>
    <h2>Explore more guides</h2>
    <ul>
      <li><a href="/blog/general-ewaste/">General E-Waste hub</a></li>
      <li><a href="/blog/general-ewaste/">General e-waste basics</a></li>
      <li><a href="/recycling/">Recycling service</a></li>
      <li><a href="/pickup/">Book a pickup</a></li>
    </ul>
  </RelatedContent>

  <LongformExpansion
    label="Expanded field guide"
    audience="households and businesses in Kochi"
    localIntent="where to recycle old electronics with authorised pickup"
    items={["old electronics", "batteries", "cables", "data devices"]}
    themes={["Preparation", "Safety", "Compliance", "Recovery"]}
  />

  <section id="faq-section">
    <h2>Frequently asked questions</h2>
    <Faq items={faqItems} heading="Where to Recycle Old Electronics FAQs" />
  </section>

  <Sources items={sourceItems} heading="Official sources & regulatory references" />
</Layout>

<style>
  .blog-hub { max-width: 1200px; margin: 0 auto; padding: 2rem 1rem; }
  .blog-hub h1 { font-size: 2.5rem; margin-bottom: 1rem; color: var(--color-primary); text-align: center; }
  .blog-hub section { margin-bottom: 3rem; padding: 2rem; background: var(--color-bg); border-radius: 0.75rem; border: 1px solid var(--color-border); }
  .blog-hub h2 { color: var(--color-primary); margin-bottom: 1.5rem; font-size: 1.8rem; }
  .blog-hub ul { margin-bottom: 1rem; padding-left: 1.5rem; }
  .blog-hub li { margin-bottom: 0.5rem; line-height: 1.6; }
  @media (max-width: 768px) {
    .blog-hub h1 { font-size: 2rem; }
    .blog-hub section { padding: 1.5rem; }
    .blog-hub h2 { font-size: 1.5rem; }
  }
</style>
