---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DirectAnswer from "../../../components/DirectAnswer.astro";
import CtaBar from "../../../components/CtaBar.astro";
import Faq from "../../../components/Faq.astro";
import LangSwitch from "../../../components/LangSwitch.astro";
import { SITE_URL } from "../../../data/site";
import { getHreflang } from "../../../data/routes";

const title = "കൊച്ചിയിൽ ബാറ്ററി റീസൈക്ലിംഗ് | യുപിഎസ്, ഇൻവെർട്ടർ, ലാപ്ടോപ്പ്, ഫോൺ";
const description =
  "കൊച്ചിയിൽ യുപിഎസ്, ഇൻവെർട്ടർ, ലാപ്ടോപ്പ്, ഫോൺ ബാറ്ററികൾക്കുള്ള സുരക്ഷിത റീസൈക്ലിംഗ്. സൗജന്യ ശേഖരണം, നിയമാനുസൃത നിർമാർജനം.";
const lastUpdated = "2026-07-07";

const breadcrumbItems = [
  { name: "ഹോം", path: "/" },
  { name: "മലയാളം", path: "/ml/" },
  { name: "ബാറ്ററി റീസൈക്ലിംഗ്", path: "/ml/battery-recycling/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Battery recycling",
    provider: { "@id": `${SITE_URL}/#organization` },
    areaServed: "Kochi, Ernakulam, Kerala",
    url: `${SITE_URL}/ml/battery-recycling/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/ml/battery-recycling/`,
    name: title,
    description,
    dateModified: lastUpdated,
    inLanguage: "ml-IN",
  },
];

const faqItems = [
  {
    q: "കൊച്ചിയിൽ ബാറ്ററി എവിടെ റീസൈക്കിൾ ചെയ്യാം?",
    a: "വീട്ടിൽ നിന്നോ ഓഫീസിൽ നിന്നോ നേരിട്ട് ഞങ്ങൾ ബാറ്ററി ശേഖരിക്കുന്നു — എവിടെയും കൊണ്ടുപോകേണ്ട ആവശ്യമില്ല.",
  },
  {
    q: "ഏതെല്ലാം തരം ബാറ്ററികൾ സ്വീകരിക്കും?",
    a: "യുപിഎസ്, ഇൻവെർട്ടർ ബാറ്ററികൾ, ലാപ്ടോപ്പ്, ഫോൺ ബാറ്ററികൾ, മിക്ക ലെഡ്-ആസിഡ്, ലിഥിയം-അയൺ ബാറ്ററികളും.",
  },
  {
    q: "ബാറ്ററി വീട്ടിലെ മാലിന്യത്തിൽ ഇടാമോ?",
    a: "പാടില്ല. ബാറ്ററികളിൽ ഉള്ള രാസവസ്തുക്കൾ മണ്ണിലേക്കും വെള്ളത്തിലേക്കും കലരാം, ലിഥിയം ബാറ്ററികൾ തീപിടിത്ത അപകടവും ഉണ്ടാക്കാം.",
  },
  {
    q: "ഓഫീസുകൾക്ക് ബൾക്ക് ബാറ്ററി ശേഖരണം ലഭ്യമാണോ?",
    a: "അതെ, യുപിഎസ് ബാറ്ററി മാറ്റുന്ന ഓഫീസുകൾക്ക് ബൾക്ക് ശേഖരണം ക്രമീകരിക്കാം.",
  },
];
---

<Layout title={title} description={description} path="/ml/battery-recycling/" jsonLd={jsonLd} lang="ml-IN" hreflang={getHreflang("/ml/battery-recycling/")}>
  <Breadcrumbs items={breadcrumbItems} />
  <LangSwitch current="ml" otherPath="/battery-recycling/" />
  <h1>കൊച്ചിയിൽ ബാറ്ററി റീസൈക്ലിംഗ്</h1>
  <p class="lede">
    ബാറ്ററികൾക്ക് സാധാരണ ഇ-മാലിന്യത്തിൽ നിന്ന് വ്യത്യസ്തമായ കൈകാര്യം ചെയ്യൽ
    ആവശ്യമാണ് — വീട്ടിലെ ചവറ്റുകുട്ടയിൽ ഇടാൻ പാടില്ല. യുപിഎസ്, ഇൻവെർട്ടർ,
    ലാപ്ടോപ്പ്, ഫോൺ ബാറ്ററികൾ ഞങ്ങൾ വീട്ടിൽ നിന്ന് നേരിട്ട് ശേഖരിക്കുന്നു.
  </p>

  <DirectAnswer heading="ചുരുക്കം">
    <p>{description}</p>
  </DirectAnswer>

  <CtaBar
    whatsappMessage="നമസ്കാരം, കൊച്ചിയിൽ ബാറ്ററി റീസൈക്ലിംഗ് പിക്കപ്പ് ബുക്ക് ചെയ്യണം."
    pickupHref="/ml/pickup/"
    labels={{ call: "വിളിക്കുക", whatsapp: "വാട്സ്ആപ്പ് ചെയ്യുക", pickup: "പിക്കപ്പ് ബുക്ക് ചെയ്യുക" }}
  />

  <section>
    <h2>സ്വീകരിക്കുന്ന ബാറ്ററികൾ</h2>
    <p>
      യുപിഎസ് ബാറ്ററികൾ, ഇൻവെർട്ടർ ബാറ്ററികൾ, ലാപ്ടോപ്പ്, ഫോൺ ബാറ്ററികൾ,
      വീട്ടിലെയോ ഓഫീസിലെയോ ഉപകരണങ്ങളിൽ നിന്നുള്ള മിക്ക ലെഡ്-ആസിഡ് അല്ലെങ്കിൽ
      ലിഥിയം-അയൺ ബാറ്ററികളും.
    </p>
  </section>

  <section>
    <h2>പിക്കപ്പ് എങ്ങനെ പ്രവർത്തിക്കുന്നു</h2>
    <ol class="process-list">
      <li><strong>ബാറ്ററി തരവും അളവും</strong> വാട്സ്ആപ്പിലോ ഫോണിലോ അറിയിക്കുക.</li>
      <li><strong>സ്ലോട്ട് സ്ഥിരീകരിക്കുന്നു</strong> — മിക്കപ്പോഴും അതേ ദിവസമോ അടുത്ത ദിവസമോ.</li>
      <li><strong>ഡോർസ്റ്റെപ്പ് ശേഖരണം</strong> വീട്ടിൽ നിന്നോ ഓഫീസിൽ നിന്നോ.</li>
      <li><strong>നിയമാനുസൃത റീസൈക്ലിംഗ്</strong> — ബാറ്ററി തരം അനുസരിച്ച് പ്രോസസ്സ് ചെയ്യുന്നു.</li>
    </ol>
  </section>

  <section>
    <h2>അനുസരണം (Compliance)</h2>
    <p>
      ബാറ്ററി ശേഖരണവും റീസൈക്ലിംഗും രേഖപ്പെടുത്തിയ പരിസ്ഥിതി കൈകാര്യ
      രീതികൾ പിന്തുടരുന്നു. സേവനത്തിന്റെ തരം അനുസരിച്ച് രേഖകൾക്കുള്ള
      പിന്തുണ ലഭ്യമായേക്കാം —
      <a href="/ml/contact/">ബന്ധപ്പെടുക</a>.
    </p>
  </section>

  <Faq items={faqItems} heading="പതിവ് ചോദ്യങ്ങൾ" />

  <p class="updated">അവസാനം പുതുക്കിയത്: <time datetime={lastUpdated}>{lastUpdated}</time></p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .process-list { display: flex; flex-direction: column; gap: 0.6rem; padding-left: 1.25rem; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
</style>
