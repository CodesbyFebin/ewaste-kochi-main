---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import DirectAnswer from "../../../components/DirectAnswer.astro";
import { BUSINESS, SITE_URL } from "../../../data/site";

const title = "E-Waste Licensing in Kerala | KSPCB Authorization Guide";
const description =
  "Understanding KSPCB e-waste licensing requirements for businesses in Kerala. Registration process, compliance obligations, and authorized operator list.",
const path = "/wiki/locations/kerala-licensing-ewaste";
const lastUpdated = "2026-08-18";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "E-Waste Encyclopedia", path: "/wiki/" },
  { name: "Locations", path: "/wiki/locations/" },
  { name: "Kerala Licensing", path },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}${path}/`,
    name: title,
    description,
    dateModified: lastUpdated,
    publisher: { "@id": `${SITE_URL}/#organization` },
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    datePublished: lastUpdated,
    dateModified: lastUpdated,
    author: { "@type": "Organization", name: BUSINESS.legalName },
    publisher: { "@id": `${SITE_URL}/#organization` },
    mainEntityOfPage: `${SITE_URL}${path}`,
  },
];
---

<Layout title={title} description={description} path={path} jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />

  <article class="licensing-guide">
    <section class="hero">
      <div>
        <p class="eyebrow">KSPCB Licensing</p>
        <h1>E-Waste Licensing in Kerala</h1>
        <p class="lede">
          KSPCB e-waste licensing requirements for businesses in Kerala. 
          Registration process, compliance obligations, and authorized 
          operator verification.
        </p>
      </div>
    </section>

    <DirectAnswer heading="Key Points">
      <ul>
        <li><strong>Registration Required:</strong> All e-waste collection, 
        storage, treatment, and trading requires KSPCB authorization</li>
        <li><strong>Validity:</strong> Licenses typically valid for 3 years 
        with annual compliance reporting</li>
        <li><strong>Verification:</strong> Verify recyclers via KSPCB 
        website or by license number</li>
      </ul>
    </DirectAnswer>

    <section class="requirements-section" aria-labelledby="requirements-heading">
      <h2 id="requirements-heading">Licensing Requirements</h2>
      
      <div class="requirement-grid">
        <div class="requirement-item">
          <h3>Application Form</h3>
          <p>Submit KSPCB Form-1 with detailed project report including 
          facility layout, processing capacity, and environmental measures.</p>
        </div>
        <div class="requirement-item">
          <h3>Technical Details</h3>
          <p>Provide machinery details, pollution control equipment, 
          process flow diagram, and spill prevention measures.</p>
        </div>
        <div class="requirement-item">
          <h3>Financial Stmt</h3>
          <p>Audited balance sheet for past 3 years. Net worth requirements 
          and bank guarantor certificate.</p>
        </div>
        <div class="requirement-item">
          <h3>Site Inspection</h3>
          <p>KSPCB team visits facility for physical inspection and 
          compliance assessment before final approval.</p>
        </div>
      </div>
    </section>

    <section class="how-to-verify" aria-labelledby="verify-heading">
      <h2 id="verify-heading">How to Verify a Licensed Operator</h2>
      
      <ol class="verify-steps">
        <li>
          <strong>Check KSPCB Website</strong>
          <p>Visit kerala.gov.in or kspcb.kerala.gov.in for online 
          license verification database.</li>
        </li>
        <li>
          <strong>Request License Copy</strong>
          <p>Ask the operator for current license certificate. Verify 
          license number with KSPCB before proceeding.</li>
        </li>
        <li>
          <strong>Confirm Validity</strong>
          <p>Check license start/end dates. Some licenses have restrictions 
          on device categories or collection radius.</li>
        </li>
      </ol>
    </section>

    <section class="link-grid" aria-labelledby="related-heading">
      <h2 id="related-heading">Related Resources</h2>
      <a href="/wiki/technical/indian-laws/">E-Waste Laws</a>
      <a href="/wiki/technical/epr-india-rules/">EPR Compliance</a>
      <a href="/wiki/disposal/local-recycling-centers/">Find Centers</a>
    </section>
  </article>
</Layout>

<style>
  .licensing-guide {
    display: grid;
    gap: 2rem;
  }
  .hero {
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }
  .eyebrow {
    margin: 0 0 0.35rem;
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 8vw, 3rem);
  }
  .lede {
    color: var(--color-muted);
    font-size: 1.08rem;
    max-width: 50rem;
  }
  .requirement-grid {
    display: grid;
    gap: 1rem;
  }
  .requirement-item {
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface);
  }
  .verify-steps {
    display: grid;
    gap: 1rem;
  }
  .link-grid {
    display: grid;
    gap: 0.75rem;
  }
  .link-grid a {
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface);
    text-decoration: none;
    font-weight: 600;
    color: var(--color-text);
  }
  @media (min-width: 780px) {
    .hero {
      grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1.1fr);
    }
    .requirement-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .link-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>