---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CtaBar from "../../components/CtaBar.astro";
import Faq from "../../components/Faq.astro";
import { SITE_URL } from "../../data/site";

const title = "Certifications | Ewaste Kochi";
const description =
  "Environmental and regulatory compliance status for Ewaste Kochi's recycling and data destruction operations.";
const lastUpdated = "2026-07-07";

const breadcrumbItems = [
  { name: "Home", path: "/" },
  { name: "Trust", path: "/trust/" },
  { name: "Certifications", path: "/certifications/" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${SITE_URL}/certifications/`,
    name: title,
    description,
    dateModified: lastUpdated,
  },
];

const faqItems = [
  {
    q: "What environmental practices does Ewaste Kochi follow?",
    a: "Our recycling process follows documented environmental handling practices, with pickup, sorting and documentation support depending on the service type. If you need compliance documentation for business or ITAD work, contact us before pickup so the required handling process can be confirmed.",
  },
  {
    q: "What about regulatory authorization for e-waste handling?",
    a: "Documentation support may be available depending on the service type and agreed handling process. Contact us before pickup if your business needs this confirmed for your records.",
  },
  {
    q: "Can I see the actual documentation?",
    a: "Contact us and we'll share what documentation is currently available for your specific request.",
  },
];
---

<Layout title={title} description={description} path="/certifications/" jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <h1>Certifications</h1>
  <p class="lede">
    A plain-language summary of the compliance standards our operations
    follow. For the underlying documents themselves, contact us directly —
    we'd rather point you to the real paperwork than restate numbers here
    that you can't verify.
  </p>

  <CtaBar whatsappMessage="Hi, I'd like to request your certification documents." />

  <section>
    <h2>Environmental management</h2>
    <p>
      Our recycling process follows documented environmental handling
      practices, with pickup, sorting and documentation support depending
      on the service type. If you need compliance documentation for
      business or ITAD work, contact us before pickup so the required
      handling process can be confirmed.
    </p>
  </section>

  <section>
    <h2>Pollution control authorization</h2>
    <p>
      Documentation support may be available depending on the service type
      and agreed handling process. Contact us before pickup if your
      business needs this confirmed for your own compliance records.
    </p>
  </section>

  <section>
    <h2>How to request documentation</h2>
    <p>
      Message us via <a href="/contact/">our contact page</a> with what you
      need — general compliance documentation, or a certificate tied to a
      specific pickup or data destruction job (see the
      <a href="/data-destruction-certificate-sample/">certificate sample
      page</a> for what that includes).
    </p>
  </section>

  <Faq items={faqItems} />

  <p class="updated">Last updated: {lastUpdated}</p>
</Layout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-muted); max-width: 46rem; }
  .updated { font-size: 0.8rem; color: var(--color-muted); }
</style>
