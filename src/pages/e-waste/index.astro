    min-height: 44px;
    padding: 0.7rem 1rem;
    border-radius: 0.5rem;
    font-weight: 800;
    text-decoration: none;
  }
  .button.primary {
    background: var(--color-primary);
    color: #fff;
  }
  .button.secondary,
  .quick-link-grid a {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-primary);
  }
  .toc {
    padding: 1rem 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface);
  }
