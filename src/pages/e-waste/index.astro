    margin: 0 0 0.6rem;
    font-size: 1rem;
  }
  .toc ol {
    margin: 0;
    padding-left: 1.2rem;
    columns: 1;
  }
  .type-grid,
  .example-grid,
  .decision-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
    margin-top: 1rem;
  }
  .type-card,
  .example-card,
  .decision-card {
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface);
  }
