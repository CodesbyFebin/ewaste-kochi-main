    display: grid;
    gap: 0.35rem;
    color: var(--color-text);
    text-decoration: none;
  }
  .type-card h3,
  .example-card h3,
  .decision-card h3 {
    margin: 0;
    font-size: 1rem;
    color: var(--color-primary);
  }
  .type-card p,
  .decision-card p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
  }
  .type-card span {
    margin-top: 0.25rem;
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 800;
  }
  .example-card ul,
  .check-list {
    margin: 0.65rem 0 0;
    padding-left: 1.15rem;
  }
  .check-list {
    display: grid;
    gap: 0.45rem;
  }
  .final-cta {
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
