---
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';
import grayMatter from 'gray-matter';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

// Generate static paths
export function getStaticPaths() {
  const articlesDir = path.join(process.cwd(), 'src/content/articles');
  const results = [];
  const clusters = fs.readdirSync(articlesDir, { withFileTypes: true });
  for (const cluster of clusters) {
    if (cluster.isDirectory()) {
      const clusterPath = path.join(articlesDir, cluster.name);
      const files = fs.readdirSync(clusterPath, { withFileTypes: true });
      for (const file of files) {
        if (file.isFile() && file.name.endsWith('.md')) {
          results.push({
            params: {
              cluster: cluster.name,
              slug: file.name.replace(/\.md$/, '')
            }
          });
        }
      }
    }
  }
  return results;
}

// For rendering: compute paths again
const { cluster, slug } = Astro.params;
const articlesDir = path.join(process.cwd(), 'src/content/articles');
const articlePath = path.join(articlesDir, cluster, `${slug}.md`);
const fileContent = fs.readFileSync(articlePath, 'utf8');
const { data, content } = grayMatter(fileContent);

const title = data.title;
const description = data.description;
const canonical = `https://www.ewastekochi.com/${cluster}/${slug}/`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <article>
      <h1>{title}</h1>
      <p>Cluster: {cluster} | Slug: {slug}</p>
      <hr />
      <div>{content}</div>
    </article>
  </body>
</html>