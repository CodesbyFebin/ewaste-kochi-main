---
import SeoHead from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LeadFunnelChatbot from "../components/LeadFunnelChatbot.astro";

interface HreflangEntry {
  lang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: Record<string, unknown>[];
  hreflang?: HreflangEntry[];
  noindex?: boolean;
  lang?: "en-IN" | "ml-IN";
}

const { title, description, path, jsonLd = [], hreflang = [], noindex = false, lang = "en-IN" } = Astro.props;
const htmlLang = lang === "ml-IN" ? "ml" : "en-IN";
---

<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SeoHead title={title} description={description} path={path} jsonLd={jsonLd} hreflang={hreflang} noindex={noindex} />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3573741815038097" crossorigin="anonymous"></script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <LeadFunnelChatbot />
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #ffffff;
    --color-surface: #f6f7f5;
    --color-text: #14201a;
    --color-muted: #5b6b62;
    --color-border: #dde3de;
    --color-primary: #1a7a4c;
    --color-primary-dark: #125534;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --color-bg: #0f1512;
      --color-surface: #161f1a;
      --color-text: #eef3ef;
      --color-muted: #9fb0a6;
      --color-border: #2a352e;
      --color-primary: #3fbf82;
      --color-primary-dark: #7ee0ad;
    }
  }
  * {
    box-sizing: border-box;
  }
  html, body {
    padding: 0;
    margin: 0;
  }
  /* Clear the sticky Header (trust-bar + main wrap) when anchor links or the
     skip-link jump to an in-page target. Without this, hash navigation lands
     the target underneath the header on mobile. Desktop header is a bit
     taller because the trust-bar text becomes visible. */
  html {
    scroll-padding-top: 96px;
  }
  @media (min-width: 860px) {
    html {
      scroll-padding-top: 128px;
    }
  }
  /* Universal fallback for any heading that becomes an anchor target
     (Astro's built-in slugger emits ids on h2/h3). */
  :where(h1, h2, h3, h4, section[id], [id]) {
    scroll-margin-top: 96px;
  }
  @media (min-width: 860px) {
    :where(h1, h2, h3, h4, section[id], [id]) {
      scroll-margin-top: 128px;
    }
  }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
  }
  main {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.25rem 1rem;
  }
  h1, h2, h3 {
    line-height: 1.25;
    color: var(--color-text);
  }
  a {
    color: var(--color-primary);
  }
  :focus-visible {
    outline: 3px solid #e9a23b;
    outline-offset: 3px;
  }
  .skip-link {
    position: absolute;
    top: -100%;
    left: 0.75rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    border-radius: 0 0 0.4rem 0.4rem;
    transition: top 0.15s;
  }
  .skip-link:focus {
    top: 0;
  }
  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible,
  select:focus-visible {
    outline: 3px solid #e9a23b;
    outline-offset: 3px;
  }
  img {
    max-width: 100%;
    height: auto;
  }
</style>
