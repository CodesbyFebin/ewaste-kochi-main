---
import SeoHead from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LeadFunnelChatbot from "../components/LeadFunnelChatbot.astro";

interface HreflangEntry {
  lang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: Record<string, unknown>[];
  hreflang?: HreflangEntry[];
  noindex?: boolean;
  lang?: "en-IN" | "ml-IN";
}

const { title, description, path, jsonLd = [], hreflang = [], noindex = false, lang = "en-IN" } = Astro.props;
const htmlLang = lang === "ml-IN" ? "ml" : "en-IN";
---

<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d5a36" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SeoHead title={title} description={description} path={path} jsonLd={jsonLd} hreflang={hreflang} noindex={noindex} />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3573741815038097" crossorigin="anonymous"></script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <LeadFunnelChatbot />
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #ffffff;
    --color-surface: #f5f8f6;
    --color-surface-strong: #eaf3ed;
    --color-text: #102019;
    --color-muted: #5c6d63;
    --color-border: #dce6df;
    --color-primary: #147a4b;
    --color-primary-dark: #0d5a36;
    --color-accent: #dff6e8;
    --shadow-sm: 0 1px 2px rgba(16, 32, 25, 0.05), 0 6px 20px rgba(16, 32, 25, 0.05);
    --shadow-md: 0 12px 35px rgba(16, 32, 25, 0.09);
    --radius-sm: 10px;
    --radius-md: 16px;
    --radius-lg: 22px;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-bg: #0e1511;
      --color-surface: #151f19;
      --color-surface-strong: #1a2b21;
      --color-text: #eef5f0;
      --color-muted: #a5b5ab;
      --color-border: #29382f;
      --color-primary: #4bc58a;
      --color-primary-dark: #82dfad;
      --color-accent: #173a29;
      --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.25), 0 8px 24px rgba(0, 0, 0, 0.18);
      --shadow-md: 0 16px 40px rgba(0, 0, 0, 0.28);
    }
  }

  * { box-sizing: border-box; }

  html, body {
    padding: 0;
    margin: 0;
    min-width: 320px;
    overflow-x: clip;
  }

  html { scroll-padding-top: 104px; }
  @media (min-width: 860px) { html { scroll-padding-top: 132px; } }

  :where(h1, h2, h3, h4, section[id], [id]) { scroll-margin-top: 104px; }
  @media (min-width: 860px) { :where(h1, h2, h3, h4, section[id], [id]) { scroll-margin-top: 132px; } }

  body {
    font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background:
      radial-gradient(circle at 10% 0%, rgba(20, 122, 75, 0.045), transparent 28rem),
      var(--color-bg);
    color: var(--color-text);
    line-height: 1.65;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  body.menu-open { overflow: hidden; touch-action: none; }

  main {
    width: min(100% - 2rem, 72rem);
    margin: 0 auto;
    padding: clamp(1.5rem, 3vw, 2.75rem) 0 2rem;
  }

  h1, h2, h3, h4 {
    color: var(--color-text);
    letter-spacing: -0.025em;
    line-height: 1.14;
  }

  h1 { font-weight: 850; }
  h2 { font-weight: 800; }
  h3 { font-weight: 750; }

  p { text-wrap: pretty; }
  a { color: var(--color-primary); }

  img, svg, video { max-width: 100%; }
  img { height: auto; }

  ::selection { background: var(--color-accent); color: var(--color-text); }

  :focus-visible {
    outline: 3px solid #f0a43c;
    outline-offset: 3px;
    border-radius: 4px;
  }

  button, input, textarea, select { font: inherit; }

  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible,
  select:focus-visible {
    outline: 3px solid #f0a43c;
    outline-offset: 3px;
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: 0.75rem;
    z-index: 2000;
    padding: 0.7rem 1rem;
    background: var(--color-primary-dark);
    color: #fff;
    font-weight: 800;
    text-decoration: none;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
  }

  .skip-link:focus { top: 0; }

  :where(main > section) { scroll-margin-top: 104px; }
  :where(main > section:not(.hero)) { margin-block: clamp(2.75rem, 5vw, 4.75rem); }
  :where(main > h1) { margin-top: 0.5rem; font-size: clamp(2rem, 5vw, 3.5rem); max-width: 18ch; }
  :where(main > .lede) { max-width: 52rem; font-size: clamp(1rem, 2vw, 1.18rem); color: var(--color-muted); }
  :where(main section, main article) { min-width: 0; }
  :where(main section > h2) { margin-bottom: 0.8rem; }
  :where(main section > p) { max-width: 68ch; }
  :where(main table) { border-collapse: collapse; }
  :where(main .table-scroll) { max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; overscroll-behavior-inline: contain; border-radius: var(--radius-sm); }
  :where(main .table-scroll table) { min-width: 40rem; }
  :where(main input, main textarea, main select) { max-width: 100%; border-radius: var(--radius-sm); }
  :where(main button, main .action, main a[role="button"]) { touch-action: manipulation; }
  :where(main ul, main ol) { padding-inline-start: 1.35rem; }
  :where(main .check-list) { display: grid; gap: 0.65rem; }
  :where(main .link-row) { display: flex; flex-wrap: wrap; gap: 0.65rem; }
  :where(main .link-row a) { min-height: 42px; display: inline-flex; align-items: center; }
  :where(main .hero-image, main figure) { max-width: 100%; }
  :where(main figure img) { display: block; width: 100%; border-radius: var(--radius-md); }
  :where(main .cluster-grid, main .item-grid) { align-items: stretch; }
  :where(main .cluster-card, main .item-card) { box-shadow: var(--shadow-sm); }
  :where(main .final-cta) { box-shadow: var(--shadow-sm); }

  @media (max-width: 640px) {
    main {
      width: min(100% - 1.25rem, 72rem);
      padding-top: 1.1rem;
    }

    :where(main > section:not(.hero)) { margin-block: 2.5rem; }
    :where(main > h1) { font-size: clamp(1.9rem, 9vw, 2.7rem); max-width: 100%; line-height: 1.08; }
    :where(main > .lede) { font-size: 1rem; line-height: 1.6; }
    :where(main section > h2) { font-size: clamp(1.45rem, 6vw, 2rem); }
    :where(main .table-scroll) { margin-inline: -0.1rem; border-radius: var(--radius-sm); }
    :where(main .table-scroll table) { min-width: 36rem; }
    :where(main .link-row) { gap: 0.5rem; }
    :where(main figure) { margin-inline: 0; }
  }
</style>