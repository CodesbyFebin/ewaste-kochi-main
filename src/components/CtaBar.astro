---
import { telLink, whatsappLink } from "../data/site";

interface Labels {
  call: string;
  whatsapp: string;
  pickup: string;
}

interface Props {
  whatsappMessage?: string;
  compact?: boolean;
  pickupHref?: string;
  labels?: Labels;
}

const {
  whatsappMessage = "Hi, I'd like a free e-waste pickup quote in Kochi.",
  compact = false,
  pickupHref = "/pickup/",
  labels = { call: "Call Now", whatsapp: "WhatsApp Us", pickup: "Book Pickup" },
} = Astro.props;
---

<div class:list={["cta-bar", { compact }]} aria-label="Contact and pickup actions">
  <a class="cta-btn cta-call" href={telLink()} aria-label={`${labels.call} — Ewaste Kochi`}>{labels.call}</a>
  <a class="cta-btn cta-whatsapp" href={whatsappLink(whatsappMessage)} target="_blank" rel="noopener" aria-label={`${labels.whatsapp} — Ewaste Kochi`}>
    {labels.whatsapp}
  </a>
  <a class="cta-btn cta-pickup" href={pickupHref} aria-label={`${labels.pickup} — Ewaste Kochi`}>{labels.pickup}</a>
</div>

<style>
  .cta-bar {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-block: 1.5rem;
  }
  .cta-bar.compact {
    margin-block: 0.75rem;
  }
  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.1rem;
    border-radius: var(--radius-sm, 10px);
    font-weight: 750;
    text-decoration: none;
    font-size: 0.95rem;
    min-height: 48px;
    text-align: center;
    box-shadow: var(--shadow-sm, none);
    transition: transform 140ms ease, filter 140ms ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .cta-btn:hover { transform: translateY(-1px); }
  .cta-call {
    background: var(--color-primary);
    color: #fff;
  }
  .cta-whatsapp {
    background: #25d366;
    color: #063d1e;
  }
  .cta-pickup {
    background: var(--color-surface);
    color: var(--color-primary);
    border: 1.5px solid var(--color-primary);
  }
  .cta-call:hover, .cta-whatsapp:hover, .cta-pickup:hover {
    filter: brightness(0.96);
  }

  @media (max-width: 640px) {
    .cta-bar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "whatsapp whatsapp"
        "call pickup";
      gap: 0.55rem;
      margin-block: 1.15rem;
    }
    .cta-bar.compact {
      margin-block: 0.65rem;
    }
    .cta-call { grid-area: call; }
    .cta-whatsapp { grid-area: whatsapp; }
    .cta-pickup { grid-area: pickup; }
    .cta-btn {
      width: 100%;
      min-height: 52px;
      padding: 0.85rem 0.75rem;
      font-size: 0.92rem;
    }
    .cta-whatsapp {
      min-height: 56px;
      font-size: 1rem;
      font-weight: 800;
    }
  }

  @media (max-width: 380px) {
    .cta-bar {
      grid-template-columns: 1fr;
      grid-template-areas:
        "whatsapp"
        "call"
        "pickup";
    }
  }
</style>
