---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import DirectAnswer from "./DirectAnswer.astro";
import Faq from "./Faq.astro";
import Sources from "./Sources.astro";
import { BUSINESS, SITE_URL, telLink, whatsappLink } from "../data/site";
import { DISCOVERY_GUIDES, GUIDE_CATEGORIES } from "../data/discoveryGuides";
import type { DiscoveryGuide } from "../data/discoveryGuideTypes";

interface Props {
  guide?: DiscoveryGuide;
  category: (typeof GUIDE_CATEGORIES)[number];
}

const { guide, category } = Astro.props;
const path = guide ? `/${guide.slug}/` : category.path;
const title = guide?.title ?? category.title;
const description = guide?.description ?? category.description;
const url = new URL(path, SITE_URL).toString();
const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: category.title, path: category.path },
  ...(guide ? [{ name: guide.title, path }] : []),
];
const jsonLd: Record<string, unknown>[] = [{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": url,
  name: title,
  description,
  inLanguage: "en-IN",
  isPartOf: { "@id": `${SITE_URL}/#website` },
}];
if (guide) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${url}#article`,
    headline: title,
    description,
    mainEntityOfPage: url,
    inLanguage: "en-IN",
    author: { "@id": `${SITE_URL}/#organization` },
    publisher: { "@id": `${SITE_URL}/#organization` },
  });
  if (guide.steps?.length) {
    jsonLd.push({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "@id": `${url}#instructions`,
      name: title,
      description: guide.answer,
      step: guide.steps.map((step, index) => ({
        "@type": "HowToStep",
        position: index + 1,
        name: step.name,
        text: step.text,
        url: `${url}#step-${index + 1}`,
      })),
    });
  }
}
const siblings = DISCOVERY_GUIDES.filter((item) => item.category === category.id && item.slug !== guide?.slug);
---

<Layout title={title} description={description} path={path} jsonLd={jsonLd} lang="en-IN">
  <Breadcrumbs items={breadcrumbs} />
  <article class="discovery-guide">
    <header>
      <p class="eyebrow">E-waste practical knowledge</p>
      <h1>{title}</h1>
      {!guide && <p class="lede">{description}</p>}
    </header>
    {guide ? (
      <>
        <DirectAnswer heading="Quick answer"><p>{guide.answer}</p></DirectAnswer>
        {guide.tools?.length && <section><h2>What you need</h2><ul>{guide.tools.map((tool) => <li>{tool}</li>)}</ul></section>}
        {guide.steps?.length && (
          <section id="instructions">
            <h2>Step-by-step guide</h2>
            <ol>{guide.steps.map((step, index) => <li id={`step-${index + 1}`}><h3>{step.name}</h3><p>{step.text}</p></li>)}</ol>
          </section>
        )}
        {guide.timeline && <section><h2>Planning the timeline</h2><p>{guide.timeline}</p></section>}
        {guide.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets?.length && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
          </section>
        ))}
        {category.id === "locations" && (
          <section aria-labelledby="contact-heading">
            <h2 id="contact-heading">Kochi office contact and visit planning</h2>
            <p>This is the business contact in Thrippunithura, not a branch in every location discussed. Confirm accepted items, pickup coverage, charges and any drop-off appointment before travelling.</p>
            <address>{BUSINESS.name}<br />{BUSINESS.address.streetAddress}<br />{BUSINESS.address.addressLocality}, {BUSINESS.address.addressRegion} {BUSINESS.address.postalCode}</address>
            <p><a href={telLink()}>{BUSINESS.phoneDisplay}</a> · <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a></p>
            <p>Office hours: {BUSINESS.hoursDisplay}. Collection slots require separate confirmation.</p>
            <a href={BUSINESS.mapUrl} target="_blank" rel="noopener noreferrer">View the business location on Google Maps</a>
          </section>
        )}
        <Faq items={guide.faq} />
        <Sources items={guide.sources} />
        <section aria-labelledby="related-heading">
          <h2 id="related-heading">Related guides and services</h2>
          <ul>{guide.related.map((link) => <li><a href={link.path}>{link.label}</a></li>)}</ul>
        </section>
        <p><a href={whatsappLink(`I have a question about ${guide.title}. Please confirm suitable handling, availability and charges.`)}>Discuss your items with {BUSINESS.name}</a></p>
      </>
    ) : <p>Choose a guide below for practical checks, common questions and source references. Service availability and documentation depend on the items and location; these guides do not guarantee collection or regulatory approval.</p>}
    <section aria-labelledby="category-guides-heading">
      <h2 id="category-guides-heading">{guide ? "More in this category" : "Explore the guides"}</h2>
      <ul class="guide-grid">{siblings.map((item) => <li><a href={`/${item.slug}/`}>{item.title}</a>{!guide && <p>{item.description}</p>}</li>)}</ul>
    </section>
    <nav aria-label="Guide categories">
      <h2>Browse all topics</h2>
      <ul>{GUIDE_CATEGORIES.map((item) => <li><a href={item.path}>{item.title}</a></li>)}</ul>
    </nav>
  </article>
</Layout>

<style>
  .discovery-guide { max-width: 58rem; margin-inline: auto; }
  section, nav { margin-block: 2rem; }
  li { margin-block: 0.65rem; }
  address { font-style: normal; }
  .guide-grid { display: grid; gap: 1rem; padding: 0; list-style: none; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
  .guide-grid li { border: 1px solid var(--color-border); border-radius: 0.5rem; padding: 1rem; margin: 0; }
  .guide-grid a { font-weight: 700; }
</style>
