---
import { BUSINESS } from "../data/site";
const year = new Date().getFullYear();
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href;
---

<footer class="site-footer">
  <nav class="wrap" aria-label="Footer">
    <div class="col">
      <h3><a href="/services/">Services</a></h3>
      <a href="/recycling/">E-Waste Recycling</a>
      <a href="/battery-recycling/">Battery Recycling</a>
      <a href="/marketplace/">Marketplace</a>
      <a href="/sell-electronics/">Sell Electronics</a>
      <a href="/pickup/">Free Pickup</a>
      <a href="/data-destruction/">Data Destruction</a>
      <a href="/hard-drive-shredding/">Hard Drive Shredding</a>
      <a href="/itad/">ITAD</a>
    </div>
    <div class="col">
      <h3>Top Locations</h3>
      <a href="/locations/kakkanad/" aria-current={isCurrent("/locations/kakkanad/") ? "page" : undefined}>Kakkanad</a>
      <a href="/locations/kalamassery/" aria-current={isCurrent("/locations/kalamassery/") ? "page" : undefined}>Kalamassery</a>
      <a href="/locations/ernakulam-south/" aria-current={isCurrent("/locations/ernakulam-south/") ? "page" : undefined}>Ernakulam South</a>
      <a href="/locations/edappally/" aria-current={isCurrent("/locations/edappally/") ? "page" : undefined}>Edappally</a>
      <a href="/locations/infopark-kochi/" aria-current={isCurrent("/locations/infopark-kochi/") ? "page" : undefined}>Infopark Kochi</a>
      <a href="/locations/kadavanthra/" aria-current={isCurrent("/locations/kadavanthra/") ? "page" : undefined}>Kadavanthra</a>
      <a href="/locations/aluva/" aria-current={isCurrent("/locations/aluva/") ? "page" : undefined}>Aluva</a>
      <a href="/locations/">All Locations</a>
    </div>
    <div class="col">
      <h3>Company</h3>
      <a href="/about/" aria-current={isCurrent("/about/") ? "page" : undefined}>About</a>
      <a href="/blog/" aria-current={isCurrent("/blog/") ? "page" : undefined}>Blog</a>
      <a href="/trust/" aria-current={isCurrent("/trust/") ? "page" : undefined}>Trust & Compliance</a>
      <a href="/faq/" aria-current={isCurrent("/faq/") ? "page" : undefined}>FAQ</a>
      <a href="/contact/" aria-current={isCurrent("/contact/") ? "page" : undefined}>Contact</a>
      <a href="/privacy/">Privacy Policy</a>
      <a href="/terms/">Terms</a>
      <a href="/ml/">മലയാളം</a>
    </div>
    <div class="col">
      <h3>Contact</h3>
      <p>{BUSINESS.address.streetAddress}<br />{BUSINESS.address.addressLocality}, {BUSINESS.address.addressRegion} {BUSINESS.address.postalCode}</p>
      <p>{BUSINESS.hoursDisplay}</p>
      <a href={`tel:${BUSINESS.phone}`}>{BUSINESS.phoneDisplay}</a>
      <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
    </div>
  </nav>
  <div class="legal">
    <div class="wrap">
      <span>&copy; {year} Ewaste Kochi. All rights reserved.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
  }
  .site-footer .wrap {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .col h3 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    margin-bottom: 0.25rem;
  }
  .col h3 a {
    color: inherit;
    text-decoration: none;
  }
  .col h3 a:hover {
    color: var(--color-primary);
  }
  .col a {
    color: var(--color-text);
    text-decoration: none;
  }
  .col a:hover {
    color: var(--color-primary);
  }
  .col a[aria-current="page"] {
    color: var(--color-primary);
    font-weight: 700;
  }
  .col p {
    margin: 0;
    color: var(--color-muted);
  }
  .legal {
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
  }
  .legal .wrap {
    padding: 1rem 1.25rem;
    display: block;
  }
  @media (min-width: 700px) {
    .site-footer .wrap {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
