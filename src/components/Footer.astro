---
import { BUSINESS } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="col">
      <h3><a href="/services/">Services</a></h3>
      <a href="/recycling/">E-Waste Recycling</a>
      <a href="/battery-recycling/">Battery Recycling</a>
      <a href="/marketplace/">Marketplace</a>
      <a href="/sell-electronics/">Sell Electronics</a>
      <a href="/pickup/">Free Pickup</a>
      <a href="/data-destruction/">Data Destruction</a>
      <a href="/hard-drive-shredding/">Hard Drive Shredding</a>
      <a href="/itad/">ITAD</a>
    </div>
    <div class="col">
      <h3>Top Locations</h3>
      <a href="/locations/kakkanad/">Kakkanad</a>
      <a href="/locations/">All Locations</a>
    </div>
    <div class="col">
      <h3>Company</h3>
      <a href="/about/">About</a>
      <a href="/trust/">Trust & Compliance</a>
      <a href="/faq/">FAQ</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy Policy</a>
      <a href="/terms/">Terms</a>
      <a href="/ml/">മലയാളം</a>
    </div>
    <div class="col">
      <h3>Contact</h3>
      <p>{BUSINESS.address.streetAddress}<br />{BUSINESS.address.addressLocality}, {BUSINESS.address.addressRegion} {BUSINESS.address.postalCode}</p>
      <p>{BUSINESS.hoursDisplay}</p>
      <a href={`tel:${BUSINESS.phone}`}>{BUSINESS.phoneDisplay}</a>
      <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
    </div>
  </div>
  <div class="legal">
    <div class="wrap">
      <span>&copy; {year} Ewaste Kochi. All rights reserved.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
  }
  .site-footer .wrap {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .col h3 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    margin-bottom: 0.25rem;
  }
  .col h3 a {
    color: inherit;
    text-decoration: none;
  }
  .col h3 a:hover {
    color: var(--color-primary);
  }
  .col a {
    color: var(--color-text);
    text-decoration: none;
  }
  .col a:hover {
    color: var(--color-primary);
  }
  .col p {
    margin: 0;
    color: var(--color-muted);
  }
  .legal {
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
  }
  .legal .wrap {
    padding: 1rem 1.25rem;
    display: block;
  }
  @media (min-width: 700px) {
    .site-footer .wrap {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
