---
import { BUSINESS, telLink } from "../data/site";

const navLinks = [
  { href: "/recycling/", label: "Recycling" },
  { href: "/battery-recycling/", label: "Battery" },
  { href: "/marketplace/", label: "Marketplace" },
  { href: "/data-destruction/", label: "Data Destruction" },
  { href: "/itad/", label: "ITAD" },
  { href: "/locations/", label: "Locations" },
  { href: "/tools/", label: "Tools" },
  { href: "/blog/", label: "Blog" },
  { href: "/contact/", label: "Contact" },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href;
---

<header class="site-header">
  <div class="trust-bar" aria-label="Trust and contact highlights">
    <div class="trust-wrap">
      <div class="trust-points">
        <span>Secure data handling</span>
        <span>Responsible recycling support</span>
        <span>Free pickup assistance in Kochi</span>
      </div>
      <a href={telLink()}>Have e-waste? {BUSINESS.phoneDisplay}</a>
    </div>
  </div>
  <div class="wrap">
    <a href="/" class="brand" aria-label="Ewaste Kochi home">
      <span class="brand-mark" aria-hidden="true">E</span>
      <span>Ewaste <strong>Kochi</strong></span>
    </a>

    <nav class="main-nav" aria-label="Primary">
      {navLinks.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>
      ))}
    </nav>

    <a class="header-call" href={telLink()} aria-label={`Call Ewaste Kochi at ${BUSINESS.phoneDisplay}`}>
      <span class="call-label">Call</span>
      {BUSINESS.phoneDisplay}
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path class="icon-open" d="M3 6h18M3 12h18M3 18h18" />
        <path class="icon-close" d="M6 6l12 12M18 6 6 18" style="display:none" />
      </svg>
    </button>
  </div>
</header>

<nav id="mobile-nav" class="mobile-nav" aria-label="Mobile" hidden>
  <div class="mobile-nav-inner">
    <p class="mobile-nav-label">Explore Ewaste Kochi</p>
    {navLinks.map((link) => (
      <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>
    ))}
    <a class="mobile-call" href={telLink()}>Call {BUSINESS.phoneDisplay}</a>
  </div>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const mobileNav = document.getElementById("mobile-nav");
  const iconOpen = toggle?.querySelector<SVGPathElement>(".icon-open");
  const iconClose = toggle?.querySelector<SVGPathElement>(".icon-close");

  function setOpen(open: boolean) {
    if (!toggle || !mobileNav) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    mobileNav.hidden = !open;
    document.body.classList.toggle("menu-open", open);
    if (iconOpen) iconOpen.style.display = open ? "none" : "";
    if (iconClose) iconClose.style.display = open ? "" : "none";
  }

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    setOpen(!isOpen);
  });

  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      toggle.focus();
    }
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1120) setOpen(false);
  });
</script>

<style>
  :root {
    --topbar-height: 34px;
    --header-height: 70px;
    --header-total: calc(var(--topbar-height) + var(--header-height));
  }

  @media (min-width: 1120px) {
    :root {
      --topbar-height: 36px;
      --header-height: 72px;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: color-mix(in srgb, var(--color-bg) 94%, transparent);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 4px 18px rgba(16, 32, 25, 0.04);
    backdrop-filter: blur(14px);
  }

  .trust-bar {
    min-height: var(--topbar-height);
    background: linear-gradient(90deg, #063d1e, #0b5d34);
    color: #fff;
    font-size: 0.74rem;
    font-weight: 750;
  }

  .trust-wrap {
    width: min(100% - 2rem, 72rem);
    min-height: var(--topbar-height);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .trust-points {
    display: none;
    align-items: center;
    gap: 1.2rem;
  }

  .trust-points span {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    white-space: nowrap;
  }

  .trust-points span::before {
    content: "✓";
    color: #8df0b5;
    font-weight: 900;
  }

  .trust-wrap a {
    margin-left: auto;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
  }

  .trust-wrap a:hover { text-decoration: underline; }

  .wrap {
    width: min(100% - 2rem, 72rem);
    min-height: var(--header-height);
    margin: 0 auto;
    padding: 0.7rem 0;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-width: max-content;
    color: var(--color-text);
    font-size: 1.02rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand strong { color: var(--color-primary); }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9px;
    background: linear-gradient(145deg, var(--color-primary), var(--color-primary-dark));
    color: #fff;
    font-weight: 900;
    box-shadow: 0 5px 14px rgba(20, 122, 75, 0.22);
  }

  .main-nav {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
  }

  .main-nav a {
    padding: 0.48rem 0.58rem;
    border-radius: 8px;
    color: var(--color-muted);
    font-size: 0.8rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  .main-nav a:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .main-nav a[aria-current="page"] {
    color: var(--color-primary);
    background: var(--color-accent);
    font-weight: 800;
  }

  .header-call {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .header-call:hover {
    border-color: var(--color-primary);
    background: var(--color-accent);
  }

  .call-label { color: var(--color-muted); font-weight: 650; }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 11px;
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
    flex: 0 0 44px;
  }

  .nav-toggle:hover { background: var(--color-surface); }
  .nav-toggle svg { width: 21px; height: 21px; }

  .mobile-nav {
    position: fixed;
    top: var(--header-total);
    right: 0;
    bottom: 0;
    left: 0;
    height: calc(100dvh - var(--header-total));
    overflow-y: auto;
    overscroll-behavior: contain;
    z-index: 999;
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 20px 45px rgba(16, 32, 25, 0.14);
  }

  .mobile-nav[hidden] { display: none; }

  .mobile-nav-inner {
    width: min(100% - 2rem, 34rem);
    margin: 0 auto;
    padding: 0.8rem 0 max(2rem, env(safe-area-inset-bottom));
  }

  .mobile-nav-label {
    margin: 0.5rem 0 0.6rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mobile-nav a {
    display: flex;
    align-items: center;
    min-height: 50px;
    padding: 0.75rem 0.8rem;
    border-bottom: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
  }

  .mobile-nav a[aria-current="page"] {
    color: var(--color-primary);
    background: var(--color-accent);
  }

  .mobile-nav .mobile-call {
    justify-content: center;
    margin-top: 1rem;
    border: 0;
    background: var(--color-primary);
    color: #fff;
  }

  @media (min-width: 1120px) {
    .trust-points { display: flex; }
    .main-nav { display: flex; }
    .header-call { margin-left: 0; }
    .nav-toggle, .mobile-nav { display: none; }
  }

  @media (max-width: 640px) {
    .trust-wrap, .wrap { width: min(100% - 1.25rem, 72rem); }
    .header-call { display: none; }
    .brand { font-size: 0.98rem; }
  }
</style>