---
interface Props {
  heading?: string;
}

const { heading = "Quick answer" } = Astro.props;
---

<section class="direct-answer" aria-label={heading}>
  <h2>{heading}</h2>
  <slot />
</section>

<style>
  .direct-answer {
    margin-block: 1.25rem 2rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    background: var(--color-surface);
    border-radius: 0.5rem;
  }
  .direct-answer h2 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
  }
  .direct-answer :global(p) {
    margin: 0;
    color: var(--color-muted);
  }
</style>
