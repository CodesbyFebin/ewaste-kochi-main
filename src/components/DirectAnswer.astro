---
interface Props {
  heading?: string;
}

const { heading = "Quick answer" } = Astro.props;
---

<section class="direct-answer" aria-label={heading}>
  <h2>{heading}</h2>
  <slot />
</section>

<style>
  .direct-answer {
    margin-block: 1.5rem 2rem;
    padding: clamp(1rem, 2.5vw, 1.35rem) clamp(1rem, 3vw, 1.5rem);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    background: linear-gradient(135deg, var(--color-surface-strong), var(--color-surface));
    border-radius: var(--radius-md, 16px);
    box-shadow: var(--shadow-sm, none);
  }
  .direct-answer h2 {
    margin: 0 0 0.45rem;
    font-size: clamp(1rem, 2vw, 1.15rem);
  }
  .direct-answer :global(p) {
    margin: 0;
    max-width: 70ch;
    color: var(--color-text);
  }
</style>
