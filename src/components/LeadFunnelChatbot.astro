---
import { telLink, whatsappLink } from "../data/site";
---

<div id="ew-lead-chat-root"></div>
<noscript>
  <div class="ewlf-noscript">
    <a href={whatsappLink("Hi Ewaste Kochi, I'd like a quote for e-waste pickup or recycling.")} target="_blank" rel="noopener">
      WhatsApp Ewaste Kochi
    </a>
    <a href={telLink()}>Call Ewaste Kochi</a>
  </div>
</noscript>

<script>
  import "../scripts/leadFunnelChatbot";
</script>

<style>
  #ew-lead-chat-root {
    position: relative;
    z-index: 9000;
  }

  .ewlf-noscript {
    position: fixed;
    bottom: 16px;
    right: 16px;
    z-index: 9000;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .ewlf-noscript a {
    display: inline-block;
    padding: 0.6rem 1rem;
    border-radius: 0.5rem;
    background: var(--color-primary);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.85rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  :global(.ewlf-launcher) {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 9001;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.05rem;
    padding: 0.65rem 1.05rem;
    border-radius: 999px;
    border: none;
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
    min-height: 44px;
    max-width: calc(100vw - 32px);
  }
  :global(.ewlf-launcher:hover) {
    background: var(--color-primary-dark);
  }
  :global(.ewlf-launcher-main) {
    font-size: 0.92rem;
    line-height: 1.05;
  }
  :global(.ewlf-launcher-sub) {
    font-size: 0.68rem;
    line-height: 1;
    font-weight: 600;
    opacity: 0.88;
  }

  :global(.ewlf-panel) {
    position: fixed;
    bottom: 84px;
    right: 20px;
    width: 340px;
    max-width: calc(100vw - 32px);
    max-height: min(70vh, 520px);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    z-index: 9002;
    display: none;
    flex-direction: column;
    overflow: hidden;
  }
  :global(.ewlf-open .ewlf-panel) {
    display: flex;
  }

  :global(.ewlf-panel-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
    flex-shrink: 0;
  }
  :global(.ewlf-header-actions) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  :global(.ewlf-header-link) {
    color: #fff;
    text-decoration: underline;
    font-size: 0.8rem;
    font-weight: 500;
  }
  :global(.ewlf-close) {
    background: none;
    border: none;
    color: #fff;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.2rem 0.4rem;
  }

  :global(.ewlf-messages) {
    flex: 1;
    overflow-y: auto;
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  :global(.ewlf-msg) {
    display: flex;
  }
  :global(.ewlf-msg-bot) {
    justify-content: flex-start;
  }
  :global(.ewlf-msg-user) {
    justify-content: flex-end;
  }
  :global(.ewlf-bubble) {
    max-width: 82%;
    padding: 0.55rem 0.8rem;
    border-radius: 0.75rem;
    font-size: 0.85rem;
    line-height: 1.45;
    white-space: pre-line;
  }
  :global(.ewlf-msg-bot .ewlf-bubble) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    border-bottom-left-radius: 0.2rem;
  }
  :global(.ewlf-msg-user .ewlf-bubble) {
    background: var(--color-primary);
    color: #fff;
    border-bottom-right-radius: 0.2rem;
  }

  :global(.ewlf-actions) {
    border-top: 1px solid var(--color-border);
    padding: 0.7rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-shrink: 0;
    max-height: 45%;
    overflow-y: auto;
  }

  :global(.ewlf-choice-btn) {
    padding: 0.55rem 0.8rem;
    border-radius: 0.6rem;
    border: 1.5px solid var(--color-primary);
    background: transparent;
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
    min-height: 40px;
  }
  :global(.ewlf-choice-btn:hover) {
    background: var(--color-primary);
    color: #fff;
  }
  :global(.ewlf-restart) {
    border-style: dashed;
  }

  :global(.ewlf-text-row) {
    display: flex;
    gap: 0.5rem;
  }
  :global(.ewlf-text-input) {
    flex: 1;
    padding: 0.55rem 0.7rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.85rem;
    min-height: 40px;
  }
  :global(.ewlf-text-submit) {
    padding: 0.55rem 0.9rem;
    border-radius: 0.5rem;
    border: none;
    background: var(--color-primary);
    color: #fff;
    font-weight: 600;
    cursor: pointer;
    min-height: 40px;
  }

  :global(.ewlf-consent) {
    font-size: 0.75rem;
    color: var(--color-muted);
    margin: 0;
  }

  :global(.ewlf-wa-cta) {
    display: block;
    text-align: center;
    padding: 0.65rem;
    border-radius: 0.6rem;
    background: #25d366;
    color: #063d1e;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.9rem;
  }

  :global(.ewlf-quick-links) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  :global(.ewlf-quick-link) {
    font-size: 0.78rem;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
  }

  @media (max-width: 480px) {
    :global(.ewlf-panel) {
      right: 8px;
      left: 8px;
      width: auto;
      max-width: none;
      bottom: 76px;
    }
    :global(.ewlf-launcher) {
      right: 12px;
      bottom: 12px;
    }
  }
</style>
