---
import { sanitizeJsonLdBlock } from "../lib/schemaSafety";

interface Item {
  q: string;
  a: string;
}

interface Props {
  items: Item[];
  heading?: string;
}

const { items, heading = "Frequently Asked Questions" } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
const safeJsonLd = sanitizeJsonLdBlock(jsonLd);
---

<section class="faq" aria-labelledby="faq-heading">
  <h2 id="faq-heading">{heading}</h2>
  <div class="faq-list">
    {items.map((item) => (
      <details class="faq-item">
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
</section>
{safeJsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(safeJsonLd)} />}

<style>
  .faq {
    margin-block: 3rem;
  }
  .faq h2 {
    margin-bottom: 1rem;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm, 10px);
    padding: 0;
    overflow: hidden;
    background: var(--color-bg);
    box-shadow: var(--shadow-sm, none);
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 700;
    list-style: none;
    min-height: 48px;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.8rem 1rem;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::before {
    content: "+";
    flex: 0 0 1.4rem;
    display: inline-grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 999px;
    background: var(--color-surface-strong);
    color: var(--color-primary);
    font-weight: 800;
  }
  .faq-item[open] summary::before {
    content: "\2212";
  }
  .faq-item summary:focus-visible {
    outline-offset: -3px;
  }
  .faq-item p {
    margin: 0;
    padding: 0 1rem 1rem 3.05rem;
    color: var(--color-muted);
    max-width: 75ch;
  }

  @media (max-width: 640px) {
    .faq { margin-block: 2.5rem; }
    .faq-item summary { padding: 0.8rem 0.85rem; }
    .faq-item p { padding-inline: 0.85rem; padding-left: 2.9rem; }
  }
</style>
