---
import { SITE_URL, BUSINESS } from "../data/site";
import { resolveSeoMetadata } from "../data/seoOverrides";
import { sanitizeJsonLdBlocks } from "../lib/schemaSafety";

interface HreflangEntry {
  lang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: Record<string, unknown>[];
  hreflang?: HreflangEntry[];
  noindex?: boolean;
}

const { title: inputTitle, description: inputDescription, path, jsonLd = [], hreflang = [], noindex = false } = Astro.props;
const canonicalUrl = new URL(path, SITE_URL).toString();

// Page metadata is the default. Only explicitly documented overrides in
// src/data/seoOverrides.ts may take precedence, so title ownership is visible
// and reviewable rather than hidden inside this rendering component.
const resolvedSeo = resolveSeoMetadata(path, inputTitle, inputDescription);
const { title, description } = resolvedSeo;
const isArticle = path.startsWith("/blog/") || path.startsWith("/e-waste/");

const safeJsonLd = sanitizeJsonLdBlocks(jsonLd).map((block) => {
  if (block["@type"] === "WebPage") {
    return {
      ...block,
      "@id": canonicalUrl,
      url: canonicalUrl,
      name: title,
      description,
    };
  }
  return block;
});

const businessDescription = "E-waste recycling, electronics pickup, battery handling and IT asset services in Kochi and selected Kerala locations, plus free pan-India ship-in for laptops, phones and tablets via Shiprocket.";
const brandImage = new URL("/og-image.jpg", SITE_URL).toString();

const businessJsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${SITE_URL}/#business`,
  name: BUSINESS.name,
  description: businessDescription,
  url: SITE_URL,
  telephone: BUSINESS.phone,
  email: BUSINESS.email,
  priceRange: "$$",
  image: brandImage,
  sameAs: [...BUSINESS.sameAs],
  hasMap: BUSINESS.mapUrl,
  address: {
    "@type": "PostalAddress",
    streetAddress: BUSINESS.address.streetAddress,
    addressLocality: BUSINESS.address.addressLocality,
    addressRegion: BUSINESS.address.addressRegion,
    postalCode: BUSINESS.address.postalCode,
    addressCountry: BUSINESS.address.addressCountry,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: BUSINESS.geo.latitude,
    longitude: BUSINESS.geo.longitude,
  },
  openingHours: BUSINESS.hours,
  openingHoursSpecification: [{
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    opens: "09:00",
    closes: "18:00",
  }],
  areaServed: [
    { "@type": "City", name: "Kochi" },
    { "@type": "AdministrativeArea", name: "Ernakulam" },
    { "@type": "AdministrativeArea", name: "Kerala" },
    { "@type": "Country", name: "India" },
  ],
};

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${SITE_URL}/#organization`,
  name: BUSINESS.legalName,
  alternateName: BUSINESS.name,
  url: SITE_URL,
  description: businessDescription,
  sameAs: [...BUSINESS.sameAs],
  contactPoint: [{
    "@type": "ContactPoint",
    telephone: BUSINESS.phone,
    contactType: "customer service",
    email: BUSINESS.email,
    areaServed: "IN",
    availableLanguage: ["English", "Malayalam"],
  }],
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  name: BUSINESS.name,
  url: SITE_URL,
  description: businessDescription,
  publisher: { "@id": `${SITE_URL}/#organization` },
  inLanguage: ["en-IN", "ml-IN"],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" type="application/rss+xml" title="Ewaste Kochi Blog RSS" href={new URL("/feed.xml", SITE_URL).toString()} />
<link rel="llms" href={new URL("/llms.txt", SITE_URL).toString()} />
<link rel="ai-sitemap" href={new URL("/ai-sitemap.xml", SITE_URL).toString()} />
<link rel="content-index" type="application/json" href={new URL("/content-index.json", SITE_URL).toString()} />
<meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1"} />

<meta property="og:type" content={isArticle ? "article" : "website"} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="Ewaste Kochi" />
<meta property="og:image" content={new URL("/og-image.jpg", SITE_URL).toString()} />
<meta property="og:image:alt" content={`${title} | Ewaste Kochi`} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL("/og-image.jpg", SITE_URL).toString()} />
<meta name="twitter:image:alt" content={`${title} | Ewaste Kochi`} />

{hreflang.map((h) => (
  <link rel="alternate" hreflang={h.lang} href={h.href} />
))}

<script type="application/ld+json" is:inline set:html={JSON.stringify(businessJsonLd)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationJsonLd)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(websiteJsonLd)} />

{safeJsonLd.map((block) => (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
))}
